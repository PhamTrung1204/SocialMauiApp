<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  Note: For Android please see also Platforms\Android\Resources\values\colors.xml  -->

    <!--  ===== Brand =====  -->
    <!--  Primary giữ tông xanh cũ nhưng đậm hơn: chữ trắng trên nền này đạt 5.17:1 (cũ #4ecaff chỉ ~1.7:1).  -->
    <Color x:Key="Primary">#2563EB</Color>
    <Color x:Key="PrimaryDark">#1D4ED8</Color>
    <Color x:Key="PrimaryDarker">#1E40AF</Color>
    <Color x:Key="PrimaryLight">#60A5FA</Color>
    <Color x:Key="PrimarySoft">#DBEAFE</Color>
    <Color x:Key="PrimaryDarkText">#0F172A</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#6D28D9</Color>
    <Color x:Key="Tertiary">#7C3AED</Color>
    <Color x:Key="Accent">#EC4899</Color>

    <!--  ===== Trạng thái =====  -->
    <Color x:Key="Success">#16A34A</Color>
    <Color x:Key="SuccessSoft">#DCFCE7</Color>
    <Color x:Key="Warning">#F59E0B</Color>
    <Color x:Key="WarningSoft">#FEF3C7</Color>
    <Color x:Key="Danger">#DC2626</Color>
    <Color x:Key="DangerSoft">#FEE2E2</Color>
    <Color x:Key="Like">#EF4444</Color>

    <!--  ===== Nền / bề mặt =====  -->
    <Color x:Key="LightBackground">#F4F6F8</Color>
    <Color x:Key="LightSurface">#FFFFFF</Color>
    <Color x:Key="LightSurfaceAlt">#F9FAFB</Color>
    <Color x:Key="DarkBackground">#0F1115</Color>
    <Color x:Key="DarkSurface">#181B21</Color>
    <Color x:Key="DarkSurfaceAlt">#20242C</Color>
    <Color x:Key="LightOnDarkBackground">#E5E7EB</Color>
    <Color x:Key="DarkOnLightBackground">#111827</Color>
    <Color x:Key="LightSecondaryBackground">#F1F3F5</Color>
    <Color x:Key="DarkSecondaryBackground">#20242C</Color>

    <!--  ===== Chữ =====  -->
    <Color x:Key="TextPrimaryLight">#111827</Color>
    <Color x:Key="TextSecondaryLight">#6B7280</Color>
    <Color x:Key="TextMutedLight">#9CA3AF</Color>
    <Color x:Key="TextPrimaryDark">#F3F4F6</Color>
    <Color x:Key="TextSecondaryDark">#9BA3AF</Color>
    <Color x:Key="TextMutedDark">#6B7280</Color>

    <!--  ===== Viền =====  -->
    <Color x:Key="OutlineLight">#E5E7EB</Color>
    <Color x:Key="OutlineDark">#2A2F3A</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <!--  Gray100 được dùng làm nền trang ở nhiều page - làm sáng lên cho đỡ xám xịt.  -->
    <Color x:Key="Gray100">#F3F4F6</Color>
    <Color x:Key="Gray200">#E5E7EB</Color>
    <Color x:Key="Gray300">#D1D5DB</Color>
    <Color x:Key="Gray400">#9CA3AF</Color>
    <Color x:Key="Gray500">#6B7280</Color>
    <Color x:Key="Gray600">#4B5563</Color>
    <Color x:Key="Gray900">#111827</Color>
    <Color x:Key="Gray950">#0B0E13</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />

    <!--  Gradient cho header / nút nổi bật  -->
    <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="{StaticResource Primary}" />
        <GradientStop Offset="1.0" Color="{StaticResource Tertiary}" />
    </LinearGradientBrush>
</ResourceDictionary>
