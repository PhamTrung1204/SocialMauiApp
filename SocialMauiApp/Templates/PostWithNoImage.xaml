<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SocialMauiApp.Templates.PostWithNoImage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:converters="clr-namespace:SocialMauiApp.Converters"
    xmlns:dto="clr-namespace:SocialMediaMaui.Shared.Dtos;assembly=SocialMediaMaui.Shared"
    xmlns:models="clr-namespace:SocialMauiApp.Models"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    x:DataType="models:PostModel">
    <ContentView.Resources>
        <converters:LevelToMarginConverter x:Key="LevelToMarginConverter" />
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
        <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
        <converters:ObjectToBoolConverter x:Key="ObjectToBoolConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <MenuFlyout x:Key="CommentOptionsMenu" x:DataType="dto:CommentDto">
            <MenuFlyoutItem
                Command="{Binding Source={x:RelativeSource AncestorType={x:Type models:PostModel}}, Path=EditCommentCommand}"
                CommandParameter="{Binding .}"
                IconImageSource="pencil.png"
                IsEnabled="{Binding IsOwnComment}"
                Text="Edit" />
            <MenuFlyoutItem
                Command="{Binding Source={x:RelativeSource AncestorType={x:Type models:PostModel}}, Path=DeleteCommentCommand}"
                CommandParameter="{Binding .}"
                IconImageSource="trash.png"
                IsEnabled="{Binding IsOwnComment}"
                Text="Delete" />
            <MenuFlyoutItem
                Command="{Binding Source={x:RelativeSource AncestorType={x:Type models:PostModel}}, Path=ReplyCommentCommand}"
                CommandParameter="{Binding .}"
                IconImageSource="reply.png"
                Text="Reply" />
        </MenuFlyout>

        <Style x:Key="PostActionLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="PostMetaLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentView.Resources>

    <Border
        Margin="14,7"
        Padding="0"
        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"
        Shadow="{StaticResource ShadowSm}"
        Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
        StrokeShape="RoundRectangle 20"
        StrokeThickness="1">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto">

            <!--  Header  -->
            <Grid
                Grid.Row="0"
                Padding="14,14,14,0"
                ColumnDefinitions="44,*"
                ColumnSpacing="12">
                <Border
                    Grid.Column="0"
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource DarkSurfaceAlt}}"
                    HeightRequest="44"
                    StrokeShape="RoundRectangle 22"
                    StrokeThickness="0"
                    VerticalOptions="Start"
                    WidthRequest="44">
                    <Image
                        Aspect="AspectFill"
                        HeightRequest="44"
                        Source="{Binding UserPhoto}"
                        WidthRequest="44" />
                </Border>
                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="2"
                    VerticalOptions="Center">
                    <Label
                        FontAttributes="Bold"
                        FontSize="15"
                        LineBreakMode="TailTruncation"
                        Text="{Binding UserName}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label
                        FontSize="12"
                        Text="{Binding PostedOnDisplay}"
                        TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                </VerticalStackLayout>
            </Grid>

            <!--  Content  -->
            <Border
                Grid.Row="1"
                Margin="14,12,14,0"
                Padding="18,22"
                BackgroundColor="{AppThemeBinding Light={StaticResource LightSurfaceAlt}, Dark={StaticResource DarkSurfaceAlt}}"
                MinimumHeightRequest="120"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="0">
                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    LineHeight="1.3"
                    Text="{Binding Content}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                    VerticalOptions="Center" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=GoToDetailsPageCommand}" CommandParameter="{Binding}" />
                </Border.GestureRecognizers>
            </Border>

            <!--  Engagement counts  -->
            <Grid
                Grid.Row="2"
                Padding="14,12,14,10"
                ColumnDefinitions="*,Auto">
                <HorizontalStackLayout
                    Grid.Column="0"
                    BackgroundColor="Transparent"
                    Spacing="6">
                    <Image
                        HeightRequest="16"
                        Source="heart_f.png"
                        VerticalOptions="Center"
                        WidthRequest="16" />
                    <Label Style="{StaticResource PostActionLabelStyle}" Text="{Binding LikeCount}" />
                    <Label Style="{StaticResource PostMetaLabelStyle}" Text="likes" />
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowLikersCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                </HorizontalStackLayout>
                <HorizontalStackLayout
                    Grid.Column="1"
                    BackgroundColor="Transparent"
                    Spacing="6">
                    <Label Style="{StaticResource PostActionLabelStyle}" Text="{Binding CommentCount}" />
                    <Label Style="{StaticResource PostMetaLabelStyle}" Text="comments" />
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=GoToDetailsPageCommand}" CommandParameter="{Binding}" />
                    </HorizontalStackLayout.GestureRecognizers>
                </HorizontalStackLayout>
            </Grid>

            <!--  Action bar  -->
            <Grid Grid.Row="3" RowDefinitions="1,Auto">
                <BoxView Grid.Row="0" Style="{StaticResource SeparatorStyle}" />
                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="*,*,*,*"
                    HeightRequest="48">
                    <HorizontalStackLayout
                        Grid.Column="0"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        Spacing="6"
                        VerticalOptions="Center">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="{Binding IsLikeIcon}"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="Like"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=ToggleLikeCommand}" CommandParameter="{Binding}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout
                        Grid.Column="1"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        Spacing="6"
                        VerticalOptions="Center">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="comment.png"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="Comment"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleCommentsDisplayCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout
                        Grid.Column="2"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        Spacing="6"
                        VerticalOptions="Center">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="{Binding IsBookmarkIcon}"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="Save"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=ToggleBookmarkCommand}" CommandParameter="{Binding}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout
                        Grid.Column="3"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Center"
                        Spacing="6"
                        VerticalOptions="Center">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="share.png"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="Share"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=SharePostCommand}" CommandParameter="{Binding}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                </Grid>
            </Grid>

            <!--  Comments  -->
            <VerticalStackLayout
                Grid.Row="4"
                IsVisible="{Binding IsCommentsVisible}"
                Spacing="6">
                <BoxView Style="{StaticResource SeparatorStyle}" />
                <AbsoluteLayout>
                    <CollectionView
                        Margin="0,34,0,0"
                        AbsoluteLayout.LayoutBounds="0,0,1,AutoSize"
                        AbsoluteLayout.LayoutFlags="WidthProportional"
                        ItemsSource="{Binding Comments}"
                        RemainingItemsThreshold="1"
                        SelectionMode="None"
                        VerticalOptions="Start">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label
                                Margin="0,0,0,12"
                                HorizontalOptions="Center"
                                Style="{StaticResource MutedTextStyle}"
                                Text="No comments yet." />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:CommentDto">
                                <Grid
                                    Margin="{Binding Level, Converter={StaticResource LevelToMarginConverter}}"
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="10"
                                    RowDefinitions="Auto,Auto">
                                    <Border
                                        Grid.Column="0"
                                        Margin="14,0,0,0"
                                        Padding="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource DarkSurfaceAlt}}"
                                        HeightRequest="36"
                                        StrokeShape="RoundRectangle 18"
                                        StrokeThickness="0"
                                        VerticalOptions="Start"
                                        WidthRequest="36">
                                        <Image
                                            Aspect="AspectFill"
                                            HeightRequest="36"
                                            Source="{Binding UserPhotoUrl}"
                                            WidthRequest="36" />
                                    </Border>
                                    <Border
                                        Grid.Column="1"
                                        Margin="0,0,14,0"
                                        Padding="12,10"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurfaceAlt}, Dark={StaticResource DarkSurfaceAlt}}"
                                        StrokeShape="RoundRectangle 14"
                                        StrokeThickness="0"
                                        VerticalOptions="Start">
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            RowDefinitions="Auto,Auto,Auto,Auto"
                                            RowSpacing="4">
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                Text="{Binding UserName}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="6,0"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                IsVisible="{Binding IsOwnComment}"
                                                Text="⋯"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                                VerticalOptions="Start">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnMoreOptionsTapped" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                FontSize="14"
                                                LineBreakMode="WordWrap"
                                                LineHeight="1.3"
                                                Text="{Binding Content}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                            <Border
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Margin="0,4,0,0"
                                                Padding="0"
                                                HorizontalOptions="Start"
                                                IsVisible="{Binding PhotoUrl, Converter={StaticResource StringToBoolConverter}}"
                                                StrokeShape="RoundRectangle 12"
                                                StrokeThickness="0">
                                                <Image
                                                    Aspect="AspectFit"
                                                    HorizontalOptions="Start"
                                                    Source="{Binding PhotoUrl}" />
                                            </Border>
                                            <HorizontalStackLayout
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Spacing="12">
                                                <Label
                                                    FontSize="12"
                                                    Text="{Binding AddedOn, Converter={StaticResource HumanizedTimeConverter}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    BackgroundColor="Transparent"
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    HorizontalOptions="Start"
                                                    Text="Reply"
                                                    TextColor="{StaticResource Primary}">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnReplyTapped" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                    <CollectionView
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="34,8,0,0"
                                        IsVisible="{Binding Replies.Count, Converter={StaticResource CountToBoolConverter}}"
                                        ItemsSource="{Binding Replies}"
                                        SelectionMode="None">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="dto:CommentDto">
                                                <Grid
                                                    Margin="{Binding Level, Converter={StaticResource LevelToMarginConverter}}"
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="10"
                                                    RowDefinitions="Auto">
                                                    <Border
                                                        Grid.Column="0"
                                                        Padding="0"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource DarkSurfaceAlt}}"
                                                        HeightRequest="30"
                                                        StrokeShape="RoundRectangle 15"
                                                        StrokeThickness="0"
                                                        VerticalOptions="Start"
                                                        WidthRequest="30">
                                                        <Image
                                                            Aspect="AspectFill"
                                                            HeightRequest="30"
                                                            Source="{Binding UserPhotoUrl}"
                                                            WidthRequest="30" />
                                                    </Border>
                                                    <Border
                                                        Grid.Column="1"
                                                        Margin="0,0,14,0"
                                                        Padding="12,10"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurfaceAlt}, Dark={StaticResource DarkSurfaceAlt}}"
                                                        StrokeShape="RoundRectangle 12"
                                                        StrokeThickness="0"
                                                        VerticalOptions="Start">
                                                        <Grid
                                                            ColumnDefinitions="*,Auto"
                                                            RowDefinitions="Auto,Auto,Auto,Auto"
                                                            RowSpacing="4">
                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                FontAttributes="Bold"
                                                                FontSize="13"
                                                                Text="{Binding UserName}"
                                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                Padding="6,0"
                                                                BackgroundColor="Transparent"
                                                                FontSize="15"
                                                                IsVisible="{Binding IsOwnComment}"
                                                                Text="⋯"
                                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                                                VerticalOptions="Start">
                                                                <Label.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnMoreOptionsTapped" />
                                                                </Label.GestureRecognizers>
                                                            </Label>
                                                            <Label
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="2"
                                                                FontSize="13"
                                                                LineBreakMode="WordWrap"
                                                                LineHeight="1.3"
                                                                Text="{Binding Content}"
                                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                                            <Border
                                                                Grid.Row="2"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="2"
                                                                Margin="0,4,0,0"
                                                                Padding="0"
                                                                HorizontalOptions="Start"
                                                                IsVisible="{Binding PhotoUrl, Converter={StaticResource StringToBoolConverter}}"
                                                                StrokeShape="RoundRectangle 10"
                                                                StrokeThickness="0">
                                                                <Image
                                                                    Aspect="AspectFit"
                                                                    HorizontalOptions="Start"
                                                                    Source="{Binding PhotoUrl}" />
                                                            </Border>
                                                            <HorizontalStackLayout
                                                                Grid.Row="3"
                                                                Grid.Column="0"
                                                                Spacing="12">
                                                                <Label
                                                                    FontSize="11"
                                                                    Text="{Binding AddedOn, Converter={StaticResource HumanizedTimeConverter}}"
                                                                    TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                                                    VerticalOptions="Center" />
                                                                <Label
                                                                    FontAttributes="Bold"
                                                                    FontSize="12"
                                                                    Text="Reply"
                                                                    TextColor="{StaticResource Primary}">
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="OnReplyTapped" />
                                                                    </Label.GestureRecognizers>
                                                                </Label>
                                                            </HorizontalStackLayout>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <HorizontalStackLayout
                        Margin="14,0,0,6"
                        Padding="0,6"
                        AbsoluteLayout.LayoutBounds="0,0,AutoSize,30"
                        AbsoluteLayout.LayoutFlags="PositionProportional"
                        Spacing="6">
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            IsVisible="{Binding IsCommentsExpanded, Converter={StaticResource InverseBooleanConverter}}"
                            Text="Show More"
                            TextColor="{StaticResource Primary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCommentsVisibilityCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label
                            FontAttributes="Bold"
                            FontSize="12"
                            IsVisible="{Binding IsCommentsExpanded}"
                            Text="Collapse"
                            TextColor="{StaticResource Primary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCommentsVisibilityCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </AbsoluteLayout>

                <!--  Comment composer  -->
                <Grid
                    Padding="14,6,14,14"
                    ColumnDefinitions="Auto,*,Auto,Auto"
                    ColumnSpacing="8"
                    RowDefinitions="Auto,Auto,Auto"
                    RowSpacing="8">
                    <HorizontalStackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        Spacing="8">
                        <Label
                            FontSize="13"
                            IsVisible="{Binding ReplyingToComment, Converter={StaticResource ObjectToBoolConverter}}"
                            Text="{Binding ReplyingToComment.UserName, StringFormat='Replying to {0}'}"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CancelReplyCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label
                            FontSize="13"
                            IsVisible="{Binding IsEditing}"
                            Text="Editing comment"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <Border
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource LightSurfaceAlt}, Dark={StaticResource DarkSurfaceAlt}}"
                            HeightRequest="24"
                            IsVisible="{Binding IsEditing}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="24">
                            <Image
                                HeightRequest="14"
                                HorizontalOptions="Center"
                                Source="x.png"
                                VerticalOptions="Center"
                                WidthRequest="14" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CancelEditCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </HorizontalStackLayout>

                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurfaceAlt}, Dark={StaticResource DarkSurfaceAlt}}"
                        HeightRequest="42"
                        IsVisible="{Binding IsPhotoButtonVisible}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="0"
                        WidthRequest="42">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            HorizontalOptions="Center"
                            Source="photo.png"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectPhotoCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Grid.Column="1"
                        Padding="14,0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurfaceAlt}, Dark={StaticResource DarkSurfaceAlt}}"
                        HeightRequest="42"
                        StrokeShape="RoundRectangle 21"
                        StrokeThickness="0">
                        <controls:NoBorderEntry
                            Placeholder="Write a comment or reply..."
                            Text="{Binding CommentInput, Mode=TwoWay}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                            VerticalOptions="Center" />
                    </Border>

                    <Border
                        Grid.Row="1"
                        Grid.Column="2"
                        Padding="0"
                        BackgroundColor="{StaticResource Primary}"
                        HeightRequest="42"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        IsVisible="{Binding IsEditing, Converter={StaticResource InverseBooleanConverter}}"
                        StrokeShape="RoundRectangle 21"
                        StrokeThickness="0"
                        WidthRequest="42">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddCommentCommand}" />
                        </Border.GestureRecognizers>
                        <controls:WhiteImage
                            HeightRequest="18"
                            HorizontalOptions="Center"
                            Source="send.png"
                            VerticalOptions="Center"
                            WidthRequest="18" />
                    </Border>

                    <Border
                        Grid.Row="1"
                        Grid.Column="3"
                        Padding="0"
                        BackgroundColor="{StaticResource Primary}"
                        HeightRequest="42"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        IsVisible="{Binding IsEditing}"
                        StrokeShape="RoundRectangle 21"
                        StrokeThickness="0"
                        WidthRequest="42">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SaveEditedCommentCommand}" />
                        </Border.GestureRecognizers>
                        <controls:WhiteImage
                            Aspect="AspectFit"
                            HeightRequest="18"
                            HorizontalOptions="Center"
                            Source="save.png"
                            VerticalOptions="Center"
                            WidthRequest="18" />
                    </Border>

                    <CollectionView
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="4"
                        IsVisible="{Binding HasSelectedImages}"
                        ItemsLayout="HorizontalList"
                        ItemsSource="{Binding SelectedImagePreviews}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ImagePreview">
                                <Grid Margin="0,0,10,0">
                                    <Border
                                        Padding="0"
                                        HeightRequest="100"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        WidthRequest="80">
                                        <Image
                                            Aspect="AspectFill"
                                            HeightRequest="100"
                                            Source="{Binding Source}"
                                            WidthRequest="80" />
                                    </Border>
                                    <Border
                                        Padding="0"
                                        BackgroundColor="#CC000000"
                                        HeightRequest="26"
                                        HorizontalOptions="End"
                                        InputTransparent="False"
                                        StrokeShape="RoundRectangle 13"
                                        StrokeThickness="0"
                                        VerticalOptions="Start"
                                        WidthRequest="26"
                                        ZIndex="10">
                                        <Label
                                            BackgroundColor="Transparent"
                                            FontSize="14"
                                            HorizontalOptions="Center"
                                            Text="✕"
                                            TextColor="White"
                                            VerticalOptions="Center" />
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Path=BindingContext.RemovePhotoCommand, Source={RelativeSource AncestorType={x:Type ContentView}, Mode=FindAncestor}}"
                                                CommandParameter="{Binding Id}"
                                                Tapped="OnRemovePhotoTapped" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
