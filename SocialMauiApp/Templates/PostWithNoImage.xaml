<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SocialMauiApp.Templates.PostWithNoImage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:models="clr-namespace:SocialMauiApp.Models"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    x:DataType="models:PostModel">
    <Border
        Padding="0,8"
        BackgroundColor="White"
        StrokeThickness="0">
        <!--  Sử dụng 3 hàng: header, nội dung và actions  -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="5">
            <!--  Header: Thông tin người dùng  -->
            <Grid
                Padding="8,0"
                ColumnDefinitions="40,Auto,*"
                ColumnSpacing="5">
                <Border
                    Grid.Column="0"
                    HeightRequest="40"
                    StrokeShape="RoundRectangle 20"
                    WidthRequest="40">
                    <Image
                        Aspect="AspectFill"
                        HeightRequest="30"
                        HorizontalOptions="Center"
                        Source="{Binding UserPhoto}"
                        VerticalOptions="Center"
                        WidthRequest="30">
                        <Image.Clip>
                            <EllipseGeometry
                                Center="15,15"
                                RadiusX="15"
                                RadiusY="15" />
                        </Image.Clip>
                    </Image>
                </Border>
                <Grid
                    Grid.Column="1"
                    ColumnDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="5"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        Text="{Binding UserName}"
                        TextColor="Black" />
                    <Label
                        Grid.Column="1"
                        Margin="0,-7,0,0"
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="."
                        TextColor="Gray"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="2"
                        FontSize="12"
                        Text="{Binding PostedOnDisplay, StringFormat='{0:dd MMM yyyy}'}"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                </Grid>
            </Grid>

            <!--  Nội dung bài viết  -->
            <Label
                Grid.Row="1"
                Padding="8,0"
                FontSize="15"
                Text="{Binding Content}"
                TextColor="{StaticResource Gray900}">
                <Label.GestureRecognizers>
                    <!--  Sử dụng RelativeSource để truy xuất command từ BasePostViewModel  -->
                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=GoToDetailsPageCommand}" CommandParameter="{Binding .}" />
                </Label.GestureRecognizers>
            </Label>
            <!--  Like + Comment Row  -->
            <Grid
                Grid.Row="2"
                Padding="8,0"
                ColumnDefinitions="*,*"
                ColumnSpacing="0">

                <!--  Likes  -->
                <HorizontalStackLayout
                    Grid.Column="0"
                    HorizontalOptions="Start"
                    Spacing="6">
                    <Image
                        HeightRequest="18"
                        Source="heart_f.png"
                        VerticalOptions="Center"
                        WidthRequest="18" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        Text="{Binding LikeCount}"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                    <Label
                        FontSize="13"
                        Text="likes"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!--  Comments  -->
                <HorizontalStackLayout
                    Grid.Column="1"
                    HorizontalOptions="End"
                    Spacing="6">
                    <Image
                        HeightRequest="18"
                        Source="comment.png"
                        VerticalOptions="Center"
                        WidthRequest="18" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        Text="{Binding CommentCount}"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                    <Label
                        FontSize="13"
                        Text="comments"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>

            <!--  Các hành động (Like, Comment, Save, Share)  -->
            <VerticalStackLayout Grid.Row="3">
                <BoxView Style="{StaticResource fadedLine}" />
                <FlexLayout Margin="0,7,0,0" JustifyContent="SpaceAround">
                    <!--  Like  -->
                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            Source="{Binding IsLikeIcon}"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label Text="Like" TextColor="{StaticResource Primary}" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=ToggleLikeCommand}" CommandParameter="{Binding .}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>

                    <!--  Comment  -->
                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="comment.png"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontSize="12"
                            Text="Comment"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=GoToDetailsPageCommand}" CommandParameter="{Binding}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>

                    <!--  Save  -->
                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="{Binding IsBookmarkIcon}"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontSize="12"
                            Text="Save"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=ToggleBookmarkCommand}" CommandParameter="{Binding .}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>

                    <!--  Share  -->
                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="share.png"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontSize="12"
                            Text="Share"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=SharePostCommand}" CommandParameter="{Binding}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                </FlexLayout>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
