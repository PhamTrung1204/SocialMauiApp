<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SocialMauiApp.Templates.PostWithOnlyImage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:models="clr-namespace:SocialMauiApp.Models"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    x:DataType="models:PostModel">
    <Border
        Padding="0,8"
        BackgroundColor="White"
        StrokeThickness="0">
        <!--  Sử dụng 3 hàng: header, hình ảnh (nếu có) và các hành động  -->
        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
            <!--  Header: Thông tin người dùng  -->
            <Grid
                Padding="8,0"
                ColumnDefinitions="40,Auto,*"
                ColumnSpacing="5">
                <Border
                    Grid.Column="0"
                    HeightRequest="40"
                    StrokeShape="RoundRectangle 20"
                    WidthRequest="40">
                    <Image
                        Aspect="AspectFill"
                        HeightRequest="30"
                        HorizontalOptions="Center"
                        Source="{Binding UserPhoto}"
                        VerticalOptions="Center"
                        WidthRequest="30">
                        <Image.Clip>
                            <EllipseGeometry
                                Center="15,15"
                                RadiusX="15"
                                RadiusY="15" />
                        </Image.Clip>
                    </Image>
                </Border>
                <Grid
                    Grid.Column="1"
                    ColumnDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="5"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        Text="{Binding UserName}" />
                    <Label
                        Grid.Column="1"
                        Margin="0,-7,0,0"
                        FontAttributes="Bold"
                        FontSize="14"
                        Text="."
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="2"
                        FontSize="12"
                        Text="{Binding PostedOnDisplay, StringFormat='{0:dd MMM yyyy}'}"
                        VerticalOptions="Center" />
                </Grid>
            </Grid>

            <!--  Phần hiển thị ảnh: chỉ hiển thị khi PhotoUrl có giá trị  -->
            <Border
                Grid.Row="1"
                BackgroundColor="LightBlue"
                StrokeThickness="0">
                <Border.Triggers>
                    <!--  Ẩn Border nếu PhotoUrl là null hoặc rỗng  -->
                    <DataTrigger Binding="{Binding PhotoUrl}" TargetType="Border">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>

                </Border.Triggers>
                <Image
                    Aspect="Center"
                    HeightRequest="250"
                    Source="{Binding PhotoUrl}" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=GoToDetailsPageCommand}" CommandParameter="{Binding .}" />
                </Border.GestureRecognizers>
            </Border>

            <!--  Phần hành động: Like, Comment, Save, Share  -->
            <VerticalStackLayout Grid.Row="2">
                <BoxView Style="{StaticResource fadedLine}" />
                <FlexLayout Margin="0,7,0,0" JustifyContent="SpaceAround">
                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="{Binding IsLikeIcon}"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontSize="12"
                            Text="Like"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=ToggleLikeCommand}" CommandParameter="{Binding .}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="comment.png"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontSize="12"
                            Text="Comment"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=GoToDetailsPageCommand}" CommandParameter="{Binding .}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="{Binding IsBookmarkIcon}"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontSize="12"
                            Text="Save"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=ToggleBookmarkCommand}" CommandParameter="{Binding .}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="share.png"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontSize="12"
                            Text="Share"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=SharePostCommand}" CommandParameter="{Binding .}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                </FlexLayout>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
