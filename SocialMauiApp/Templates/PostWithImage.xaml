<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SocialMauiApp.Templates.PostWithImage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:converters="clr-namespace:SocialMauiApp.Converters"
    xmlns:dto="clr-namespace:SocialMediaMaui.Shared.Dtos;assembly=SocialMediaMaui.Shared"
    xmlns:models="clr-namespace:SocialMauiApp.Models"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    x:DataType="models:PostModel">
    <ContentView.Resources>
        <converters:LevelToMarginConverter x:Key="LevelToMarginConverter" />
    </ContentView.Resources>
    <Border
        Padding="0,8"
        BackgroundColor="White"
        StrokeThickness="0">
        <Grid RowDefinitions="Auto,Auto,250,Auto,Auto,Auto" RowSpacing="5">
            <!-- Unchanged: Grid.Row="0" (User Avatar and Info) -->
            <Grid
                Grid.Row="0"
                Padding="8,0"
                ColumnDefinitions="40,Auto,*"
                ColumnSpacing="5">
                <Border
                    Grid.Column="0"
                    HeightRequest="40"
                    StrokeShape="RoundRectangle 20"
                    WidthRequest="40">
                    <Image
                        Aspect="AspectFill"
                        HeightRequest="30"
                        HorizontalOptions="Center"
                        Source="{Binding UserPhoto}"
                        VerticalOptions="Center"
                        WidthRequest="30">
                        <Image.Clip>
                            <EllipseGeometry
                                Center="15,15"
                                RadiusX="15"
                                RadiusY="15" />
                        </Image.Clip>
                    </Image>
                </Border>
                <Grid
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    RowDefinitions="Auto, Auto"
                    RowSpacing="1"
                    VerticalOptions="Center">
                    <Label
                        Grid.Row="0"
                        FontAttributes="Bold"
                        FontSize="15"
                        Text="{Binding UserName}"
                        TextColor="Black" />
                    <Label
                        Grid.Row="1"
                        FontSize="10"
                        Text="{Binding PostedOnDisplay}"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                </Grid>
            </Grid>
            <!-- Unchanged: Grid.Row="1" (Post Content) -->
            <Label
                Grid.Row="1"
                Padding="8,0"
                FontSize="15"
                LineBreakMode="WordWrap"
                Text="{Binding Content}"
                TextColor="{StaticResource Gray900}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=GoToDetailsPageCommand}" CommandParameter="{Binding}" />
                </Label.GestureRecognizers>
            </Label>
            <!-- Unchanged: Grid.Row="2" (Post Image) -->
            <Border
                Grid.Row="2"
                HeightRequest="250"
                StrokeThickness="0">
                <Image
                    Aspect="Center"
                    HeightRequest="250"
                    Source="{Binding PhotoUrl}" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=GoToDetailsPageCommand}" CommandParameter="{Binding}" />
                </Border.GestureRecognizers>
            </Border>
            <!-- Unchanged: Grid.Row="3" (Like + Comment Row) -->
            <Grid
                Grid.Row="3"
                Padding="8,0"
                ColumnDefinitions="*,*"
                ColumnSpacing="0">
                <HorizontalStackLayout
                    Grid.Column="0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start"
                    Spacing="6">
                    <Image
                        HeightRequest="18"
                        Source="heart_f.png"
                        VerticalOptions="Center"
                        WidthRequest="18" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        Text="{Binding LikeCount}"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                    <Label
                        FontSize="13"
                        Text="likes"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=GoToDetailsPageCommand}" CommandParameter="{Binding}" />
                    </HorizontalStackLayout.GestureRecognizers>
                </HorizontalStackLayout>
                <HorizontalStackLayout
                    Grid.Column="1"
                    BackgroundColor="Transparent"
                    HorizontalOptions="End"
                    Spacing="6">
                    <Image
                        HeightRequest="18"
                        Source="comment.png"
                        VerticalOptions="Center"
                        WidthRequest="18" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        Text="{Binding CommentCount}"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                    <Label
                        FontSize="13"
                        Text="comments"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=GoToDetailsPageCommand}" CommandParameter="{Binding}" />
                    </HorizontalStackLayout.GestureRecognizers>
                </HorizontalStackLayout>
            </Grid>
            <!-- Unchanged: Grid.Row="4" (Action Buttons) -->
            <VerticalStackLayout Grid.Row="4">
                <BoxView Style="{StaticResource fadedLine}" />
                <FlexLayout Margin="0,7,0,0" JustifyContent="SpaceAround">
                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            Source="{Binding IsLikeIcon}"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontSize="12"
                            Text="Like"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=ToggleLikeCommand}" CommandParameter="{Binding}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="comment.png"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontSize="12"
                            Text="Comment"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleCommentsDisplayCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="{Binding IsBookmarkIcon}"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontSize="12"
                            Text="Save"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=ToggleBookmarkCommand}" CommandParameter="{Binding}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="share.png"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontSize="12"
                            Text="Share"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=SharePostCommand}" CommandParameter="{Binding}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                </FlexLayout>
            </VerticalStackLayout>
            <!-- Comments Section -->
            <VerticalStackLayout
                Grid.Row="5"
                IsVisible="{Binding IsCommentsVisible}"
                Spacing="5">
                <AbsoluteLayout>
                    <CollectionView
                        Margin="0,35,0,0"
                        AbsoluteLayout.LayoutBounds="0,0,1,AutoSize"
                        AbsoluteLayout.LayoutFlags="WidthProportional"
                        ItemsSource="{Binding Comments}"
                        SelectionMode="None"
                        VerticalOptions="Start">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label
                                FontSize="13"
                                HorizontalOptions="Center"
                                Text="No comments yet."
                                TextColor="Gray" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:CommentDto">
                                <Grid
                                    Margin="0,3,0,3"
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="6"
                                    RowDefinitions="Auto,Auto">
                                    <Border
                                        Grid.Column="0"
                                        HeightRequest="32"
                                        StrokeShape="RoundRectangle 16"
                                        VerticalOptions="Start"
                                        WidthRequest="32">
                                        <Image
                                            Aspect="AspectFill"
                                            HeightRequest="32"
                                            Source="{Binding UserPhotoUrl}"
                                            WidthRequest="32" />
                                    </Border>
                                    <Border
                                        Grid.Column="1"
                                        Padding="6,3"
                                        BackgroundColor="#F8F9FA"
                                        Stroke="#E0E0E0"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1"
                                        MinimumHeightRequest="0">
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            RowDefinitions="Auto,Auto,Auto"
                                            RowSpacing="1"
                                            VerticalOptions="Start">
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Orientation="Horizontal"
                                                Spacing="5">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="13"
                                                    Text="{Binding UserName}"
                                                    TextColor="#1C2526" />
                                                <Label
                                                    FontSize="11"
                                                    Text="{Binding AddedOn, StringFormat='{0:MMM dd, yyyy HH:mm}'}"
                                                    TextColor="#65676B" />
                                            </StackLayout>
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                FontSize="13"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding Content}"
                                                TextColor="#1C2526" />
                                            <Image
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Aspect="AspectFit"
                                                HeightRequest="100"
                                                IsVisible="{Binding PhotoUrl, Converter={StaticResource StringToBoolConverter}}"
                                                Source="{Binding PhotoUrl}" />
                                        </Grid>
                                    </Border>
                                    <CollectionView
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="24,3,0,0"
                                        ItemsSource="{Binding Replies}"
                                        SelectionMode="None">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout ItemSpacing="6" Orientation="Vertical" />
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="dto:CommentDto">
                                                <Grid
                                                    Margin="0,3,0,3"
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="6"
                                                    RowDefinitions="Auto">
                                                    <Border
                                                        Grid.Column="0"
                                                        HeightRequest="28"
                                                        StrokeShape="RoundRectangle 14"
                                                        VerticalOptions="Start"
                                                        WidthRequest="28">
                                                        <Image
                                                            Aspect="AspectFill"
                                                            HeightRequest="28"
                                                            Source="{Binding UserPhotoUrl}"
                                                            WidthRequest="28" />
                                                    </Border>
                                                    <Border
                                                        Grid.Column="1"
                                                        Padding="5,3"
                                                        BackgroundColor="#EDF1F4"
                                                        Stroke="#E0E0E0"
                                                        StrokeShape="RoundRectangle 8"
                                                        StrokeThickness="1"
                                                        MinimumHeightRequest="0">
                                                        <Grid
                                                            ColumnDefinitions="*,Auto"
                                                            RowDefinitions="Auto,Auto,Auto"
                                                            RowSpacing="1"
                                                            VerticalOptions="Start">
                                                            <StackLayout
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Orientation="Horizontal"
                                                                Spacing="5">
                                                                <Label
                                                                    FontAttributes="Bold"
                                                                    FontSize="12"
                                                                    Text="{Binding UserName}"
                                                                    TextColor="#1C2526" />
                                                                <Label
                                                                    FontSize="10"
                                                                    Text="{Binding AddedOn, StringFormat='{0:MMM dd, yyyy HH:mm}'}"
                                                                    TextColor="#65676B" />
                                                            </StackLayout>
                                                            <Label
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="2"
                                                                FontSize="12"
                                                                LineBreakMode="WordWrap"
                                                                Text="{Binding Content}"
                                                                TextColor="#1C2526" />
                                                            <Image
                                                                Grid.Row="2"
                                                                Grid.Column="0"
                                                                Aspect="AspectFit"
                                                                HeightRequest="80"
                                                                IsVisible="{Binding PhotoUrl, Converter={StaticResource StringToBoolConverter}}"
                                                                Source="{Binding PhotoUrl}" />
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <!-- Unchanged: Show More/Collapse Button -->
                    <HorizontalStackLayout
                        Margin="0,0,0,5"
                        Padding="5,5"
                        AbsoluteLayout.LayoutBounds="0,0,40,30"
                        AbsoluteLayout.LayoutFlags="PositionProportional"
                        Spacing="5">
                        <Label
                            FontSize="12"
                            IsVisible="{Binding IsCommentsExpanded, Converter={StaticResource InverseBooleanConverter}}"
                            Text="Show More"
                            TextColor="{StaticResource Primary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCommentsVisibilityCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label
                            FontSize="12"
                            IsVisible="{Binding IsCommentsExpanded}"
                            Text="Collapse"
                            TextColor="{StaticResource Primary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCommentsVisibilityCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </AbsoluteLayout>
                <!-- Unchanged: Comment Input -->
                <Grid
                    Padding="8,5"
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="5">
                    <controls:NoBorderEntry
                        Grid.Column="0"
                        Placeholder="Write a comment..."
                        Text="{Binding CommentInput, Mode=TwoWay}"
                        TextColor="Black"
                        VerticalOptions="Center" />
                    <Border
                        Grid.Column="1"
                        BackgroundColor="{StaticResource Primary}"
                        HeightRequest="32"
                        StrokeShape="RoundRectangle 8"
                        WidthRequest="32">
                        <controls:WhiteImage
                            HeightRequest="16"
                            Source="send.png"
                            WidthRequest="16" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddCommentCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>