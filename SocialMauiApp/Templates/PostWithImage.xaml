<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SocialMauiApp.Templates.PostWithImage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:converters="clr-namespace:SocialMauiApp.Converters"
    xmlns:dto="clr-namespace:SocialMediaMaui.Shared.Dtos;assembly=SocialMediaMaui.Shared"
    xmlns:models="clr-namespace:SocialMauiApp.Models"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    x:DataType="models:PostModel">
    <ContentView.Resources>
        <converters:LevelToMarginConverter x:Key="LevelToMarginConverter" />
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
        <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
        <converters:ObjectToBoolConverter x:Key="ObjectToBoolConverter" />
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <!-- MenuFlyout giữ nguyên nhưng không sử dụng trực tiếp, có thể loại bỏ nếu không cần -->
        <MenuFlyout x:Key="CommentOptionsMenu" x:DataType="dto:CommentDto">
            <MenuFlyoutItem
                Command="{Binding Source={x:RelativeSource AncestorType={x:Type models:PostModel}}, Path=EditCommentCommand}"
                CommandParameter="{Binding .}"
                IconImageSource="pencil.png"
                IsEnabled="{Binding IsOwnComment}"
                Text="Edit" />
            <MenuFlyoutItem
                Command="{Binding Source={x:RelativeSource AncestorType={x:Type models:PostModel}}, Path=DeleteCommentCommand}"
                CommandParameter="{Binding .}"
                IconImageSource="trash.png"
                IsEnabled="{Binding IsOwnComment}"
                Text="Delete" />
            <MenuFlyoutItem
                Command="{Binding Source={x:RelativeSource AncestorType={x:Type models:PostModel}}, Path=ReplyCommentCommand}"
                CommandParameter="{Binding .}"
                IconImageSource="reply.png"
                Text="Reply" />
        </MenuFlyout>
    </ContentView.Resources>
    <Border
        Padding="0,8"
        BackgroundColor="White"
        StrokeThickness="0">
        <Grid RowDefinitions="Auto,Auto,250,Auto,Auto,Auto" RowSpacing="5">
            <!-- Grid.Row="0" (User Avatar and Info) -->
            <Grid
                Grid.Row="0"
                Padding="8,0"
                ColumnDefinitions="40,Auto,*"
                ColumnSpacing="5">
                <Border
                    Grid.Column="0"
                    HeightRequest="40"
                    StrokeShape="RoundRectangle 20"
                    WidthRequest="40">
                    <Image
                        Aspect="AspectFill"
                        HeightRequest="30"
                        HorizontalOptions="Center"
                        Source="{Binding UserPhoto}"
                        VerticalOptions="Center"
                        WidthRequest="30">
                        <Image.Clip>
                            <EllipseGeometry
                                Center="15,15"
                                RadiusX="15"
                                RadiusY="15" />
                        </Image.Clip>
                    </Image>
                </Border>
                <Grid
                    Grid.Column="1"
                    HorizontalOptions="Center"
                    RowDefinitions="Auto,Auto"
                    RowSpacing="1"
                    VerticalOptions="Center">
                    <Label
                        Grid.Row="0"
                        FontAttributes="Bold"
                        FontSize="15"
                        Text="{Binding UserName}"
                        TextColor="Black" />
                    <Label
                        Grid.Row="1"
                        FontSize="10"
                        Text="{Binding PostedOnDisplay}"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                </Grid>
            </Grid>
            <!-- Grid.Row="1" (Post Content) -->
            <Label
                Grid.Row="1"
                Padding="8,0"
                FontSize="15"
                LineBreakMode="WordWrap"
                Text="{Binding Content}"
                TextColor="{StaticResource Gray900}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=GoToDetailsPageCommand}"
                        CommandParameter="{Binding}" />
                </Label.GestureRecognizers>
            </Label>
            <!-- Grid.Row="2" (Post Image) -->
            <Border
                Grid.Row="2"
                HeightRequest="250"
                StrokeThickness="0">
                <Image
                    Aspect="AspectFill"
                    HeightRequest="250"
                    Source="{Binding PhotoUrl}" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer
                        Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=GoToDetailsPageCommand}"
                        CommandParameter="{Binding}" />
                </Border.GestureRecognizers>
            </Border>
            <!-- Grid.Row="3" (Like + Comment Row) -->
            <Grid
                Grid.Row="3"
                Padding="8,0"
                ColumnDefinitions="*,*"
                ColumnSpacing="0">
                <HorizontalStackLayout
                    Grid.Column="0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start"
                    Spacing="6">
                    <Image
                        HeightRequest="18"
                        Source="{Binding IsLikeIcon}"
                        VerticalOptions="Center"
                        WidthRequest="18" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        Text="{Binding LikeCount}"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                    <Label
                        FontSize="13"
                        Text="likes"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=GoToDetailsPageCommand}"
                            CommandParameter="{Binding}" />
                    </HorizontalStackLayout.GestureRecognizers>
                </HorizontalStackLayout>
                <HorizontalStackLayout
                    Grid.Column="1"
                    BackgroundColor="Transparent"
                    HorizontalOptions="End"
                    Spacing="6">
                    <Image
                        HeightRequest="18"
                        Source="comment.png"
                        VerticalOptions="Center"
                        WidthRequest="18" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        Text="{Binding CommentCount}"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                    <Label
                        FontSize="13"
                        Text="comments"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=GoToDetailsPageCommand}"
                            CommandParameter="{Binding}" />
                    </HorizontalStackLayout.GestureRecognizers>
                </HorizontalStackLayout>
            </Grid>
            <!-- Grid.Row="4" (Action Buttons) -->
            <VerticalStackLayout Grid.Row="4">
                <BoxView Style="{StaticResource fadedLine}" />
                <FlexLayout Margin="0,7,0,0" JustifyContent="SpaceAround">
                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            Source="{Binding IsLikeIcon}"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontSize="12"
                            Text="Like"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=ToggleLikeCommand}"
                                CommandParameter="{Binding}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="comment.png"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontSize="12"
                            Text="Comment"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleCommentsDisplayCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="{Binding IsBookmarkIcon}"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontSize="12"
                            Text="Save"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=ToggleBookmarkCommand}"
                                CommandParameter="{Binding}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="share.png"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontSize="12"
                            Text="Share"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=SharePostCommand}"
                                CommandParameter="{Binding}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                </FlexLayout>
            </VerticalStackLayout>
            <!-- Comments Section -->
            <VerticalStackLayout
                Grid.Row="5"
                IsVisible="{Binding IsCommentsVisible}"
                Spacing="5">
                <AbsoluteLayout>
                    <CollectionView
                        Margin="0,35,0,0"
                        AbsoluteLayout.LayoutBounds="0,0,1,AutoSize"
                        AbsoluteLayout.LayoutFlags="WidthProportional"
                        ItemsSource="{Binding Comments}"
                        SelectionMode="None"
                        VerticalOptions="Start">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label
                                FontSize="13"
                                HorizontalOptions="Center"
                                Text="No comments yet."
                                TextColor="Gray" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:CommentDto">
                                <Grid
                                    Margin="10,3,10,3"
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="5"
                                    RowDefinitions="Auto,Auto">
                                    <Border
                                        Grid.Column="0"
                                        HeightRequest="32"
                                        StrokeShape="RoundRectangle 16"
                                        VerticalOptions="Start"
                                        WidthRequest="32">
                                        <Image
                                            Aspect="AspectFill"
                                            HeightRequest="32"
                                            Source="{Binding UserPhotoUrl}"
                                            WidthRequest="32" />
                                    </Border>
                                    <Border
                                        Grid.Column="1"
                                        Padding="6,3,6,6"
                                        BackgroundColor="#F8F9AD"
                                        Stroke="#E0E0E0"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="1">
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            RowDefinitions="Auto,Auto,Auto,Auto"
                                            RowSpacing="1"
                                            VerticalOptions="Start">
                                            <!-- Username and Timestamp -->
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Orientation="Horizontal"
                                                Spacing="5">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="13"
                                                    Text="{Binding UserName}"
                                                    TextColor="#1C2526" />
                                                <Label
                                                    FontSize="11"
                                                    Text="{Binding AddedOn, StringFormat='{0:MMM dd, yyyy HH:mm}'}"
                                                    TextColor="#65676B" />
                                            </StackLayout>
                                            <!-- More Options -->
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="4"
                                                BackgroundColor="Transparent"
                                                HeightRequest="24"
                                                Text="⋮"
                                                TextColor="Black"
                                                VerticalOptions="Start">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnMoreOptionsTapped" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <!-- Content -->
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                FontSize="13"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding Content}"
                                                TextColor="#1C2526" />
                                            <!-- Comment Image -->
                                            <Border
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                IsVisible="{Binding PhotoUrl, Converter={StaticResource StringToBoolConverter}}"
                                                StrokeShape="RoundRectangle 10">
                                                <Image
                                                    Aspect="AspectFit"
                                                    HeightRequest="100"
                                                    Source="{Binding PhotoUrl}" />
                                            </Border>
                                            <!-- Reply Button -->
                                            <Label
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                BackgroundColor="Transparent"
                                                FontSize="12"
                                                HorizontalOptions="Start"
                                                Text="Reply"
                                                TextColor="{StaticResource Primary}">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnReplyTapped" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                        </Grid>
                                    </Border>
                                    <!-- Replies -->
                                    <CollectionView
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="30,3,0,0"
                                        ItemsSource="{Binding Replies}"
                                        SelectionMode="None">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout ItemSpacing="6" Orientation="Vertical" />
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="dto:CommentDto">
                                                <Grid
                                                    Margin="0,3,0,3"
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="6"
                                                    RowDefinitions="Auto">
                                                    <Border
                                                        Grid.Column="0"
                                                        HeightRequest="28"
                                                        StrokeShape="RoundRectangle 14"
                                                        VerticalOptions="Start"
                                                        WidthRequest="28">
                                                        <Image
                                                            Aspect="AspectFill"
                                                            HeightRequest="28"
                                                            Source="{Binding UserPhotoUrl}"
                                                            WidthRequest="28" />
                                                    </Border>
                                                    <Border
                                                        Grid.Column="1"
                                                        Padding="5,3"
                                                        BackgroundColor="#EDF1F4"
                                                        Stroke="#E0E0E0"
                                                        StrokeShape="RoundRectangle 8"
                                                        StrokeThickness="1">
                                                        <Grid
                                                            ColumnDefinitions="*,Auto"
                                                            RowDefinitions="Auto,Auto,Auto,Auto"
                                                            RowSpacing="1"
                                                            VerticalOptions="Start">
                                                            <!-- Username and Timestamp -->
                                                            <StackLayout
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Orientation="Horizontal"
                                                                Spacing="5">
                                                                <Label
                                                                    FontAttributes="Bold"
                                                                    FontSize="12"
                                                                    Text="{Binding UserName}"
                                                                    TextColor="#1C2526" />
                                                                <Label
                                                                    FontSize="10"
                                                                    Text="{Binding AddedOn, StringFormat='{0:MMM dd, yyyy HH:mm}'}"
                                                                    TextColor="#65676B" />
                                                            </StackLayout>
                                                            <!-- More Options -->
                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                Padding="2"
                                                                BackgroundColor="Transparent"
                                                                HeightRequest="24"
                                                                Text="⋮"
                                                                TextColor="Black"
                                                                VerticalOptions="Start">
                                                                <Label.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnMoreOptionsTapped" />
                                                                </Label.GestureRecognizers>
                                                            </Label>
                                                            <!-- Content -->
                                                            <Label
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="2"
                                                                FontSize="12"
                                                                LineBreakMode="WordWrap"
                                                                Text="{Binding Content}"
                                                                TextColor="#1C2526" />
                                                            <!-- Reply Image -->
                                                            <Border
                                                                Grid.Row="2"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="2"
                                                                IsVisible="{Binding PhotoUrl, Converter={StaticResource StringToBoolConverter}}"
                                                                StrokeShape="RoundRectangle 10">
                                                                <Image
                                                                    Aspect="AspectFit"
                                                                    HeightRequest="80"
                                                                    Source="{Binding PhotoUrl}" />
                                                            </Border>
                                                            <!-- Reply Button -->
                                                            <Label
                                                                Grid.Row="3"
                                                                Grid.Column="0"
                                                                BackgroundColor="Transparent"
                                                                FontSize="12"
                                                                HorizontalOptions="Start"
                                                                Text="Reply"
                                                                TextColor="{StaticResource Primary}">
                                                                <Label.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnReplyTapped" />
                                                                </Label.GestureRecognizers>
                                                            </Label>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <!-- Show More/Collapse Button -->
                    <HorizontalStackLayout
                        Margin="0,0,0,5"
                        Padding="5,5"
                        AbsoluteLayout.LayoutBounds="0,0,AutoSize,30"
                        AbsoluteLayout.LayoutFlags="PositionProportional"
                        Spacing="5">
                        <Label
                            FontSize="12"
                            IsVisible="{Binding IsCommentsExpanded, Converter={StaticResource InverseBooleanConverter}}"
                            Text="Show More"
                            TextColor="{StaticResource Primary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCommentsVisibilityCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label
                            FontSize="12"
                            IsVisible="{Binding IsCommentsExpanded}"
                            Text="Collapse"
                            TextColor="{StaticResource Primary}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleCommentsVisibilityCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </HorizontalStackLayout>
                </AbsoluteLayout>
                <!-- Comment Input Section -->
                <Grid
                    Padding="8,5"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="5"
                    RowDefinitions="Auto,Auto,Auto">
                    <!-- Reply/Edit Indicator -->
                    <HorizontalStackLayout
                        Grid.Row="0"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Spacing="8">
                        <Label
                            FontSize="12"
                            IsVisible="{Binding ReplyingToComment, Converter={StaticResource ObjectToBoolConverter}}"
                            Text="{Binding ReplyingToComment.UserName, StringFormat='Replying to {0}'}"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CancelReplyCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                        <Label
                            FontSize="12"
                            IsVisible="{Binding IsEditing}"
                            Text="Editing comment"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <Border
                            BackgroundColor="White"
                            HeightRequest="20"
                            IsVisible="{Binding IsEditing}"
                            Stroke="{StaticResource Gray200}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            VerticalOptions="Center"
                            WidthRequest="20">
                            <Image
                                HeightRequest="12"
                                HorizontalOptions="Center"
                                Source="x.png"
                                VerticalOptions="Center"
                                WidthRequest="12" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CancelEditCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </HorizontalStackLayout>
                    <!-- Pick Image Button -->
                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        Padding="8,3"
                        IsVisible="{Binding IsPhotoButtonVisible}"
                        Stroke="{StaticResource Primary}"
                        StrokeShape="RoundRectangle 5">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="photo.png"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectPhotoCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                    <!-- Comment Entry -->
                    <controls:NoBorderEntry
                        Grid.Row="1"
                        Grid.Column="1"
                        Placeholder="Write a comment..."
                        Text="{Binding CommentInput, Mode=TwoWay}"
                        TextColor="Black"
                        VerticalOptions="Center" />
                    <!-- Send Button -->
                    <Border
                        Grid.Row="1"
                        Grid.Column="2"
                        BackgroundColor="{StaticResource Primary}"
                        HeightRequest="32"
                        StrokeShape="RoundRectangle 8"
                        WidthRequest="32">
                        <controls:WhiteImage
                            HeightRequest="16"
                            Source="send.png"
                            WidthRequest="16" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddCommentCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                    <!-- Selected Images Preview -->
                    <CollectionView
                        Grid.Row="2"
                        Grid.Column="0"
                        Grid.ColumnSpan="3"
                        IsVisible="{Binding HasSelectedImages}"
                        ItemsLayout="HorizontalList"
                        ItemsSource="{Binding SelectedImagePreviews}"
                        SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ImagePreview">
                                <Grid Margin="5,0,5,0">
                                    <HorizontalStackLayout Padding="5">
                                        <Border
                                            HeightRequest="80"
                                            Stroke="LightGray"
                                            StrokeShape="RoundRectangle 10"
                                            StrokeThickness="2"
                                            WidthRequest="60">
                                            <Image
                                                Aspect="AspectFill"
                                                HeightRequest="80"
                                                Source="{Binding Source}"
                                                WidthRequest="60" />
                                        </Border>
                                        <Border
                                            BackgroundColor="#CC000000"
                                            HeightRequest="24"
                                            HorizontalOptions="End"
                                            InputTransparent="False"
                                            StrokeShape="RoundRectangle 12"
                                            VerticalOptions="Start"
                                            WidthRequest="24"
                                            ZIndex="10">
                                            <Label
                                                BackgroundColor="Transparent"
                                                FontSize="14"
                                                HorizontalOptions="Center"
                                                Text="✕"
                                                TextColor="White"
                                                VerticalOptions="Center" />
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Tapped="OnRemovePhotoTapped"
                                                    Command="{Binding Path=RemovePhotoCommand, Source={x:RelativeSource AncestorType={x:Type models:PostModel}}}"
                                                    CommandParameter="{Binding Id}" />
                                            </Border.GestureRecognizers>
                                        </Border>
                                    </HorizontalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>