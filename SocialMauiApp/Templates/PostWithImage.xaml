<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="SocialMauiApp.Templates.PostWithImage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:models="clr-namespace:SocialMauiApp.Models"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    x:DataType="models:PostModel">
    <Border
        Padding="0,8"
        BackgroundColor="White"
        StrokeThickness="0">
        <Grid RowDefinitions="Auto,Auto,250,Auto,Auto" RowSpacing="5">
            <Grid
                Padding="8,0"
                ColumnDefinitions="40,Auto,*"
                ColumnSpacing="5">
                <Border
                    Grid.Column="0"
                    HeightRequest="40"
                    StrokeShape="RoundRectangle 20"
                    WidthRequest="40">
                    <Image
                        Aspect="AspectFill"
                        HeightRequest="30"
                        HorizontalOptions="Center"
                        Source="{Binding UserPhoto}"
                        VerticalOptions="Center"
                        WidthRequest="30">
                        <Image.Clip>
                            <EllipseGeometry
                                Center="15,15"
                                RadiusX="15"
                                RadiusY="15" />
                        </Image.Clip>
                    </Image>
                </Border>

                <Grid
                    Grid.Column="1"
                    RowDefinitions="Auto, Auto"
                    RowSpacing="1"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Label
                        Grid.Row="0"
                        FontAttributes="Bold"
                        FontSize="15"
                        Text="{Binding UserName}"
                        TextColor="Black" />
                    
                    <Label
                        Grid.Row="1"
                        FontSize="10"
                        Text="{Binding PostedOnDisplay}"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                </Grid>
            </Grid>
            <Label
                Grid.Row="1"
                Padding="8,0"
                FontSize="15"
                LineBreakMode="WordWrap"
                Text="{Binding Content}"
                TextColor="{StaticResource Gray900}">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=GoToDetailsPageCommand}" CommandParameter="{Binding}" />
                </Label.GestureRecognizers>
            </Label>
            <Border
                Grid.Row="2"
                HeightRequest="250"
                StrokeThickness="0">
                <Image
                    Aspect="Center"
                    HeightRequest="250"
                    Source="{Binding PhotoUrl}" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=GoToDetailsPageCommand}" CommandParameter="{Binding}" />
                </Border.GestureRecognizers>
            </Border>
            <!--  Like + Comment Row  -->
            <Grid
                Grid.Row="3"
                Padding="8,0"
                ColumnDefinitions="*,*"
                ColumnSpacing="0">

                <!--  Likes  -->
                <HorizontalStackLayout
                    Grid.Column="0"
                    BackgroundColor="Transparent"
                    HorizontalOptions="Start"
                    Spacing="6">
                    <Image
                        HeightRequest="18"
                        Source="heart_f.png"
                        VerticalOptions="Center"
                        WidthRequest="18" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        Text="{Binding LikeCount}"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                    <Label
                        FontSize="13"
                        Text="likes"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=GoToDetailsPageCommand}" CommandParameter="{Binding}" />
                    </HorizontalStackLayout.GestureRecognizers>
                </HorizontalStackLayout>

                <!--  Comments  -->
                <HorizontalStackLayout
                    Grid.Column="1"
                    HorizontalOptions="End"
                    BackgroundColor="Transparent"
                    Spacing="6">
                    <Image
                        HeightRequest="18"
                        Source="comment.png"
                        VerticalOptions="Center"
                        WidthRequest="18" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="13"
                        Text="{Binding CommentCount}"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                    <Label
                        FontSize="13"
                        Text="comments"
                        TextColor="Gray"
                        VerticalOptions="Center" />
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=GoToDetailsPageCommand}" CommandParameter="{Binding}" />
                    </HorizontalStackLayout.GestureRecognizers>
                </HorizontalStackLayout>
            </Grid>

            <VerticalStackLayout Grid.Row="4">

                <BoxView Style="{StaticResource fadedLine}" />

                <FlexLayout Margin="0,7,0,0" JustifyContent="SpaceAround">

                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            Source="{Binding IsLikeIcon}"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontSize="12"
                            Text="Like"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=ToggleLikeCommand}" CommandParameter="{Binding}" />

                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="comment.png"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontSize="12"
                            Text="Comment"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=GoToDetailsPageCommand}" CommandParameter="{Binding}" />

                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="{Binding IsBookmarkIcon}"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontSize="12"
                            Text="Save"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=ToggleBookmarkCommand}" CommandParameter="{Binding}" />

                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="2">
                        <controls:PrimaryColorImage
                            HeightRequest="20"
                            Source="share.png"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Label
                            FontSize="12"
                            Text="Share"
                            TextColor="{StaticResource Primary}"
                            VerticalOptions="Center" />
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BasePostViewModel}}, Path=SharePostCommand}" CommandParameter="{Binding}" />
                        </HorizontalStackLayout.GestureRecognizers>
                    </HorizontalStackLayout>
                </FlexLayout>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
