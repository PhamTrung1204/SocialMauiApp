<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:ext="clr-namespace:SocialMauiApp.Extensions"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    Title="{ext:Translate Login_Register}"
    Padding="0"
    x:DataType="vm:RegisterViewModel"
    BackgroundColor="{StaticResource Primary}"
    Shell.TitleColor="White">

    <Grid Background="{StaticResource BrandGradientBrush}">
        <!--  Một ScrollView duy nhất: lồng hai ScrollView cùng trục làm hỏng cuộn trên Android.  -->
        <ScrollView>
            <Border Margin="18,28" Padding="26,30" Style="{StaticResource FlatCardStyle}">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,6" Radius="18" Opacity="0.18" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="20">

                    <VerticalStackLayout Spacing="2">
                        <Label HorizontalTextAlignment="Center" Style="{StaticResource PageTitleStyle}" Text="{ext:Translate Register_Title}" />
                        <Label HorizontalTextAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="{ext:Translate Register_Subtitle}" />
                    </VerticalStackLayout>

                    <!--  Ảnh đại diện + nút chọn ảnh  -->
                    <Grid HeightRequest="124" HorizontalOptions="Center" WidthRequest="124">
                        <Border Padding="0"
                                BackgroundColor="{StaticResource Gray100}"
                                HeightRequest="118"
                                Stroke="{StaticResource PrimarySoft}"
                                StrokeShape="RoundRectangle 59"
                                StrokeThickness="3"
                                WidthRequest="118">
                            <Image Aspect="AspectFill"
                                   HeightRequest="118"
                                   Source="{Binding PhotoImageSource}"
                                   WidthRequest="118" />
                        </Border>
                        <Border Padding="0"
                                BackgroundColor="{StaticResource Primary}"
                                HeightRequest="42"
                                HorizontalOptions="End"
                                StrokeShape="Ellipse"
                                StrokeThickness="0"
                                VerticalOptions="End"
                                WidthRequest="42">
                            <ImageButton Aspect="AspectFit"
                                         BackgroundColor="Transparent"
                                         Command="{Binding SelectPhotoCommand}"
                                         HeightRequest="20"
                                         HorizontalOptions="Center"
                                         Source="camera.png"
                                         VerticalOptions="Center"
                                         WidthRequest="20" />
                        </Border>
                    </Grid>

                    <VerticalStackLayout Spacing="14">

                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource MutedTextStyle}" Text="{ext:Translate Register_Name}" />
                            <Border x:Name="NameBorder" Style="{StaticResource FieldStyle}">
                                <controls:NoBorderEntry
                                    BackgroundColor="Transparent"
                                    HeightRequest="46"
                                    Placeholder="{ext:Translate Register_NamePlaceholder}"
                                    Text="{Binding Username}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal" />
                                            <VisualState Name="Focused">
                                                <VisualState.Setters>
                                                    <Setter TargetName="NameBorder" Property="Border.Stroke" Value="{StaticResource Primary}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </controls:NoBorderEntry>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource MutedTextStyle}" Text="{ext:Translate Login_Email}" />
                            <Border x:Name="EmailBorder" Style="{StaticResource FieldStyle}">
                                <controls:NoBorderEntry
                                    BackgroundColor="Transparent"
                                    HeightRequest="46"
                                    Keyboard="Email"
                                    Placeholder="{ext:Translate Login_EmailPlaceholder}"
                                    Text="{Binding Email}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal" />
                                            <VisualState Name="Focused">
                                                <VisualState.Setters>
                                                    <Setter TargetName="EmailBorder" Property="Border.Stroke" Value="{StaticResource Primary}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </controls:NoBorderEntry>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource MutedTextStyle}" Text="{ext:Translate Login_Password}" />
                            <Border x:Name="PasswordBorder" Style="{StaticResource FieldStyle}">
                                <controls:NoBorderEntry
                                    BackgroundColor="Transparent"
                                    HeightRequest="46"
                                    IsPassword="True"
                                    Placeholder="{ext:Translate Login_PasswordPlaceholder}"
                                    Text="{Binding Password}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal" />
                                            <VisualState Name="Focused">
                                                <VisualState.Setters>
                                                    <Setter TargetName="PasswordBorder" Property="Border.Stroke" Value="{StaticResource Primary}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </controls:NoBorderEntry>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Style="{StaticResource MutedTextStyle}" Text="{ext:Translate Register_ConfirmPassword}" />
                            <Border x:Name="ConfirmPasswordBorder" Style="{StaticResource FieldStyle}">
                                <controls:NoBorderEntry
                                    BackgroundColor="Transparent"
                                    HeightRequest="46"
                                    IsPassword="True"
                                    Placeholder="{ext:Translate Register_ConfirmPasswordPlaceholder}"
                                    Text="{Binding RepeatPassword}">
                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal" />
                                            <VisualState Name="Focused">
                                                <VisualState.Setters>
                                                    <Setter TargetName="ConfirmPasswordBorder" Property="Border.Stroke" Value="{StaticResource Primary}" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>
                                </controls:NoBorderEntry>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Button Command="{Binding RegisterCommand}" Text="{ext:Translate Login_Register}" />

                    <Grid Margin="0,4" ColumnDefinitions="*,Auto,*" VerticalOptions="Center">
                        <BoxView Grid.Column="0" Style="{StaticResource SeparatorStyle}" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Padding="12,0"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="{ext:Translate Register_HaveAccount}" />
                        <BoxView Grid.Column="2" Style="{StaticResource SeparatorStyle}" VerticalOptions="Center" />
                    </Grid>

                    <Button Clicked="btnLogin_Clicked"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Text="{ext:Translate Login_SignIn}" />
                </VerticalStackLayout>
            </Border>
        </ScrollView>

        <ActivityIndicator HorizontalOptions="Center"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           VerticalOptions="Center"
                           Color="White" />
    </Grid>
</ContentPage>
