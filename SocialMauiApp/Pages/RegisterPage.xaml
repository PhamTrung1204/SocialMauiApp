<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    Title="Register"
    Padding="20"
    x:DataType="vm:RegisterViewModel"
    BackgroundColor="SkyBlue"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.TitleColor="White">
    <Grid>
        <ScrollView VerticalScrollBarVisibility="Never">
            <Grid
                RowDefinitions="Auto, Auto, Auto"
                RowSpacing="20"
                VerticalOptions="Center">
                <Image
                    Grid.Row="0"
                    HeightRequest="200"
                    Source="social_media.png" />
                <Label
                    Grid.Row="1"
                    FontAttributes="Bold"
                    FontSize="25"
                    HorizontalOptions="Center"
                    Text="Register" />
                <VerticalStackLayout Grid.Row="2" Spacing="2">
                    <Grid HeightRequest="100" WidthRequest="100">

                        <!--  Avatar bo tròn, ảnh fill kín khung 100×100  -->
                        <Border
                            BackgroundColor="White"
                            HeightRequest="100"
                            StrokeShape="RoundRectangle 50"
                            StrokeThickness="2"
                            WidthRequest="100">
                            <Image
                                Aspect="AspectFill"
                                HeightRequest="100"
                                Source="{Binding PhotoImageSource}"
                                WidthRequest="100" />
                        </Border>

                        <!--  Badge chỉnh sửa, luôn nằm trên cùng  -->
                        <Border
                            Margin="0,0,4,-10"
                            BackgroundColor="White"
                            HeightRequest="55"
                            HorizontalOptions="End"
                            StrokeShape="Ellipse"
                            StrokeThickness="2"
                            VerticalOptions="End"
                            WidthRequest="55">

                            <ImageButton
                                Aspect="AspectFit"
                                BackgroundColor="Transparent"
                                Command="{Binding SelectPhotoCommand}"
                                HeightRequest="24"
                                HorizontalOptions="Center"
                                Source="camera.png"
                                VerticalOptions="Center"
                                WidthRequest="24" />
                        </Border>


                    </Grid>

                    <Label Style="{StaticResource formLabel}" Text="Enter Name" />
                    <controls:NoBorderEntry
                        BackgroundColor="LightGoldenrodYellow"
                        Placeholder="Enter Name"
                        PlaceholderColor="LightGray"
                        Text="{Binding Name}"
                        TextColor="Black" />
                    <controls:Spacer />

                    <Label Style="{StaticResource formLabel}" Text="Email" />
                    <controls:NoBorderEntry
                        BackgroundColor="LightGoldenrodYellow"
                        IsPassword="True"
                        Keyboard="Email"
                        Placeholder="Email"
                        PlaceholderColor="LightGray"
                        Text="{Binding Email}"
                        TextColor="Black" />
                    <controls:Spacer />

                    <Label Style="{StaticResource formLabel}" Text="Password" />
                    <controls:NoBorderEntry
                        BackgroundColor="LightGoldenrodYellow"
                        IsPassword="True"
                        Placeholder="Enter Password"
                        PlaceholderColor="LightGray"
                        Text="{Binding Password}"
                        TextColor="Black" />
                    <controls:Spacer />

                    <Label Style="{StaticResource formLabel}" Text="Confirm Password" />
                    <controls:NoBorderEntry
                        BackgroundColor="LightGoldenrodYellow"
                        IsPassword="True"
                        Placeholder="Confirm Password"
                        PlaceholderColor="LightGray"
                        Text="{Binding RepeatPassword}"
                        TextColor="Black" />
                    <controls:Spacer />

                    <Button
                        x:Name="btnRegister"
                        Command="{Binding RegisterCommand}"
                        Style="{StaticResource rounded}"
                        Text="Register" />
                    <controls:Spacer />
                    <Grid ColumnDefinitions="*, Auto, *" ColumnSpacing="5">
                        <BoxView Grid.Column="0" Style="{StaticResource fadedLine}" />

                        <Label
                            Grid.Column="1"
                            HorizontalOptions="Center"
                            Text="Have an account?"
                            TextColor="{StaticResource Primary}" />
                        <BoxView Grid.Column="2" Style="{StaticResource fadedLine}" />
                    </Grid>
                    <controls:Spacer />
                    <Button
                        x:Name="btnLogin"
                        Clicked="btnLogin_Clicked"
                        Style="{StaticResource rounded}"
                        Text="Login" />
                </VerticalStackLayout>
            </Grid>
        </ScrollView>
        <ActivityIndicator
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>