<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.PostDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:converters="clr-namespace:SocialMauiApp.Converters"
    xmlns:dto="clr-namespace:SocialMediaMaui.Shared.Dtos;assembly=SocialMediaMaui.Shared"
    xmlns:models="clr-namespace:SocialMauiApp.Models"
    xmlns:templates="clr-namespace:SocialMauiApp.Templates"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    x:DataType="vm:DetailsViewModel"
    BackgroundColor="{StaticResource Gray100}"
    Shell.PresentationMode="ModalAnimated">

    <!--  Resources  -->
    <ContentPage.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
        <MenuFlyout x:Key="CommentOptionsMenu">
            <MenuFlyoutItem
                Command="{Binding BindingContext.EditAndUpdateCommentCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                CommandParameter="{Binding .}"
                IconImageSource="pencil.png"
                Text="Edit" />
            <MenuFlyoutItem
                Command="{Binding BindingContext.DeleteCommentCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                CommandParameter="{Binding .}"
                IconImageSource="trash.png"
                Text="Delete" />
        </MenuFlyout>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{StaticResource Primary}" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid Margin="0,-10,0,0" RowDefinitions="Auto,*,Auto">

        <!--  Header  -->
        <Grid
            Grid.Row="0"
            Padding="15"
            BackgroundColor="{StaticResource Primary}"
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="10">
            <!--  Close  -->
            <Border
                Grid.Column="0"
                BackgroundColor="White"
                HeightRequest="30"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="0"
                WidthRequest="30">
                <Image
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    Source="x.png"
                    VerticalOptions="Center"
                    WidthRequest="24" />
                <Border.Shadow>
                    <Shadow Brush="Gray" Radius="10" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                </Border.GestureRecognizers>
            </Border>
            <!--  Spacer  -->
            <Grid Grid.Column="1" />
            <!--  Edit  -->
            <Border
                Grid.Column="2"
                BackgroundColor="White"
                HeightRequest="30"
                IsVisible="{Binding IsOwnPost}"
                StrokeShape="RoundRectangle 8"
                WidthRequest="30">
                <Image
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    Source="pencil.png"
                    VerticalOptions="Center"
                    WidthRequest="24" />
                <Border.Shadow>
                    <Shadow Brush="Gray" Radius="10" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding EditPostCommand}" />
                </Border.GestureRecognizers>
            </Border>
            <!--  Delete  -->
            <Border
                Grid.Column="3"
                BackgroundColor="White"
                HeightRequest="30"
                IsVisible="{Binding IsOwnPost}"
                StrokeShape="RoundRectangle 8"
                WidthRequest="30">
                <Image
                    HeightRequest="18"
                    HorizontalOptions="Center"
                    Source="trash.png"
                    VerticalOptions="Center"
                    WidthRequest="18" />
                <Border.Shadow>
                    <Shadow Brush="Gray" Radius="10" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding DeletePostCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!--  Content  -->
        <ScrollView Grid.Row="1">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <!--  Post Display  -->
                <ContentView Grid.Row="0" BindingContext="{Binding Post}">
                    <ContentView.Resources>
                        <ControlTemplate x:Key="withImage">
                            <templates:PostWithImage />
                        </ControlTemplate>
                        <ControlTemplate x:Key="withOnlyImage">
                            <templates:PostWithOnlyImage />
                        </ControlTemplate>
                        <ControlTemplate x:Key="noImage">
                            <templates:PostWithNoImage />
                        </ControlTemplate>
                    </ContentView.Resources>
                    <ContentView.Triggers>
                        <DataTrigger
                            x:DataType="models:PostModel"
                            Binding="{Binding PostTemplateContentViewName}"
                            TargetType="ContentView"
                            Value="WithNoImage">
                            <Setter Property="ControlTemplate" Value="{StaticResource noImage}" />
                        </DataTrigger>
                        <DataTrigger
                            x:DataType="models:PostModel"
                            Binding="{Binding PostTemplateContentViewName}"
                            TargetType="ContentView"
                            Value="ImageOnly">
                            <Setter Property="ControlTemplate" Value="{StaticResource withOnlyImage}" />
                        </DataTrigger>
                        <DataTrigger
                            x:DataType="models:PostModel"
                            Binding="{Binding PostTemplateContentViewName}"
                            TargetType="ContentView"
                            Value="WithImage">
                            <Setter Property="ControlTemplate" Value="{StaticResource withImage}" />
                        </DataTrigger>
                    </ContentView.Triggers>
                </ContentView>

                <!--  Comments List  -->
                <VerticalStackLayout
                    Grid.Row="1"
                    Padding="10"
                    BackgroundColor="White"
                    Spacing="8">
                    <CollectionView
                        ItemsSource="{Binding Comments}"
                        RemainingItemsThreshold="1"
                        RemainingItemsThresholdReached="CollectionView_RemainingItemsThresholdReached">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="12" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label
                                FontSize="16"
                                HorizontalOptions="Center"
                                Text="No comments yet."
                                TextColor="Gray" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:CommentDto">
                                <Grid
                                    Margin="5,0,5,0"
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="8"
                                    RowDefinitions="Auto">
                                    <!--  Avatar  -->
                                    <Border
                                        Grid.Column="0"
                                        HeightRequest="40"
                                        StrokeShape="RoundRectangle 20"
                                        VerticalOptions="Start"
                                        WidthRequest="40">
                                        <Image
                                            Aspect="AspectFill"
                                            HeightRequest="40"
                                            Source="{Binding UserPhoto}"
                                            WidthRequest="40" />
                                    </Border>
                                    <!--  Comment Content  -->
                                    <Border
                                        Grid.Column="1"
                                        Padding="10"
                                        BackgroundColor="#F5F5F5"
                                        StrokeShape="RoundRectangle 12"
                                        VerticalOptions="Start">
                                        <Border.Shadow>
                                            <Shadow
                                                Brush="#DDDDDD"
                                                Radius="4"
                                                Offset="2,2" />
                                        </Border.Shadow>
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            RowDefinitions="Auto,Auto,Auto"
                                            RowSpacing="6">
                                            <!--  Username and Timestamp  -->
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Orientation="Horizontal"
                                                Spacing="5"
                                                VerticalOptions="Start">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="15"
                                                    Text="{Binding UserName}"
                                                    TextColor="#1C2526" />
                                                <Label
                                                    FontSize="13"
                                                    Text="{Binding AddedOn, StringFormat='{0:hh:mm tt · dd MMM yyyy}'}"
                                                    TextColor="#65676B"
                                                    VerticalOptions="Center" />
                                            </StackLayout>
                                            <!--  More Options  -->
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="4"
                                                BackgroundColor="Transparent"
                                                HeightRequest="24"
                                                IsVisible="{Binding IsOwnComment}"
                                                VerticalOptions="Start"
                                                WidthRequest="24">
                                                <Image
                                                    HeightRequest="20"
                                                    Source="more.png"
                                                    WidthRequest="20">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnMoreOptionsTapped" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                            </Border>
                                            <!--  Content  -->
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                FontSize="15"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding Content}"
                                                TextColor="#1C2526" />
                                            <!--  Comment Image  -->
                                            <Image
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Margin="0,8,0,0"
                                                Aspect="AspectFit"
                                                HeightRequest="120"
                                                HorizontalOptions="Start"
                                                IsVisible="{Binding PhotoUrl, Converter={StaticResource StringToBoolConverter}}"
                                                Source="{Binding PhotoUrl}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!--  Comment Input + Image Preview  -->
        <!-- Comment Input + Image Preview -->
        <Grid
    Grid.Row="2"
    Padding="10,5,10,10"
    BackgroundColor="White"
    ColumnDefinitions="Auto,*,Auto"
    ColumnSpacing="8"
    RowDefinitions="Auto,Auto">
            <!-- Pick Image Button -->
            <Border
        Grid.Row="0"
        Grid.Column="0"
        Padding="10,5"
        Stroke="{StaticResource Primary}"
        StrokeShape="RoundRectangle 5"
        IsVisible="{Binding IsPhotoButtonVisible}">
                <controls:PrimaryColorImage
            HeightRequest="25"
            Source="photo.png"
            VerticalOptions="Center"
            WidthRequest="25" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectPhotoCommand}" />
                </Border.GestureRecognizers>
            </Border>
            <!-- Comment Entry -->
            <controls:NoBorderEntry
        Grid.Row="0"
        Grid.Column="1"
        Placeholder="Write a comment..."
        Text="{Binding Comment, Mode=TwoWay}"
        TextColor="Black"
        VerticalOptions="Center" />
            <!-- Send Button -->
            <Border
        Grid.Row="0"
        Grid.Column="2"
        BackgroundColor="{StaticResource Primary}"
        HeightRequest="40"
        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
        StrokeShape="RoundRectangle 8"
        WidthRequest="40">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddCommentCommand}" />
                </Border.GestureRecognizers>
                <controls:WhiteImage
            HeightRequest="20"
            Source="send.png"
            WidthRequest="20" />
            </Border>
            <!-- Selected Images Preview -->
            <CollectionView
        Grid.Row="1"
        Grid.Column="0"
        Grid.ColumnSpan="3"
        IsVisible="{Binding HasSelectedImages}"
        ItemsLayout="HorizontalList"
        ItemsSource="{Binding SelectedImagePreviews}"
        SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ImagePreview">
                        <Grid
                    Margin="5,0,5,0"
                    HeightRequest="60"
                    WidthRequest="60">
                            <Image Aspect="AspectFill" Source="{Binding Source}" />
                            <Border
                        BackgroundColor="#CC000000"
                        HeightRequest="20"
                        HorizontalOptions="End"
                        StrokeShape="RoundRectangle 10"
                        VerticalOptions="Start"
                        WidthRequest="20">
                                <Label
                            FontSize="12"
                            HorizontalOptions="Center"
                            Text="✕"
                            TextColor="White"
                            VerticalOptions="Center" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                Command="{Binding BindingContext.RemovePhotoCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                CommandParameter="{Binding Id}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <!--  Activity Indicator  -->
        <ActivityIndicator
            Grid.RowSpan="3"
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>