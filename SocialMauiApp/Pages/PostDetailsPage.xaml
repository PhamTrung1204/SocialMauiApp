<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.PostDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:dto="clr-namespace:SocialMediaMaui.Shared.Dtos;assembly=SocialMediaMaui.Shared"
    xmlns:templates="clr-namespace:SocialMauiApp.Templates"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    x:DataType="vm:DetailsViewModel"
    BackgroundColor="{StaticResource Gray100}"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*,Auto">
        <!--  Header  -->
        <Grid
            Grid.Row="0"
            Padding="15"
            BackgroundColor="{StaticResource Primary}"
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="10">
            <!--  Close Button  -->
            <Border
                Grid.Column="0"
                BackgroundColor="White"
                HeightRequest="30"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="0"
                WidthRequest="30">
                <Image
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    Source="x.png"
                    VerticalOptions="Center"
                    WidthRequest="24" />
                <Border.Shadow>
                    <Shadow Brush="Gray" Radius="10" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                </Border.GestureRecognizers>
            </Border>
            <!--  Spacer  -->
            
            <!--  Edit Button (chỉ hiển thị nếu là bài viết của chính người dùng)  -->
            <Border
                Grid.Column="2"
                BackgroundColor="White"
                HeightRequest="30"
                IsVisible="{Binding IsOwnPost}"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="0"
                WidthRequest="30">
                <Image
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    Source="pencil.png"
                    VerticalOptions="Center"
                    WidthRequest="24" />
                <Border.Shadow>
                    <Shadow Brush="Gray" Radius="10" />
                </Border.Shadow>
            </Border>
            <!--  Delete Button (chỉ hiển thị nếu là bài viết của chính người dùng)  -->
            <Border
                Grid.Column="3"
                BackgroundColor="White"
                HeightRequest="30"
                IsVisible="{Binding IsOwnPost}"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="0"
                WidthRequest="30">
                <Image
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    Source="trash.png"
                    VerticalOptions="Center"
                    WidthRequest="24" />
                <Border.Shadow>
                    <Shadow Brush="Gray" Radius="10" />
                </Border.Shadow>
            </Border>
        </Grid>

        <!--  Nội dung chính  -->
        <ScrollView Grid.Row="1">
            <Grid RowDefinitions="Auto, *" RowSpacing="10">
                <!--  Phần hiển thị bài viết theo ControlTemplate  -->
                <ContentView Grid.Row="0" BindingContext="{Binding Post}">
                    <ContentView.Resources>
                        <ControlTemplate x:Key="withImage">
                            <templates:PostWithImage />
                        </ControlTemplate>
                        <ControlTemplate x:Key="withOnlyImage">
                            <templates:PostWithOnlyImage />
                        </ControlTemplate>
                        <ControlTemplate x:Key="noImage">
                            <templates:PostWithNoImage />
                        </ControlTemplate>
                    </ContentView.Resources>
                    <ContentView.Triggers>
                        <DataTrigger
                            Binding="{Binding PostTemplateContentViewName}"
                            TargetType="ContentView"
                            Value="WithNoImage">
                            <Setter Property="ControlTemplate" Value="{StaticResource noImage}" />
                        </DataTrigger>
                        <DataTrigger
                            Binding="{Binding PostTemplateContentViewName}"
                            TargetType="ContentView"
                            Value="ImageOnly">
                            <Setter Property="ControlTemplate" Value="{StaticResource withOnlyImage}" />
                        </DataTrigger>
                        <DataTrigger
                            Binding="{Binding PostTemplateContentViewName}"
                            TargetType="ContentView"
                            Value="WithImage">
                            <Setter Property="ControlTemplate" Value="{StaticResource withImage}" />
                        </DataTrigger>
                    </ContentView.Triggers>
                </ContentView>

