<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.PostDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:converters="clr-namespace:SocialMauiApp.Converters"
    xmlns:dto="clr-namespace:SocialMediaMaui.Shared.Dtos;assembly=SocialMediaMaui.Shared"
    xmlns:models="clr-namespace:SocialMauiApp.Models"
    xmlns:templates="clr-namespace:SocialMauiApp.Templates"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    xmlns:behaviors="clr-namespace:SocialMauiApp.Behaviors"
    x:DataType="vm:DetailsViewModel"
    BackgroundColor="{StaticResource Gray100}"
    Shell.PresentationMode="ModalAnimated">

    <ContentPage.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
        <converters:LevelToMarginConverter x:Key="LevelToMarginConverter" />
        <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
        <converters:ObjectToBoolConverter x:Key="ObjectToBoolConverter" />
        <MenuFlyout x:Key="CommentOptionsMenu" x:DataType="dto:CommentDto">
            <MenuFlyoutItem
                Command="{Binding BindingContext.EditAndUpdateCommentCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                CommandParameter="{Binding .}"
                IconImageSource="pencil.png"
                IsEnabled="{Binding IsOwnComment}"
                Text="Edit" />
            <MenuFlyoutItem
                Command="{Binding BindingContext.DeleteCommentCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                CommandParameter="{Binding .}"
                IconImageSource="trash.png"
                IsEnabled="{Binding IsOwnComment}"
                Text="Delete" />
            <MenuFlyoutItem
                Command="{Binding BindingContext.ReplyCommentCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                CommandParameter="{Binding .}"
                IconImageSource="reply.png"
                Text="Reply" />
        </MenuFlyout>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{StaticResource Primary}" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid Margin="0,-10,0,0" RowDefinitions="Auto,*,Auto">
        <!--  Header  -->
        <Grid
            Grid.Row="0"
            Padding="15"
            BackgroundColor="{StaticResource Primary}"
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="10">
            <Border
                Grid.Column="0"
                BackgroundColor="White"
                HeightRequest="30"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="0"
                WidthRequest="30">
                <Image
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    Source="x.png"
                    VerticalOptions="Center"
                    WidthRequest="24" />
                <Border.Shadow>
                    <Shadow Brush="Gray" Radius="10" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                </Border.GestureRecognizers>
            </Border>
            <Grid Grid.Column="1" />
            <Border
                Grid.Column="2"
                BackgroundColor="White"
                HeightRequest="30"
                IsVisible="{Binding IsOwnPost}"
                StrokeShape="RoundRectangle 8"
                WidthRequest="30">
                <Image
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    Source="pencil.png"
                    VerticalOptions="Center"
                    WidthRequest="24" />
                <Border.Shadow>
                    <Shadow Brush="Gray" Radius="10" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding EditPostCommand}" />
                </Border.GestureRecognizers>
            </Border>
            <Border
                Grid.Column="3"
                BackgroundColor="White"
                HeightRequest="30"
                IsVisible="{Binding IsOwnPost}"
                StrokeShape="RoundRectangle 8"
                WidthRequest="30">
                <Image
                    HeightRequest="18"
                    HorizontalOptions="Center"
                    Source="trash.png"
                    VerticalOptions="Center"
                    WidthRequest="18" />
                <Border.Shadow>
                    <Shadow Brush="Gray" Radius="10" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding DeletePostCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!--  Content  -->
        <ScrollView Grid.Row="1">
            <Grid RowDefinitions="Auto,*">
                <!--  Post Display  -->
                <ContentView Grid.Row="0" BindingContext="{Binding Post}">
                    <ContentView.Resources>
                        <ControlTemplate x:Key="withImage">
                            <templates:PostWithImage />
                        </ControlTemplate>
                        <ControlTemplate x:Key="withOnlyImage">
                            <templates:PostWithOnlyImage />
                        </ControlTemplate>
                        <ControlTemplate x:Key="noImage">
                            <templates:PostWithNoImage />
                        </ControlTemplate>
                    </ContentView.Resources>
                    <ContentView.Triggers>
                        <DataTrigger
                            x:DataType="models:PostModel"
                            Binding="{Binding PostTemplateContentViewName}"
                            TargetType="ContentView"
                            Value="WithNoImage">
                            <Setter Property="ControlTemplate" Value="{StaticResource noImage}" />
                        </DataTrigger>
                        <DataTrigger
                            x:DataType="models:PostModel"
                            Binding="{Binding PostTemplateContentViewName}"
                            TargetType="ContentView"
                            Value="ImageOnly">
                            <Setter Property="ControlTemplate" Value="{StaticResource withOnlyImage}" />
                        </DataTrigger>
                        <DataTrigger
                            x:DataType="models:PostModel"
                            Binding="{Binding PostTemplateContentViewName}"
                            TargetType="ContentView"
                            Value="WithImage">
                            <Setter Property="ControlTemplate" Value="{StaticResource withImage}" />
                        </DataTrigger>
                    </ContentView.Triggers>
                </ContentView>

                <!--  Comments List  -->
                <VerticalStackLayout
                    Grid.Row="1"
                    Padding="10"
                    BackgroundColor="White"
                    Spacing="1">
                    <CollectionView
                        ItemsSource="{Binding Comments}"
                        RemainingItemsThreshold="1"
                        RemainingItemsThresholdReached="CollectionView_RemainingItemsThresholdReached">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label
                                FontSize="15"
                                HorizontalOptions="Center"
                                Text="No comments yet."
                                TextColor="Gray" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:CommentDto">
                                <Grid
                                    Margin="{Binding Level, Converter={StaticResource LevelToMarginConverter}}"
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="8"
                                    RowDefinitions="Auto,Auto">
                                    <!--  Avatar  -->
                                    <Border
                                        Grid.Column="0"
                                        HeightRequest="40"
                                        StrokeShape="RoundRectangle 20"
                                        VerticalOptions="Start"
                                        WidthRequest="40">
                                        <Image
                                            Aspect="AspectFill"
                                            HeightRequest="40"
                                            Source="{Binding UserPhotoUrl}"
                                            WidthRequest="40" />
                                    </Border>
                                    <!--  Comment Content  -->
                                    <Border
                                        Grid.Column="1"
                                        Padding="10,5,5,5"
                                        BackgroundColor="#F8F9FA"
                                        Stroke="#E0E0E0"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="1"
                                        VerticalOptions="Start">
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            RowDefinitions="Auto,Auto,Auto,Auto"
                                            RowSpacing="1">
                                            <!--  Username and Timestamp  -->
                                            <StackLayout
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalOptions="Start">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="15"
                                                    Text="{Binding UserName}"
                                                    TextColor="#1C2526" />
                                            </StackLayout>
                                            <!--  More Options  -->
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="4"
                                                BackgroundColor="Transparent"
                                                HeightRequest="24"
                                                IsVisible="{Binding IsOwnComment}"
                                                Text="⋮"
                                                TextColor="Black"
                                                VerticalOptions="Start">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnMoreOptionsTapped" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <!--  Content  -->
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                FontSize="15"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding Content}"
                                                TextColor="#1C2526" />
                                            <!--  Comment Image  -->
                                            <Border
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="1"
                                                IsVisible="{Binding PhotoUrl, Converter={StaticResource StringToBoolConverter}}"
                                                StrokeShape="RoundRectangle 10">
                                                <Image
                                                    Aspect="AspectFit"
                                                    HorizontalOptions="Start"
                                                    Source="{Binding PhotoUrl}" />
                                            </Border>
                                            <!--  Reply Button  -->
                                            <HorizontalStackLayout
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Spacing="10">
                                                <Label
                                                    FontSize="12"
                                                    Text="{Binding AddedOn, Converter={StaticResource HumanizedTimeConverter}}"
                                                    TextColor="#65676B"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    BackgroundColor="Transparent"
                                                    FontSize="14"
                                                    HorizontalOptions="Start"
                                                    Text="Reply"
                                                    TextColor="{StaticResource Primary}">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnReplyTapped" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                    <!--  Replies  -->
                                    <CollectionView
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="30,8,0,0"
                                        IsVisible="{Binding Replies.Count, Converter={StaticResource CountToBoolConverter}}"
                                        ItemsSource="{Binding Replies}"
                                        SelectionMode="None">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="dto:CommentDto">
                                                <Grid
                                                    Margin="{Binding Level, Converter={StaticResource LevelToMarginConverter}}"
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="8"
                                                    RowDefinitions="Auto">
                                                    <!--  Reply Avatar  -->
                                                    <Border
                                                        Grid.Column="0"
                                                        HeightRequest="32"
                                                        StrokeShape="RoundRectangle 16"
                                                        VerticalOptions="Start"
                                                        WidthRequest="32">
                                                        <Image
                                                            Aspect="AspectFill"
                                                            HeightRequest="32"
                                                            Source="{Binding UserPhotoUrl}"
                                                            WidthRequest="32" />
                                                    </Border>
                                                    <!--  Reply Content  -->
                                                    <Border
                                                        Grid.Column="1"
                                                        Padding="10"
                                                        BackgroundColor="#EDF1F4"
                                                        Stroke="#E0E0E0"
                                                        StrokeShape="RoundRectangle 10"
                                                        StrokeThickness="1"
                                                        VerticalOptions="Start">
                                                        <Grid
                                                            ColumnDefinitions="*,Auto"
                                                            RowDefinitions="Auto,Auto,Auto,Auto"
                                                            RowSpacing="4">
                                                            <!--  Username and Timestamp  -->
                                                            <StackLayout
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Orientation="Horizontal"
                                                                Spacing="5"
                                                                VerticalOptions="Start">
                                                                <Label
                                                                    FontAttributes="Bold"
                                                                    FontSize="13"
                                                                    Text="{Binding UserName}"
                                                                    TextColor="#1C2526" />
                                                            </StackLayout>
                                                            <!--  More Options  -->
                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                Padding="2"
                                                                BackgroundColor="Transparent"
                                                                HeightRequest="24"
                                                                IsVisible="{Binding IsOwnComment}"
                                                                Text="⋮"
                                                                TextColor="Black"
                                                                VerticalOptions="Start">
                                                                <Label.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnMoreOptionsTapped" />
                                                                </Label.GestureRecognizers>
                                                            </Label>
                                                            <!--  Content  -->
                                                            <Label
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="1"
                                                                FontSize="13"
                                                                LineBreakMode="WordWrap"
                                                                Text="{Binding Content}"
                                                                TextColor="#1C2526" />
                                                            <!--  Reply Image  -->
                                                            <Border
                                                                Grid.Row="2"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="1"
                                                                IsVisible="{Binding PhotoUrl, Converter={StaticResource StringToBoolConverter}}"
                                                                StrokeShape="RoundRectangle 10">
                                                                <Image
                                                                    Aspect="AspectFit"
                                                                    HorizontalOptions="Start"
                                                                    Source="{Binding PhotoUrl}" />
                                                            </Border>
                                                            <HorizontalStackLayout Grid.Row="3" Grid.Column="0">
                                                                <Label
                                                                    Padding="0,0,10,0"
                                                                    FontSize="11"
                                                                    Text="{Binding AddedOn, Converter={StaticResource HumanizedTimeConverter}}"
                                                                    TextColor="#65676B"
                                                                    VerticalOptions="Center" />
                                                                <Label
                                                                    FontSize="12"
                                                                    Text="Reply"
                                                                    TextColor="{StaticResource Primary}">
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="OnReplyTapped" />
                                                                    </Label.GestureRecognizers>
                                                                </Label>
                                                            </HorizontalStackLayout>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!--  Comment Input + Image Preview  -->
        <Grid
            Grid.Row="2"
            Padding="10,5,10,10"
            BackgroundColor="White"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="8"
            RowDefinitions="Auto,Auto,Auto">
            <!--  Reply Indicator or Edit Indicator  -->
            <HorizontalStackLayout
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Spacing="8">
                <Label
                    FontSize="14"
                    IsVisible="{Binding ReplyingToComment, Converter={StaticResource ObjectToBoolConverter}}"
                    Text="{Binding ReplyingToComment.UserName, StringFormat='Replying to {0}'}"
                    TextColor="{StaticResource Primary}"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelReplyCommand}" />
                    </Label.GestureRecognizers>
                </Label>
                <Label
                    FontSize="14"
                    IsVisible="{Binding IsEditing}"
                    Text="Editing comment"
                    TextColor="{StaticResource Primary}"
                    VerticalOptions="Center" />
                <Border
                    BackgroundColor="White"
                    HeightRequest="24"
                    IsVisible="{Binding IsEditing}"
                    Stroke="{StaticResource Gray200}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1"
                    VerticalOptions="Center"
                    WidthRequest="24">
                    <Image
                        HeightRequest="16"
                        HorizontalOptions="Center"
                        Source="x.png"
                        VerticalOptions="Center"
                        WidthRequest="16" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelEditCommand}" />
                    </Border.GestureRecognizers>
                </Border>
            </HorizontalStackLayout>
            <!--  Pick Image Button  -->
            <Border
                Grid.Row="1"
                Grid.Column="0"
                Padding="10,5"
                IsVisible="{Binding IsPhotoButtonVisible}"
                Stroke="{StaticResource Primary}"
                StrokeShape="RoundRectangle 5">
                <controls:PrimaryColorImage
                    HeightRequest="25"
                    Source="photo.png"
                    VerticalOptions="Center"
                    WidthRequest="25" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectPhotoCommand}" />
                </Border.GestureRecognizers>
            </Border>
            <!--  Comment Entry  -->
            <controls:NoBorderEntry
                Grid.Row="1"
                Grid.Column="1"
                Placeholder="Write a comment or reply..."
                Text="{Binding Comment, Mode=TwoWay}"
                TextColor="Black"
                VerticalOptions="Center">
                <controls:NoBorderEntry.Behaviors>
                    <behaviors:AutoFocusBehavior ShouldFocus="{Binding ReplyingToComment, Converter={StaticResource ObjectToBoolConverter}}" />
                </controls:NoBorderEntry.Behaviors>
            </controls:NoBorderEntry>
            <!--  Send Button  -->
            <Border
                Grid.Row="1"
                Grid.Column="2"
                BackgroundColor="{StaticResource Primary}"
                HeightRequest="40"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                StrokeShape="RoundRectangle 8"
                WidthRequest="40">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddCommentCommand}" />
                </Border.GestureRecognizers>
                <controls:WhiteImage
                    HeightRequest="20"
                    Source="send.png"
                    WidthRequest="20" />
            </Border>
            <!--  Selected Images Preview  -->
            <CollectionView
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                IsVisible="{Binding HasSelectedImages}"
                ItemsLayout="HorizontalList"
                ItemsSource="{Binding SelectedImagePreviews}"
                SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ImagePreview">
                        <Grid Margin="5,0,5,0">
                            <HorizontalStackLayout Padding="5">
                                <!--  Bọc Image trong Border để bo góc  -->
                                <Border
                                    HeightRequest="100"
                                    Stroke="LightGray"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="2"
                                    WidthRequest="80">
                                    <Image
                                        Aspect="AspectFill"
                                        HeightRequest="100"
                                        Source="{Binding Source}"
                                        WidthRequest="80" />
                                </Border>
                                <Border
                                    BackgroundColor="#CC000000"
                                    HeightRequest="30"
                                    HorizontalOptions="End"
                                    InputTransparent="False"
                                    StrokeShape="RoundRectangle 15"
                                    VerticalOptions="Start"
                                    WidthRequest="30"
                                    ZIndex="10">
                                    <Label
                                        BackgroundColor="Transparent"
                                        FontSize="16"
                                        HorizontalOptions="Center"
                                        Text="✕"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Path=BindingContext.RemovePhotoCommand, Source={RelativeSource AncestorType={x:Type ContentPage}, Mode=FindAncestor}}"
                                            CommandParameter="{Binding Id}"
                                            Tapped="OnRemovePhotoTapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <!--  Activity Indicator  -->
        <ActivityIndicator
            Grid.RowSpan="3"
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>