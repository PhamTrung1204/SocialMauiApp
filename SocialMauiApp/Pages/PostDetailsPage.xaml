<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.PostDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:models="clr-namespace:SocialMauiApp.Models"
    xmlns:templates="clr-namespace:SocialMauiApp.Templates"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    xmlns:dto="clr-namespace:SocialMediaMaui.Shared.Dtos;assembly=SocialMediaMaui.Shared"
    x:Name="PageRoot"
    x:DataType="vm:DetailsViewModel"
    BackgroundColor="{StaticResource Gray100}"
    Shell.PresentationMode="ModalAnimated">

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{StaticResource Primary}" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid Margin="0,-10,0,0" RowDefinitions="Auto,*,Auto">
        <!--  Header  -->
        <Grid
            Grid.Row="0"
            Padding="15"
            BackgroundColor="{StaticResource Primary}"
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="10">
            <!--  Close Button  -->
            <Border
                Grid.Column="0"
                BackgroundColor="White"
                HeightRequest="30"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="0"
                WidthRequest="30">
                <Image
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    Source="x.png"
                    VerticalOptions="Center"
                    WidthRequest="24" />
                <Border.Shadow>
                    <Shadow Brush="Gray" Radius="10" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                </Border.GestureRecognizers>
            </Border>

            <!--  Spacer  -->
            <Grid Grid.Column="1" />

            <!--  Edit Post Button  -->
            <Border
                Grid.Column="2"
                BackgroundColor="White"
                HeightRequest="30"
                IsVisible="{Binding IsOwnPost}"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="0"
                WidthRequest="30">
                <Image
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    Source="pencil.png"
                    VerticalOptions="Center"
                    WidthRequest="24" />
                <Border.Shadow>
                    <Shadow Brush="Gray" Radius="10" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding EditPostCommand}" />
                </Border.GestureRecognizers>
            </Border>

            <!--  Delete Post Button  -->
            <Border
                Grid.Column="3"
                BackgroundColor="White"
                HeightRequest="30"
                IsVisible="{Binding IsOwnPost}"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="0"
                WidthRequest="30">
                <Image
                    HeightRequest="18"
                    HorizontalOptions="Center"
                    Source="trash.png"
                    VerticalOptions="Center"
                    WidthRequest="18" />
                <Border.Shadow>
                    <Shadow Brush="Gray" Radius="10" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding DeletePostCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!--  Main Content  -->
        <ScrollView Grid.Row="1">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <!--  Post Display  -->
                <ContentView Grid.Row="0" BindingContext="{Binding Post}">
                    <ContentView.Resources>
                        <ControlTemplate x:Key="withImage">
                            <templates:PostWithImage />
                        </ControlTemplate>
                        <ControlTemplate x:Key="withOnlyImage">
                            <templates:PostWithOnlyImage />
                        </ControlTemplate>
                        <ControlTemplate x:Key="noImage">
                            <templates:PostWithNoImage />
                        </ControlTemplate>
                    </ContentView.Resources>
                    <ContentView.Triggers>
                        <DataTrigger
                            x:DataType="models:PostModel"
                            Binding="{Binding PostTemplateContentViewName}"
                            TargetType="ContentView"
                            Value="WithNoImage">
                            <Setter Property="ControlTemplate" Value="{StaticResource noImage}" />
                        </DataTrigger>
                        <DataTrigger
                            x:DataType="models:PostModel"
                            Binding="{Binding PostTemplateContentViewName}"
                            TargetType="ContentView"
                            Value="ImageOnly">
                            <Setter Property="ControlTemplate" Value="{StaticResource withOnlyImage}" />
                        </DataTrigger>
                        <DataTrigger
                            x:DataType="models:PostModel"
                            Binding="{Binding PostTemplateContentViewName}"
                            TargetType="ContentView"
                            Value="WithImage">
                            <Setter Property="ControlTemplate" Value="{StaticResource withImage}" />
                        </DataTrigger>
                    </ContentView.Triggers>
                </ContentView>

                <!--  Comments Section  -->
                <VerticalStackLayout
                    Grid.Row="1"
                    Padding="5"
                    Spacing="10">
                    <CollectionView
                        ItemsSource="{Binding Comments}"
                        RemainingItemsThreshold="1"
                        RemainingItemsThresholdReached="CollectionView_RemainingItemsThresholdReached">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label HorizontalOptions="Center" Text="No comments here." />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:CommentDto">
                                <Border
                                    Padding="5"
                                    BackgroundColor="White"
                                    StrokeShape="RoundRectangle 10">
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto">
                                        <!--  Avatar  -->
                                        <Border
                                            Grid.Column="0"
                                            HeightRequest="40"
                                            StrokeShape="RoundRectangle 20"
                                            VerticalOptions="Start"
                                            WidthRequest="40">
                                            <Image
                                                Aspect="AspectFill"
                                                HeightRequest="40"
                                                Source="{Binding UserPhoto}"
                                                WidthRequest="40" />
                                        </Border>

                                        <!--  Comment Content and Actions  -->
                                        <Grid
                                            Grid.Column="1"
                                            Padding="5,0,0,0"
                                            RowDefinitions="Auto,*"
                                            RowSpacing="3">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <!--  User Info  -->
                                                <StackLayout
                                                    Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    Spacing="2">
                                                    <Label
                                                        FontAttributes="Bold"
                                                        FontSize="14"
                                                        Text="{Binding UserName}"
                                                        TextColor="Black" />
                                                    <Label FontSize="14" Text="·" />
                                                    <Label
                                                        FontSize="12"
                                                        Text="{Binding AddedOn, StringFormat='{0:hh:mm tt | dd MMM yyyy}'}"
                                                        TextColor="Gray" />
                                                </StackLayout>

                                                <!--  Edit and Delete buttons (hiển thị khi comment thuộc về user hiện tại)  -->
                                                <StackLayout
                                                    Grid.Column="1"
                                                    HorizontalOptions="End"
                                                    IsVisible="{Binding IsOwnComment}"
                                                    Orientation="Horizontal"
                                                    Spacing="10">
                                                    <Image
                                                        HeightRequest="16"
                                                        Source="pencil.png"
                                                        WidthRequest="16">
                                                        <Image.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditCommentCommand}" CommandParameter="{Binding .}" />
                                                        </Image.GestureRecognizers>
                                                    </Image>
                                                    <Image
                                                        HeightRequest="16"
                                                        Source="trash.png"
                                                        WidthRequest="16">
                                                        <Image.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteCommentCommand}" CommandParameter="{Binding .}" />
                                                        </Image.GestureRecognizers>
                                                    </Image>
                                                </StackLayout>
                                            </Grid>
                                            <!--  Comment Text  -->
                                            <Label
                                                Grid.Row="1"
                                                FontSize="14"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding Content}"
                                                TextColor="Black" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!--  Comment Input Box  -->
        <Grid
            Grid.Row="2"
            Padding="15,10,15,15"
            BackgroundColor="White"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="10">
            <!--  Editing Indicator  -->
            <StackLayout
                Grid.ColumnSpan="2"
                Margin="0,-20,0,0"
                HorizontalOptions="Start"
                IsVisible="{Binding IsEditing}"
                Orientation="Horizontal"
                Spacing="5">
                <Label
                    FontSize="12"
                    Text="Editing comment..."
                    TextColor="{StaticResource Primary}"
                    VerticalOptions="Center" />
                <ImageButton
                    BackgroundColor="Transparent"
                    Command="{Binding CancelEditCommand}"
                    HeightRequest="16"
                    Source="x.png"
                    WidthRequest="16" />
            </StackLayout>

            <!--  Input Field  -->
            <controls:NoBorderEntry
                Grid.Column="0"
                Placeholder="Enter comment..."
                PlaceholderColor="Black"
                Text="{Binding Comment}"
                TextColor="Black" />

            <!--  Send/Update Button  -->
            <Border
                Grid.Column="1"
                BackgroundColor="{StaticResource Primary}"
                HeightRequest="44"
                StrokeShape="RoundRectangle 8"
                WidthRequest="44">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddCommentCommand}" />
                </Border.GestureRecognizers>
                <controls:WhiteImage
                    HeightRequest="24"
                    Source="send.png"
                    WidthRequest="24" />
            </Border>
        </Grid>

        <!--  Activity Indicator  -->
        <ActivityIndicator
            Grid.RowSpan="3"
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>
