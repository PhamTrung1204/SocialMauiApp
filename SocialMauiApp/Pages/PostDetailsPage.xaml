<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.PostDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:SocialMauiApp.Behaviors"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:converters="clr-namespace:SocialMauiApp.Converters"
    xmlns:dto="clr-namespace:SocialMediaMaui.Shared.Dtos;assembly=SocialMediaMaui.Shared"
    xmlns:models="clr-namespace:SocialMauiApp.Models"
    xmlns:templates="clr-namespace:SocialMauiApp.Templates"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    x:DataType="vm:DetailsViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
    Shell.PresentationMode="ModalAnimated">

    <ContentPage.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
        <converters:LevelToMarginConverter x:Key="LevelToMarginConverter" />
        <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
        <converters:ObjectToBoolConverter x:Key="ObjectToBoolConverter" />
        <MenuFlyout x:Key="CommentOptionsMenu" x:DataType="dto:CommentDto">
            <MenuFlyoutItem
                Command="{Binding BindingContext.EditAndUpdateCommentCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                CommandParameter="{Binding .}"
                IconImageSource="pencil.png"
                IsEnabled="{Binding IsOwnComment}"
                Text="Edit" />
            <MenuFlyoutItem
                Command="{Binding BindingContext.DeleteCommentCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                CommandParameter="{Binding .}"
                IconImageSource="trash.png"
                IsEnabled="{Binding IsOwnComment}"
                Text="Delete" />
            <MenuFlyoutItem
                Command="{Binding BindingContext.ReplyCommentCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                CommandParameter="{Binding .}"
                IconImageSource="reply.png"
                Text="Reply" />
        </MenuFlyout>

        <Style x:Key="HeaderIconStyle" TargetType="Border">
            <Setter Property="Padding" Value="0" />
            <Setter Property="BackgroundColor" Value="#26FFFFFF" />
            <Setter Property="HeightRequest" Value="38" />
            <Setter Property="WidthRequest" Value="38" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 19" />
        </Style>
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <toolkit:StatusBarBehavior StatusBarColor="{StaticResource Primary}" StatusBarStyle="LightContent" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto">

        <!--  Header  -->
        <Border
            Grid.Row="0"
            Padding="14,14"
            StrokeShape="RoundRectangle 0,0,22,22"
            StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0.0" Color="{StaticResource Primary}" />
                    <GradientStop Offset="1.0" Color="{StaticResource PrimaryDark}" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource HeaderIconStyle}">
                    <controls:WhiteImage
                        HeightRequest="18"
                        HorizontalOptions="Center"
                        Source="x.png"
                        VerticalOptions="Center"
                        WidthRequest="18" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                    </Border.GestureRecognizers>
                </Border>

                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Post"
                    TextColor="White"
                    VerticalOptions="Center" />

                <Border
                    Grid.Column="2"
                    IsVisible="{Binding IsOwnPost}"
                    Style="{StaticResource HeaderIconStyle}">
                    <controls:WhiteImage
                        HeightRequest="18"
                        HorizontalOptions="Center"
                        Source="pencil.png"
                        VerticalOptions="Center"
                        WidthRequest="18" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding EditPostCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <Border
                    Grid.Column="3"
                    IsVisible="{Binding IsOwnPost}"
                    Style="{StaticResource HeaderIconStyle}">
                    <controls:WhiteImage
                        HeightRequest="17"
                        HorizontalOptions="Center"
                        Source="trash.png"
                        VerticalOptions="Center"
                        WidthRequest="17" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DeletePostCommand}" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>
        </Border>

        <!--  Content  -->
        <ScrollView Grid.Row="1">
            <Grid RowDefinitions="Auto,*">
                <ContentView Grid.Row="0" BindingContext="{Binding Post}">
                    <ContentView.Resources>
                        <ControlTemplate x:Key="withImage">
                            <templates:PostWithImage />
                        </ControlTemplate>
                        <ControlTemplate x:Key="withOnlyImage">
                            <templates:PostWithOnlyImage />
                        </ControlTemplate>
                        <ControlTemplate x:Key="noImage">
                            <templates:PostWithNoImage />
                        </ControlTemplate>
                    </ContentView.Resources>
                    <ContentView.Triggers>
                        <DataTrigger
                            x:DataType="models:PostModel"
                            Binding="{Binding PostTemplateContentViewName}"
                            TargetType="ContentView"
                            Value="WithNoImage">
                            <Setter Property="ControlTemplate" Value="{StaticResource noImage}" />
                        </DataTrigger>
                        <DataTrigger
                            x:DataType="models:PostModel"
                            Binding="{Binding PostTemplateContentViewName}"
                            TargetType="ContentView"
                            Value="ImageOnly">
                            <Setter Property="ControlTemplate" Value="{StaticResource withOnlyImage}" />
                        </DataTrigger>
                        <DataTrigger
                            x:DataType="models:PostModel"
                            Binding="{Binding PostTemplateContentViewName}"
                            TargetType="ContentView"
                            Value="WithImage">
                            <Setter Property="ControlTemplate" Value="{StaticResource withImage}" />
                        </DataTrigger>
                    </ContentView.Triggers>
                </ContentView>

                <VerticalStackLayout Grid.Row="1" Padding="0,6,0,14" Spacing="10">
                    <Label
                        Margin="18,0"
                        Style="{StaticResource SectionTitleStyle}"
                        Text="Comments" />
                    <CollectionView
                        ItemsSource="{Binding Comments}"
                        RemainingItemsThreshold="1"
                        RemainingItemsThresholdReached="CollectionView_RemainingItemsThresholdReached">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label Style="{StaticResource EmptyStateStyle}" Text="No comments yet." />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:CommentDto">
                                <Grid
                                    Margin="{Binding Level, Converter={StaticResource LevelToMarginConverter}}"
                                    ColumnDefinitions="Auto,*"
                                    ColumnSpacing="10"
                                    RowDefinitions="Auto,Auto">
                                    <Border
                                        Grid.Column="0"
                                        Margin="14,0,0,0"
                                        Padding="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource DarkSurfaceAlt}}"
                                        HeightRequest="36"
                                        StrokeShape="RoundRectangle 18"
                                        StrokeThickness="0"
                                        VerticalOptions="Start"
                                        WidthRequest="36">
                                        <Image
                                            Aspect="AspectFill"
                                            HeightRequest="36"
                                            Source="{Binding UserPhotoUrl}"
                                            WidthRequest="36" />
                                    </Border>
                                    <Border
                                        Grid.Column="1"
                                        Margin="0,0,14,0"
                                        Padding="12,10"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"
                                        StrokeShape="RoundRectangle 14"
                                        StrokeThickness="0"
                                        VerticalOptions="Start">
                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            RowDefinitions="Auto,Auto,Auto,Auto"
                                            RowSpacing="4">
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                Text="{Binding UserName}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Padding="6,0"
                                                BackgroundColor="Transparent"
                                                FontSize="16"
                                                IsVisible="{Binding IsOwnComment}"
                                                Text="⋯"
                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                                VerticalOptions="Start">
                                                <Label.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnMoreOptionsTapped" />
                                                </Label.GestureRecognizers>
                                            </Label>
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                FontSize="14"
                                                LineBreakMode="WordWrap"
                                                LineHeight="1.3"
                                                Text="{Binding Content}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                            <Border
                                                Grid.Row="2"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Margin="0,4,0,0"
                                                Padding="0"
                                                HorizontalOptions="Start"
                                                IsVisible="{Binding PhotoUrl, Converter={StaticResource StringToBoolConverter}}"
                                                StrokeShape="RoundRectangle 12"
                                                StrokeThickness="0">
                                                <Image
                                                    Aspect="AspectFit"
                                                    HorizontalOptions="Start"
                                                    Source="{Binding PhotoUrl}" />
                                            </Border>
                                            <HorizontalStackLayout
                                                Grid.Row="3"
                                                Grid.Column="0"
                                                Spacing="12">
                                                <Label
                                                    FontSize="12"
                                                    Text="{Binding AddedOn, Converter={StaticResource HumanizedTimeConverter}}"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    BackgroundColor="Transparent"
                                                    FontAttributes="Bold"
                                                    FontSize="12"
                                                    HorizontalOptions="Start"
                                                    Text="Reply"
                                                    TextColor="{StaticResource Primary}">
                                                    <Label.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnReplyTapped" />
                                                    </Label.GestureRecognizers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                    <CollectionView
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Margin="34,8,0,0"
                                        IsVisible="{Binding Replies.Count, Converter={StaticResource CountToBoolConverter}}"
                                        ItemsSource="{Binding Replies}"
                                        SelectionMode="None">
                                        <CollectionView.ItemsLayout>
                                            <LinearItemsLayout ItemSpacing="8" Orientation="Vertical" />
                                        </CollectionView.ItemsLayout>
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate x:DataType="dto:CommentDto">
                                                <Grid
                                                    Margin="{Binding Level, Converter={StaticResource LevelToMarginConverter}}"
                                                    ColumnDefinitions="Auto,*"
                                                    ColumnSpacing="10"
                                                    RowDefinitions="Auto">
                                                    <Border
                                                        Grid.Column="0"
                                                        Padding="0"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource DarkSurfaceAlt}}"
                                                        HeightRequest="30"
                                                        StrokeShape="RoundRectangle 15"
                                                        StrokeThickness="0"
                                                        VerticalOptions="Start"
                                                        WidthRequest="30">
                                                        <Image
                                                            Aspect="AspectFill"
                                                            HeightRequest="30"
                                                            Source="{Binding UserPhotoUrl}"
                                                            WidthRequest="30" />
                                                    </Border>
                                                    <Border
                                                        Grid.Column="1"
                                                        Margin="0,0,14,0"
                                                        Padding="12,10"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"
                                                        StrokeShape="RoundRectangle 12"
                                                        StrokeThickness="0"
                                                        VerticalOptions="Start">
                                                        <Grid
                                                            ColumnDefinitions="*,Auto"
                                                            RowDefinitions="Auto,Auto,Auto,Auto"
                                                            RowSpacing="4">
                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                FontAttributes="Bold"
                                                                FontSize="13"
                                                                Text="{Binding UserName}"
                                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                Padding="6,0"
                                                                BackgroundColor="Transparent"
                                                                FontSize="15"
                                                                IsVisible="{Binding IsOwnComment}"
                                                                Text="⋯"
                                                                TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                                                VerticalOptions="Start">
                                                                <Label.GestureRecognizers>
                                                                    <TapGestureRecognizer Tapped="OnMoreOptionsTapped" />
                                                                </Label.GestureRecognizers>
                                                            </Label>
                                                            <Label
                                                                Grid.Row="1"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="2"
                                                                FontSize="13"
                                                                LineBreakMode="WordWrap"
                                                                LineHeight="1.3"
                                                                Text="{Binding Content}"
                                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                                            <Border
                                                                Grid.Row="2"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="2"
                                                                Margin="0,4,0,0"
                                                                Padding="0"
                                                                HorizontalOptions="Start"
                                                                IsVisible="{Binding PhotoUrl, Converter={StaticResource StringToBoolConverter}}"
                                                                StrokeShape="RoundRectangle 10"
                                                                StrokeThickness="0">
                                                                <Image
                                                                    Aspect="AspectFit"
                                                                    HorizontalOptions="Start"
                                                                    Source="{Binding PhotoUrl}" />
                                                            </Border>
                                                            <HorizontalStackLayout
                                                                Grid.Row="3"
                                                                Grid.Column="0"
                                                                Spacing="12">
                                                                <Label
                                                                    FontSize="11"
                                                                    Text="{Binding AddedOn, Converter={StaticResource HumanizedTimeConverter}}"
                                                                    TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                                                    VerticalOptions="Center" />
                                                                <Label
                                                                    FontAttributes="Bold"
                                                                    FontSize="12"
                                                                    Text="Reply"
                                                                    TextColor="{StaticResource Primary}">
                                                                    <Label.GestureRecognizers>
                                                                        <TapGestureRecognizer Tapped="OnReplyTapped" />
                                                                    </Label.GestureRecognizers>
                                                                </Label>
                                                            </HorizontalStackLayout>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!--  Composer  -->
        <Border
            Grid.Row="2"
            Padding="14,10,14,14"
            BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"
            Shadow="{StaticResource ShadowMd}"
            StrokeShape="RoundRectangle 22,22,0,0"
            StrokeThickness="0">
            <Grid
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="8"
                RowDefinitions="Auto,Auto,Auto"
                RowSpacing="8">
                <HorizontalStackLayout
                    Grid.Row="0"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Spacing="8">
                    <Label
                        FontSize="13"
                        IsVisible="{Binding ReplyingToComment, Converter={StaticResource ObjectToBoolConverter}}"
                        Text="{Binding ReplyingToComment.UserName, StringFormat='Replying to {0}'}"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CancelReplyCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label
                        FontSize="13"
                        IsVisible="{Binding IsEditing}"
                        Text="Editing comment"
                        TextColor="{StaticResource Primary}"
                        VerticalOptions="Center" />
                    <Border
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource LightSurfaceAlt}, Dark={StaticResource DarkSurfaceAlt}}"
                        HeightRequest="24"
                        IsVisible="{Binding IsEditing}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="24">
                        <Image
                            HeightRequest="14"
                            HorizontalOptions="Center"
                            Source="x.png"
                            VerticalOptions="Center"
                            WidthRequest="14" />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CancelEditCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSurfaceAlt}, Dark={StaticResource DarkSurfaceAlt}}"
                    HeightRequest="42"
                    IsVisible="{Binding IsPhotoButtonVisible}"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="0"
                    WidthRequest="42">
                    <controls:PrimaryColorImage
                        HeightRequest="20"
                        HorizontalOptions="Center"
                        Source="photo.png"
                        VerticalOptions="Center"
                        WidthRequest="20" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPhotoCommand}" />
                    </Border.GestureRecognizers>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Padding="16,0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSurfaceAlt}, Dark={StaticResource DarkSurfaceAlt}}"
                    HeightRequest="42"
                    StrokeShape="RoundRectangle 21"
                    StrokeThickness="0">
                    <controls:NoBorderEntry
                        Placeholder="Write a comment or reply..."
                        Text="{Binding Comment, Mode=TwoWay}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                        VerticalOptions="Center">
                        <controls:NoBorderEntry.Behaviors>
                            <behaviors:AutoFocusBehavior ShouldFocus="{Binding ReplyingToComment, Converter={StaticResource ObjectToBoolConverter}}" />
                        </controls:NoBorderEntry.Behaviors>
                    </controls:NoBorderEntry>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="2"
                    Padding="0"
                    BackgroundColor="{StaticResource Primary}"
                    HeightRequest="42"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                    StrokeShape="RoundRectangle 21"
                    StrokeThickness="0"
                    WidthRequest="42">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddCommentCommand}" />
                    </Border.GestureRecognizers>
                    <controls:WhiteImage
                        HeightRequest="18"
                        HorizontalOptions="Center"
                        Source="send.png"
                        VerticalOptions="Center"
                        WidthRequest="18" />
                </Border>

                <CollectionView
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    IsVisible="{Binding HasSelectedImages}"
                    ItemsLayout="HorizontalList"
                    ItemsSource="{Binding SelectedImagePreviews}"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ImagePreview">
                            <Grid Margin="0,0,10,0">
                                <Border
                                    Padding="0"
                                    HeightRequest="100"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0"
                                    WidthRequest="80">
                                    <Image
                                        Aspect="AspectFill"
                                        HeightRequest="100"
                                        Source="{Binding Source}"
                                        WidthRequest="80" />
                                </Border>
                                <Border
                                    Padding="0"
                                    BackgroundColor="#CC000000"
                                    HeightRequest="26"
                                    HorizontalOptions="End"
                                    InputTransparent="False"
                                    StrokeShape="RoundRectangle 13"
                                    StrokeThickness="0"
                                    VerticalOptions="Start"
                                    WidthRequest="26"
                                    ZIndex="10">
                                    <Label
                                        BackgroundColor="Transparent"
                                        FontSize="14"
                                        HorizontalOptions="Center"
                                        Text="✕"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Path=BindingContext.RemovePhotoCommand, Source={RelativeSource AncestorType={x:Type ContentPage}, Mode=FindAncestor}}"
                                            CommandParameter="{Binding Id}"
                                            Tapped="OnRemovePhotoTapped" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <ActivityIndicator
            Grid.RowSpan="3"
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>
