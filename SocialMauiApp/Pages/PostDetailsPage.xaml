<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.PostDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:dto="clr-namespace:SocialMediaMaui.Shared.Dtos;assembly=SocialMediaMaui.Shared"
    xmlns:models="clr-namespace:SocialMauiApp.Models"
    xmlns:templates="clr-namespace:SocialMauiApp.Templates"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    x:DataType="vm:DetailsViewModel"
    BackgroundColor="{StaticResource Gray100}"
    Shell.PresentationMode="ModalAnimated">

    <Grid RowDefinitions="Auto,*,Auto">
        <!--  Header  -->
        <Grid
            Grid.Row="0"
            Padding="15"
            BackgroundColor="{StaticResource Primary}"
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="10">
            <!--  Close Button  -->
            <Border
                Grid.Column="0"
                BackgroundColor="White"
                HeightRequest="30"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="0"
                WidthRequest="30">
                <Image
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    Source="x.png"
                    VerticalOptions="Center"
                    WidthRequest="24" />
                <Border.Shadow>
                    <Shadow Brush="Gray" Radius="10" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                </Border.GestureRecognizers>
            </Border>

            <!--  Spacer  -->
            <Grid Grid.Column="1" />

            <!--  Edit Button (hiển thị nếu IsOwnPost = true)  -->
            <Border
                Grid.Column="2"
                BackgroundColor="White"
                HeightRequest="30"
                IsVisible="{Binding IsOwnPost}"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="0"
                WidthRequest="30">
                <Image
                    HeightRequest="24"
                    HorizontalOptions="Center"
                    Source="pencil.png"
                    VerticalOptions="Center"
                    WidthRequest="24" />
                <Border.Shadow>
                    <Shadow Brush="Gray" Radius="10" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding EditPostCommand}" CommandParameter="{Binding Post}" />
                </Border.GestureRecognizers>
            </Border>

            <!--  Delete Button (hiển thị nếu IsOwnPost = true)  -->
            <Border
                Grid.Column="3"
                BackgroundColor="White"
                HeightRequest="30"
                IsVisible="{Binding IsOwnPost}"
                StrokeShape="RoundRectangle 8"
                StrokeThickness="0"
                WidthRequest="30">
                <Image
                    HeightRequest="18"
                    HorizontalOptions="Center"
                    Source="trash.png"
                    VerticalOptions="Center"
                    WidthRequest="18" />
                <Border.Shadow>
                    <Shadow Brush="Gray" Radius="10" />
                </Border.Shadow>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding DeletePostCommand}" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>

        <!--  Nội dung chính  -->
        <ScrollView Grid.Row="1">
            <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <!--  ControlTemplate hiển thị bài viết  -->
                <ContentView Grid.Row="0" BindingContext="{Binding Post}">
                    <ContentView.Resources>
                        <ControlTemplate x:Key="withImage">
                            <templates:PostWithImage />
                        </ControlTemplate>
                        <ControlTemplate x:Key="withOnlyImage">
                            <templates:PostWithOnlyImage />
                        </ControlTemplate>
                        <ControlTemplate x:Key="noImage">
                            <templates:PostWithNoImage />
                        </ControlTemplate>
                    </ContentView.Resources>
                    <ContentView.Triggers>
                        <DataTrigger
                            x:DataType="models:PostModel"
                            Binding="{Binding PostTemplateContentViewName}"
                            TargetType="ContentView"
                            Value="WithNoImage">
                            <Setter Property="ControlTemplate" Value="{StaticResource noImage}" />
                        </DataTrigger>
                        <DataTrigger
                            x:DataType="models:PostModel"
                            Binding="{Binding PostTemplateContentViewName}"
                            TargetType="ContentView"
                            Value="ImageOnly">
                            <Setter Property="ControlTemplate" Value="{StaticResource withOnlyImage}" />
                        </DataTrigger>
                        <DataTrigger
                            x:DataType="models:PostModel"
                            Binding="{Binding PostTemplateContentViewName}"
                            TargetType="ContentView"
                            Value="WithImage">
                            <Setter Property="ControlTemplate" Value="{StaticResource withImage}" />
                        </DataTrigger>
                    </ContentView.Triggers>
                </ContentView>

                <!--  Phần bình luận  -->
                <VerticalStackLayout Grid.Row="1" Spacing="10" Padding="5">
                    <CollectionView ItemsSource="{Binding Comments}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.EmptyView>
                            <Label HorizontalOptions="Center" Text="No comments here." />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:CommentDto">
                                <!--  Border để bo góc, có nền trắng, tạo cảm giác tách biệt giữa các comment  -->
                                <Border
                                    
                                    Padding="5"
                                    BackgroundColor="White"
                                    StrokeShape="RoundRectangle 10">
                                    <!--  Grid 2 hàng, 2 cột  -->
                                    <Grid
                                        ColumnDefinitions="Auto,*"
                                        ColumnSpacing="10"
                                        RowDefinitions="Auto,Auto"
                                        RowSpacing="5">

                                        <!--  Ảnh đại diện (avatar)  -->
                                        <!--  Gán RowSpan="2" để avatar trải dài 2 hàng (thông tin user + nội dung comment)  -->
                                        <Border
                                            Grid.RowSpan="2"
                                            HeightRequest="40"
                                            HorizontalOptions="Start"
                                            StrokeShape="RoundRectangle 20"
                                            VerticalOptions="Start"
                                            WidthRequest="40">
                                            <Image
                                                Aspect="AspectFill"
                                                HeightRequest="40"
                                                Source="{Binding UserPhoto}"
                                                WidthRequest="40" />
                                        </Border>

                                        <!--  Hàng 0, Cột 1: Thông tin người dùng (tên + thời gian)  -->
                                        <StackLayout
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="2">
                                            <Label
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                Text="{Binding UserName}"
                                                VerticalOptions="Center" />
                                            <Label
                                                FontSize="14"
                                                Text="·"
                                                VerticalOptions="Center" />
                                            <Label
                                                FontSize="12"
                                                Text="{Binding AddedOn, StringFormat='{0:hh:mm tt | dd MMM yyyy}'}"
                                                TextColor="Gray"
                                                VerticalOptions="Center" />
                                        </StackLayout>

                                        <!--  Hàng 1, Cột 1: Nội dung bình luận  -->
                                        <Label
                                            
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            FontSize="14"
                                            LineBreakMode="WordWrap"
                                            Text="{Binding Content}"
                                            TextColor="Black"
                                            VerticalOptions="Start" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </Grid>
        </ScrollView>

        <!--  Khung nhập bình luận  -->
        <Grid
            Grid.Row="2"
            Padding="15,10,15,15"
            BackgroundColor="White"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="10">
            <controls:NoBorderEntry
                Grid.Column="0"
                Placeholder="Enter comment..."
                PlaceholderColor="Black"
                Text="{Binding Comment}" />
            <Border
                Grid.Column="1"
                BackgroundColor="{StaticResource Primary}"
                HeightRequest="44"
                StrokeShape="RoundRectangle 8"
                WidthRequest="44">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddCommentCommand}" />
                </Border.GestureRecognizers>
                <controls:WhiteImage
                    HeightRequest="24"
                    Source="send.png"
                    WidthRequest="24" />
            </Border>
        </Grid>

        <!--  Activity Indicator  -->
        <ActivityIndicator
            Grid.Row="3"
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            VerticalOptions="Center" />
    </Grid>
</ContentPage>
