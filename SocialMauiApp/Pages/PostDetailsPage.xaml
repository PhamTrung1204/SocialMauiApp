                <!--  Mục bình luận  -->
                <VerticalStackLayout x:Name="comments" Spacing="10" Grid.Row="1" Padding="15,0,15,15">
                    <CollectionView ItemsSource="{Binding Comments}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout ItemSpacing="10" Orientation="Vertical"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="dto:CommentDto">
                                <!--  Mẫu bình luận; có thể chuyển sang CollectionView để hiển thị danh sách động  -->
                                <Grid
                                    Padding="8,0"
                                    ColumnDefinitions="40,*"
                                    ColumnSpacing="5">
                                    <Border
                                        HeightRequest="40"
                                        StrokeShape="RoundRectangle 20"
                                        VerticalOptions="Start"
                                        WidthRequest="40">
                                        <Image
                                            Aspect="AspectFit"
                                            BackgroundColor="LightGoldenrodYellow"
                                            HeightRequest="30"
                                            HorizontalOptions="Center"
                                            Source="{Binding UserPhotoUrl}"
                                            VerticalOptions="Center"
                                            WidthRequest="30" />
                                    </Border>
                                    <Grid
                                        Padding="5"
                                        BackgroundColor="White"
                                        RowDefinitions="Auto,Auto"
                                        RowSpacing="5">
                                        <Grid
                                            ColumnDefinitions="Auto,Auto,Auto"
                                            ColumnSpacing="5"
                                            VerticalOptions="Center">
                                            <Label FontAttributes="Bold" Text="{Binding UserName}" />
                                            <Label
                                                Margin="0,-7,0,0"
                                                FontAttributes="Bold"
                                                FontSize="14"
                                                Text="."
                                                VerticalOptions="Center" />
                                            <Label
                                                FontSize="12"
                                                Text="{Binding AddOn, StringFormat='{0: hh:mm dd MMM yyyy'}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                        <Label Text="Comment text" TextColor="Gray" />
                                    </Grid>
                                </Grid>
                                <!--  Thêm các bình luận khác tương tự hoặc dùng CollectionView  -->
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>


                </VerticalStackLayout>
            </Grid>
        </ScrollView>

        <!--  Khung nhập bình luận  -->
        <Grid
            Grid.Row="2"
            Padding="15,10,15,15"
            BackgroundColor="White"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="10">
            <controls:NoBorderEntry
                Grid.Column="0"
                Placeholder="Enter comment..."
                PlaceholderColor="Black"
                Text="{Binding Comment}" />
            <Border
                Grid.Column="1"
                BackgroundColor="{StaticResource Primary}"
                HeightRequest="44"
                StrokeShape="RoundRectangle 8"
                WidthRequest="44">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AddCommentCommand}" />
                </Border.GestureRecognizers>
                <controls:WhiteImage
                    HeightRequest="24"
                    Source="send.png"
                    WidthRequest="24" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>
