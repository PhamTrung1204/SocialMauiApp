<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.LoginWithFingerprintPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    Title="Welcome Back"
    x:DataType="vm:LoginWithFingerprintViewModel"
    BackgroundColor="{StaticResource Primary}">

   
    <VerticalStackLayout
      Padding="30"
      Spacing="20"
      VerticalOptions="Center"
      HorizontalOptions="Center">

        <!-- Avatar tròn bằng Border -->
        <Border
        WidthRequest="120"
        HeightRequest="120"
       
        StrokeThickness="0"
        BackgroundColor="White"
       
        HorizontalOptions="Center">
            <Image
          Source="{Binding AvatarUrl}"
          Aspect="AspectFill"
          WidthRequest="120"
          HeightRequest="120" />
        </Border>

        <!-- Welcome text -->
        <Label
        Text="{Binding GreetingText}"
        FontSize="24"
        FontAttributes="Bold"
        TextColor="White"
        HorizontalOptions="Center" />

        <!-- Password + fingerprint -->
        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
            <Entry
          IsPassword="True"
          Placeholder="Enter your password"
          Text="{Binding Password}"
          BackgroundColor="White"
          HeightRequest="45"
          HorizontalOptions="FillAndExpand" />
            <ImageButton
          Grid.Column="1"
          Source="fingerprint.png"
          IsVisible="{Binding IsBiometricAvailable}"
          Command="{Binding LoginWithFingerprintCommand}"
          Margin="10,0,0,0"
          WidthRequest="45"
          HeightRequest="45"
          BackgroundColor="White" />
        </Grid>

        <!-- Buttons -->
        <Button
        Text="Login"
        Command="{Binding LoginWithPasswordCommand}"
        BackgroundColor="White"
        TextColor="{StaticResource Primary}"
        CornerRadius="8"
        HeightRequest="45" />

        <Button
        Text="Login with another account"
        Command="{Binding LoginWithAnotherCommand}"
        BackgroundColor="Transparent"
        TextColor="White"
        BorderWidth="1"
        BorderColor="White"
        CornerRadius="8"
        HeightRequest="45" />
    </VerticalStackLayout>
</ContentPage>
