<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SocialMauiApp.Pages.CropPhotoPage"
             xmlns:imageEditor="clr-namespace:Syncfusion.Maui.ImageEditor;assembly=Syncfusion.Maui.ImageEditor"
             Title="CropPhotoPage"
           
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="*, Auto">
        <imageEditor:SfImageEditor
            x:Name="imageEditor"
            Grid.Row="0"
            ShowToolbar="False"/>
        <Grid Grid.Row="1" ColumnDefinitions="Auto, 0, Auto">
            <Button Grid.Column="0" Text="Cancel" Clicked="Cancel_Clicked"/>
            <Button Grid.Column="2" Text="Accept" Clicked="AcceptChanges_Clicked"/>
        </Grid>
    </Grid>
</ContentPage>