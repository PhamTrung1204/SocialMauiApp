<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ImageEditor;assembly=Syncfusion.Maui.ImageEditor"
             x:Class="SocialMauiApp.Pages.CropPhotoPage"
             Title="Crop Photo">

    <Grid RowDefinitions="*, Auto">
        <!-- Image Editor Control -->
        <syncfusion:SfImageEditor x:Name="PhotoEditor" 
                                 Grid.Row="0"
                                 ShowToolbar="True"
                                >
        </syncfusion:SfImageEditor>

        <!-- Button for applying crop and updating avatar -->
        <Button Grid.Row="1"
                Text="Update Avatar"
                Margin="20"
                BackgroundColor="#512BD4"
                TextColor="White"
                Clicked="OnCropPhotoClicked"/>

        <!-- Optional: You can add a loading indicator here -->
        <!-- <ActivityIndicator x:Name="loadingIndicator" IsVisible="False" IsRunning="{Binding IsVisible}" Grid.RowSpan="2" HorizontalOptions="Center" VerticalOptions="Center"/> -->
    </Grid>

</ContentPage>