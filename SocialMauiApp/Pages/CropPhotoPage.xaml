<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ImageEditor;assembly=Syncfusion.Maui.ImageEditor"
             x:Class="SocialMauiApp.Pages.CropPhotoPage"
             Title="Crop Photo"
             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
             Shell.BackgroundColor="{StaticResource Primary}"
             Shell.TitleColor="White">

    <Grid RowDefinitions="*, Auto">
        <Border Grid.Row="0"
                Margin="14,14,14,0"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="0">
            <syncfusion:SfImageEditor x:Name="PhotoEditor" ShowToolbar="True" />
        </Border>

        <Button Grid.Row="1"
                Margin="14,14"
                Clicked="OnCropPhotoClicked"
                Text="Update Avatar" />
    </Grid>
</ContentPage>
