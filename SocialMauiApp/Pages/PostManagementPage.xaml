<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.PostManagementPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:SocialMauiApp.Behaviors"
    Title="Post Management"
    BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
    <Grid RowDefinitions="Auto, *, *">

        <ActivityIndicator
            Grid.RowSpan="3"
            HeightRequest="46"
            HorizontalOptions="Center"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            VerticalOptions="Center"
            WidthRequest="46" />

        <!--  Header with stat tiles  -->
        <Border
            Grid.Row="0"
            Padding="20,22"
            StrokeShape="RoundRectangle 0,0,24,24"
            StrokeThickness="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Offset="0.0" Color="{StaticResource Primary}" />
                    <GradientStop Offset="1.0" Color="{StaticResource PrimaryDarker}" />
                </LinearGradientBrush>
            </Border.Background>
            <VerticalStackLayout Spacing="18">
                <Label
                    FontAttributes="Bold"
                    FontSize="26"
                    HorizontalOptions="Center"
                    Text="Admin Dashboard"
                    TextColor="White" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border
                        Grid.Column="0"
                        Padding="14,12"
                        BackgroundColor="#26FFFFFF"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="24"
                                Text="{Binding PostCount}"
                                TextColor="White" />
                            <Label
                                FontSize="12"
                                Opacity="0.85"
                                Text="Total Posts"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Border>
                    <Border
                        Grid.Column="1"
                        Padding="14,12"
                        BackgroundColor="#26FFFFFF"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0">
                        <VerticalStackLayout Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="24"
                                Text="{Binding CommentCount}"
                                TextColor="White" />
                            <Label
                                FontSize="12"
                                Opacity="0.85"
                                Text="Total Comments"
                                TextColor="White" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!--  Posts  -->
        <VerticalStackLayout Grid.Row="1" Margin="14,16,14,0" Spacing="10">
            <Label Style="{StaticResource SectionTitleStyle}" Text="Posts" />
            <RefreshView
                Command="{Binding RefreshPostsCommand}"
                IsRefreshing="{Binding IsLoading, Mode=OneWay}">
                <CollectionView ItemsSource="{Binding Posts}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0" Padding="14" Style="{StaticResource CardStyle}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectPostCommand}" CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                                        <Label Style="{StaticResource CardTitleStyle}" Text="{Binding UserName}" />
                                        <Label
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Style="{StaticResource BodyTextStyle}"
                                            Text="{Binding Content}" />
                                        <Label
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{Binding PostedOn, StringFormat='Posted on {0:dd/MM/yyyy HH:mm}'}" />
                                    </VerticalStackLayout>
                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeletePostCommand}"
                                        CommandParameter="{Binding PostId}"
                                        Style="{StaticResource SmallDangerButtonStyle}"
                                        Text="Delete"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </VerticalStackLayout>

        <!--  Comments  -->
        <VerticalStackLayout
            Grid.Row="2"
            Margin="14,16,14,0"
            IsVisible="{Binding IsCommentsVisible}"
            Opacity="0"
            Spacing="10">
            <VerticalStackLayout.Behaviors>
                <behaviors:AnimationBehavior
                    AnimationType="Fade"
                    Duration="300"
                    EasingType="SinInOut" />
            </VerticalStackLayout.Behaviors>
            <Label Style="{StaticResource SectionTitleStyle}" Text="Comments" />
            <RefreshView
                Command="{Binding RefreshCommentsCommand}"
                IsRefreshing="{Binding IsRefreshingComments, Mode=OneWay}">
                <CollectionView
                    ItemsSource="{Binding SelectedPostComments}"
                    RemainingItemsThreshold="1"
                    RemainingItemsThresholdReachedCommand="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.LoadMoreCommentsCommand}"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="10" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0" Padding="14" Style="{StaticResource CardStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                                        <Label Style="{StaticResource CardTitleStyle}" Text="{Binding UserName}" />
                                        <Label
                                            LineBreakMode="TailTruncation"
                                            MaxLines="2"
                                            Style="{StaticResource BodyTextStyle}"
                                            Text="{Binding Content}" />
                                        <Label
                                            Style="{StaticResource CaptionTextStyle}"
                                            Text="{Binding AddedOn, StringFormat='Commented on {0:dd/MM/yyyy HH:mm}'}" />
                                    </VerticalStackLayout>
                                    <Button
                                        Grid.Column="1"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommentCommand}"
                                        CommandParameter="{Binding CommentId}"
                                        Style="{StaticResource SmallDangerButtonStyle}"
                                        Text="Delete"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
