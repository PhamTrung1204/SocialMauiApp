<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:ext="clr-namespace:SocialMauiApp.Extensions"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    Title="Login"
    Padding="0"
    x:DataType="vm:LoginViewModel"
    BackgroundColor="{StaticResource Primary}"
    Shell.TitleColor="White">

    <Grid Background="{StaticResource BrandGradientBrush}">
        <ScrollView>
            <Grid Padding="18,36" RowDefinitions="*,Auto,*">

                <Border Grid.Row="1" Style="{StaticResource FlatCardStyle}" Padding="26,30">
                    <Border.Shadow>
                        <Shadow Brush="Black" Offset="0,6" Radius="18" Opacity="0.18" />
                    </Border.Shadow>

                    <Grid>

                        <!--  ===== Đăng nhập nhanh bằng vân tay =====  -->
                        <VerticalStackLayout IsVisible="{Binding ShowFingerprintOption}" Spacing="22">
                            <Border HeightRequest="112"
                                    HorizontalOptions="Center"
                                    Stroke="{StaticResource PrimarySoft}"
                                    StrokeShape="RoundRectangle 56"
                                    StrokeThickness="3"
                                    WidthRequest="112"
                                    Padding="0"
                                    BackgroundColor="{StaticResource LightSurface}">
                                <Image Aspect="AspectFill"
                                       HeightRequest="112"
                                       Source="logomaui.png"
                                       WidthRequest="112">
                                    <Image.Clip>
                                        <EllipseGeometry Center="56,56" RadiusX="56" RadiusY="56" />
                                    </Image.Clip>
                                </Image>
                            </Border>

                            <VerticalStackLayout Spacing="2">
                                <Label HorizontalTextAlignment="Center"
                                       Style="{StaticResource PageTitleStyle}"
                                       Text="{Binding Username, StringFormat='Chào {0}!'}" />
                                <Label HorizontalTextAlignment="Center"
                                       Style="{StaticResource MutedTextStyle}"
                                       Text="{ext:Translate Login_FingerprintHint}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource MutedTextStyle}" Text="{ext:Translate Login_Password}" />
                                <Border x:Name="PasswordBorder" Style="{StaticResource FieldStyle}">
                                    <controls:NoUnderLine
                                        BackgroundColor="Transparent"
                                        HeightRequest="46"
                                        IsPassword="True"
                                        Placeholder="{ext:Translate Login_PasswordPlaceholder}"
                                        Text="{Binding Password}"
                                        VerticalOptions="Center">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal" />
                                                <VisualState Name="Focused">
                                                    <VisualState.Setters>
                                                        <Setter TargetName="PasswordBorder" Property="Border.Stroke" Value="{StaticResource Primary}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </controls:NoUnderLine>
                                </Border>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Button Grid.Column="0" Command="{Binding LoginCommand}" Text="{ext:Translate Login_SignIn}" />
                                <ImageButton Grid.Column="1"
                                             Padding="12"
                                             BackgroundColor="{StaticResource PrimarySoft}"
                                             Command="{Binding LoginWithFingerprintCommand}"
                                             CornerRadius="14"
                                             HeightRequest="46"
                                             Source="fingerprint.png"
                                             WidthRequest="50" />
                            </Grid>

                            <Label HorizontalTextAlignment="Center"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="{ext:Translate Login_Forgot}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ForgotPassword_Clicked" />
                                </Label.GestureRecognizers>
                            </Label>

                            <Button Command="{Binding SwitchAccountCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Text="{ext:Translate Login_UseAnotherAccount}" />
                        </VerticalStackLayout>

                        <!--  ===== Đăng nhập bằng email =====  -->
                        <VerticalStackLayout IsVisible="{Binding ShowFingerprintOption, Converter={StaticResource InverseBooleanConverter}}" Spacing="20">

                            <Image HeightRequest="92" HorizontalOptions="Center" Source="logomaui.png" />

                            <VerticalStackLayout Spacing="2">
                                <Label HorizontalTextAlignment="Center" Style="{StaticResource PageTitleStyle}" Text="{ext:Translate Login_Title}" />
                                <Label HorizontalTextAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="{ext:Translate Login_Subtitle}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource MutedTextStyle}" Text="{ext:Translate Login_Email}" />
                                <Border x:Name="EmailBorder" Style="{StaticResource FieldStyle}">
                                    <controls:NoBorderEntry
                                        BackgroundColor="Transparent"
                                        HeightRequest="46"
                                        Keyboard="Email"
                                        Placeholder="{ext:Translate Login_EmailPlaceholder}"
                                        Text="{Binding Email}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal" />
                                                <VisualState Name="Focused">
                                                    <VisualState.Setters>
                                                        <Setter TargetName="EmailBorder" Property="Border.Stroke" Value="{StaticResource Primary}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </controls:NoBorderEntry>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="6">
                                <Label Style="{StaticResource MutedTextStyle}" Text="{ext:Translate Login_Password}" />
                                <Border x:Name="PasswordBorder2" Style="{StaticResource FieldStyle}">
                                    <controls:NoBorderEntry
                                        BackgroundColor="Transparent"
                                        HeightRequest="46"
                                        IsPassword="True"
                                        Placeholder="{ext:Translate Login_PasswordPlaceholder}"
                                        Text="{Binding Password}">
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup Name="CommonStates">
                                                <VisualState Name="Normal" />
                                                <VisualState Name="Focused">
                                                    <VisualState.Setters>
                                                        <Setter TargetName="PasswordBorder2" Property="Border.Stroke" Value="{StaticResource Primary}" />
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                    </controls:NoBorderEntry>
                                </Border>
                            </VerticalStackLayout>

                            <Label HorizontalOptions="End"
                                   Style="{StaticResource MutedTextStyle}"
                                   Text="{ext:Translate Login_Forgot}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="ForgotPassword_Clicked" />
                                </Label.GestureRecognizers>
                            </Label>

                            <Button Command="{Binding LoginCommand}" Text="{ext:Translate Login_SignIn}" />

                            <Grid Margin="0,4" ColumnDefinitions="*,Auto,*" VerticalOptions="Center">
                                <BoxView Grid.Column="0" Style="{StaticResource SeparatorStyle}" VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Padding="12,0"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Text="{ext:Translate Login_NoAccount}" />
                                <BoxView Grid.Column="2" Style="{StaticResource SeparatorStyle}" VerticalOptions="Center" />
                            </Grid>

                            <Button Clicked="Register_Clicked"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Text="{ext:Translate Login_Register}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </Grid>
        </ScrollView>

        <ActivityIndicator HorizontalOptions="Center"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           VerticalOptions="Center"
                           Color="White" />
    </Grid>
</ContentPage>
