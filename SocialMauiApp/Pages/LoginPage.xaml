<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    Title="Login"
    Padding="0"
    x:DataType="vm:LoginViewModel"
    BackgroundColor="{StaticResource Primary}"
    Shell.TitleColor="White">
    <Grid BackgroundColor="{StaticResource Primary}" RowDefinitions="*, Auto, *">
        <Border
            Grid.Row="1"
            Margin="20"
            Padding="30"
            BackgroundColor="White"
            Stroke="#D0D0D0"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 10">
            <Border.Shadow>
                <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.1" />
            </Border.Shadow>
            <Grid RowSpacing="25">
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    IsVisible="{Binding ShowFingerprintOption}"
                    Spacing="25">
                    <Border
                        BackgroundColor="White"
                        HeightRequest="120"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 60"
                        WidthRequest="120">
                        <Border.Shadow>
                            <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.1" />
                        </Border.Shadow>
                        <Image
                            Aspect="AspectFill"
                            HeightRequest="120"
                            Source="logomaui.png"
                            WidthRequest="120">
                            <Image.Clip>
                                <EllipseGeometry
                                    Center="60,60"
                                    RadiusX="60"
                                    RadiusY="60" />
                            </Image.Clip>
                        </Image>
                    </Border>
                    <Label
                        FontAttributes="Bold"
                        FontSize="26"
                        HorizontalTextAlignment="Center"
                        Text="{Binding Username, StringFormat='Welcome, {0}!'}"
                        TextColor="{StaticResource Primary}" />
                    <VerticalStackLayout Spacing="10">
                        <Label Style="{StaticResource formLabel}" Text="Password" FontSize="16" />
                        <Border
                            x:Name="PasswordBorder"
                            HeightRequest="50"
                            HorizontalOptions="Fill"
                            Stroke="#D0D0D0"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1"
                            BackgroundColor="#F8F8F8">
                            <Border.Shadow>
                                <Shadow Brush="#20000000" Offset="0,1" Radius="5" Opacity="0.05" />
                            </Border.Shadow>
                            <controls:NoUnderLine
                                Margin="12,0"
                                BackgroundColor="Transparent"
                                IsPassword="True"
                                Placeholder="Enter your password"
                                PlaceholderColor="#A0A0A0"
                                Text="{Binding Password}"
                                VerticalOptions="Center">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="Focused">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#F0F0F0" />
                                                <Setter TargetName="PasswordBorder" Property="Border.Stroke" Value="{StaticResource Primary}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </controls:NoUnderLine>
                        </Border>
                    </VerticalStackLayout>
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="15">
                        <Button
                            BackgroundColor="{StaticResource Primary}"
                            Command="{Binding LoginCommand}"
                            CornerRadius="10"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            Text="Login"
                            TextColor="White"
                            WidthRequest="200">
                            <Button.Shadow>
                                <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.1" />
                            </Button.Shadow>
                        </Button>
                        <ImageButton
                            Padding="12"
                            BackgroundColor="#F0F0F0"
                            Command="{Binding LoginWithFingerprintCommand}"
                            CornerRadius="10"
                            HeightRequest="50"
                            Source="fingerprint.png"
                            WidthRequest="50">
                            <ImageButton.Shadow>
                                <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.1" />
                            </ImageButton.Shadow>
                        </ImageButton>
                    </HorizontalStackLayout>
                    <Label Text="Forgot Password?" TextColor="#666666" FontSize="14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="ForgotPassword_Clicked"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Button
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="1"
                        Command="{Binding SwitchAccountCommand}"
                        CornerRadius="10"
                        HeightRequest="50"
                        Text="Use another account"
                        TextColor="{StaticResource Primary}"
                        FontAttributes="Bold">
                        <Button.Shadow>
                            <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.1" />
                        </Button.Shadow>
                    </Button>
                </VerticalStackLayout>
                <VerticalStackLayout IsVisible="{Binding ShowFingerprintOption, Converter={StaticResource InverseBooleanConverter}}" Spacing="25">
                    <Image
                        HeightRequest="100"
                        HorizontalOptions="Center"
                        Source="logomaui.png" />
                    <VerticalStackLayout Spacing="15">
                        <Label Style="{StaticResource formLabel}" Text="Email" FontSize="16" />
                        <Border
                            x:Name="EmailBorder"
                            Stroke="#D0D0D0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="#F8F8F8">
                            <Border.Shadow>
                                <Shadow Brush="#20000000" Offset="0,1" Radius="5" Opacity="0.05" />
                            </Border.Shadow>
                            <controls:NoBorderEntry
                                BackgroundColor="Transparent"
                                HeightRequest="50"
                                Keyboard="Email"
                                Placeholder="Enter your email"
                                PlaceholderColor="#A0A0A0"
                                Text="{Binding Email}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="Focused">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#F0F0F0" />
                                                <Setter TargetName="EmailBorder" Property="Border.Stroke" Value="{StaticResource Primary}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </controls:NoBorderEntry>
                        </Border>
                        <Label Style="{StaticResource formLabel}" Text="Password" FontSize="16" />
                        <Border
                            x:Name="PasswordBorder2"
                            Stroke="#D0D0D0"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="#F8F8F8">
                            <Border.Shadow>
                                <Shadow Brush="#20000000" Offset="0,1" Radius="5" Opacity="0.05" />
                            </Border.Shadow>
                            <controls:NoBorderEntry
                                BackgroundColor="Transparent"
                                HeightRequest="50"
                                IsPassword="True"
                                Placeholder="Enter your password"
                                PlaceholderColor="#A0A0A0"
                                Text="{Binding Password}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup Name="CommonStates">
                                        <VisualState Name="Normal" />
                                        <VisualState Name="Focused">
                                            <VisualState.Setters>
                                                <Setter Property="BackgroundColor" Value="#F0F0F0" />
                                                <Setter TargetName="PasswordBorder2" Property="Border.Stroke" Value="{StaticResource Primary}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </controls:NoBorderEntry>
                        </Border>
                    </VerticalStackLayout>
                    <Label Text="Forgot Password?" TextColor="#666666" FontSize="14">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="ForgotPassword_Clicked"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <Button
                        BackgroundColor="{StaticResource Primary}"
                        Command="{Binding LoginCommand}"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        Text="Login"
                        TextColor="White">
                        <Button.Shadow>
                            <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.1" />
                        </Button.Shadow>
                    </Button>
                    <Grid ColumnDefinitions="*, Auto, *" VerticalOptions="Center" Margin="0,10,0,0">
                        <BoxView
                            Grid.Column="0"
                            HeightRequest="1"
                            Color="#D0D0D0" />
                        <Label
                            Grid.Column="1"
                            Padding="12,0"
                            FontAttributes="Bold"
                            Text="New here?"
                            TextColor="{StaticResource Primary}"
                            FontSize="14" />
                        <BoxView
                            Grid.Column="2"
                            HeightRequest="1"
                            Color="#D0D0D0" />
                    </Grid>
                    <Button
                        BackgroundColor="White"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="1"
                        Clicked="Register_Clicked"
                        CornerRadius="10"
                        HeightRequest="50"
                        Text="Register"
                        TextColor="{StaticResource Primary}"
                        FontAttributes="Bold">
                        <Button.Shadow>
                            <Shadow Brush="#20000000" Offset="0,2" Radius="8" Opacity="0.1" />
                        </Button.Shadow>
                    </Button>
                </VerticalStackLayout>
            </Grid>
        </Border>
        <ActivityIndicator
            Grid.RowSpan="3"
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center"
            Color="White" />
    </Grid>
</ContentPage>