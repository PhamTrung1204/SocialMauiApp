<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    Title="Login"
    Padding="0"
    x:DataType="vm:LoginViewModel"
    BackgroundColor="{StaticResource Primary}"
    Shell.TitleColor="White">

    <Grid BackgroundColor="{StaticResource Primary}" RowDefinitions="*, Auto, *">
        <!--  Form container  -->
        <Border
            Grid.Row="1"
            Margin="20"
            Padding="25"
            BackgroundColor="White"
            Stroke="#E0E0E0"
            StrokeThickness="1">

            <Grid RowSpacing="20">
                <!--  LAYOUT A: avatar + welcome + pass/fingerprint + switch  -->
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    IsVisible="{Binding ShowFingerprintOption}"
                    Spacing="20">

                    <!--  Avatar với border và shadow  -->
                    <Border
                        BackgroundColor="White"
                        HeightRequest="110"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="2"
                        WidthRequest="110">
                        <Image
                            Aspect="AspectFill"
                            HeightRequest="110"
                            Source="social_media.png"
                            WidthRequest="110">
                            <Image.Clip>
                                <EllipseGeometry
                                    Center="55,55"
                                    RadiusX="55"
                                    RadiusY="55" />
                            </Image.Clip>
                        </Image>
                    </Border>

                    <!--  Welcome  -->
                    <Label
                        FontAttributes="Bold"
                        FontSize="24"
                        HorizontalTextAlignment="Center"
                        Text="{Binding Username, StringFormat='Welcome, {0}!'}"
                        TextColor="{StaticResource Primary}" />

                    <!--  Password field  -->
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource formLabel}" Text="Password" />
                        <Border
                           
                            HeightRequest="50"
                            HorizontalOptions="Fill"
                            Stroke="{StaticResource Primary}"
                            StrokeShape="RoundRectangle 30"
                            StrokeThickness="1">
                            <controls:NoUnderLine
                                Margin="10,0"
                                BackgroundColor="Transparent"
                                IsPassword="True"
                                Placeholder="Enter your password"
                                PlaceholderColor="#A8A8A8"
                                Text="{Binding Password}"
                                VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>


                    <!--  Buttons  -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="15">
                        <Button
                            BackgroundColor="{StaticResource Primary}"
                            Command="{Binding LoginCommand}"
                            CornerRadius="8"
                            FontAttributes="Bold"
                            HeightRequest="48"
                            Text="Login"
                            TextColor="White"
                            WidthRequest="200" />

                        <ImageButton
                            Padding="10"
                            BackgroundColor="#EEEEEE"
                            Command="{Binding LoginWithFingerprintCommand}"
                            CornerRadius="8"
                            HeightRequest="48"
                            Source="fingerprint.png"
                            WidthRequest="48" />
                    </HorizontalStackLayout>
                    <Label Text="Forgot Password ?" TextColor="Gray">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="ForgotPassword_Clicked"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <Button
                        BackgroundColor="Transparent"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="1"
                        Command="{Binding SwitchAccountCommand}"
                        CornerRadius="8"
                        HeightRequest="45"
                        Text="Use another account"
                        TextColor="{StaticResource Primary}" />

                </VerticalStackLayout>

                <!--  LAYOUT B: email + password + login + register  -->
                <VerticalStackLayout IsVisible="{Binding ShowFingerprintOption, Converter={StaticResource InverseBooleanConverter}}" Spacing="20">

                    <!--  Logo  -->
                    <Image
                        HeightRequest="100"
                        HorizontalOptions="Center"
                        Source="social_media.png" />

                    <!--  Email & Password  -->
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource formLabel}" Text="Email" />
                        <controls:NoBorderEntry
                            BackgroundColor="#F5F5F5"
                            HeightRequest="48"
                            Keyboard="Email"
                            Placeholder="Enter your email"
                            PlaceholderColor="#A8A8A8"
                            Text="{Binding Email}" />

                        <Label Style="{StaticResource formLabel}" Text="Password" />
                        <controls:NoBorderEntry
                            BackgroundColor="#F5F5F5"
                            HeightRequest="48"
                            IsPassword="True"
                            Placeholder="Enter your password"
                            PlaceholderColor="#A8A8A8"
                            Text="{Binding Password}" />
                    </VerticalStackLayout>
                    <Label Text="Forgot Password ?" TextColor="Gray">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="ForgotPassword_Clicked"/>
                        </Label.GestureRecognizers>
                    </Label>

                    <!--  Login button  -->
                    <Button
                        BackgroundColor="{StaticResource Primary}"
                        Command="{Binding LoginCommand}"
                        CornerRadius="8"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        Text="Login"
                        TextColor="White" />

                    <!--  Divider  -->
                    <Grid ColumnDefinitions="*, Auto, *" VerticalOptions="Center">
                        <BoxView
                            Grid.Column="0"
                            HeightRequest="1"
                            Color="#E0E0E0" />
                        <Label
                            Grid.Column="1"
                            Padding="12,0"
                            FontAttributes="Bold"
                            Text="New here?"
                            TextColor="{StaticResource Primary}" />
                        <BoxView
                            Grid.Column="2"
                            HeightRequest="1"
                            Color="#E0E0E0" />
                    </Grid>

                    <!--  Register button  -->
                    <Button
                        BackgroundColor="White"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="1"
                        Clicked="Register_Clicked"
                        CornerRadius="8"
                        HeightRequest="48"
                        Text="Register"
                        TextColor="{StaticResource Primary}" />

                </VerticalStackLayout>
            </Grid>

        </Border>

        <!--  Activity Indicator  -->
        <ActivityIndicator
            Grid.RowSpan="3"
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center"
            Color="White" />
    </Grid>
</ContentPage>
