<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    Title="Login"
    x:DataType="vm:LoginViewModel"
    BackgroundColor="{StaticResource Primary}"
    Shell.TitleColor="White"
    Padding="0">

    <Grid RowDefinitions="*, Auto, *" BackgroundColor="{StaticResource Primary}">
        <!-- Form container -->
        <Border 
            Grid.Row="1"
            Margin="20"
            Padding="25"
            BackgroundColor="White"
            Stroke="#E0E0E0"
            StrokeThickness="1"
            
           >

            <Grid RowSpacing="20">
                <!-- LAYOUT A: avatar + welcome + pass/fingerprint + switch -->
                <VerticalStackLayout
                    Spacing="20"
                    HorizontalOptions="Center"
                    IsVisible="{Binding ShowFingerprintOption}">

                    <!-- Avatar với border và shadow -->
                    <Border
                        WidthRequest="110"
                        HeightRequest="110"
                        
                        BackgroundColor="White"
                        Stroke="{StaticResource Primary}"
                        StrokeThickness="2"
                       >
                        <Image
                            Source="social_media.png"
                            Aspect="AspectFill"
                            WidthRequest="110"
                            HeightRequest="110">
                            <Image.Clip>
                                <EllipseGeometry Center="55,55" RadiusX="55" RadiusY="55" />
                            </Image.Clip>
                        </Image>
                    </Border>

                    <!-- Welcome -->
                    <Label
                        Text="{Binding Username, StringFormat='Welcome, {0}!'}"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Primary}"
                        HorizontalTextAlignment="Center" />

                    <!-- Password field -->
                    <VerticalStackLayout Spacing="8">
                        <Label Style="{StaticResource formLabel}" Text="Password" />
                        <controls:NoBorderEntry
                            BackgroundColor="#F5F5F5"
                            HeightRequest="48"
                            IsPassword="True"
                            Placeholder="Enter your password"
                            PlaceholderColor="#A8A8A8"
                            Text="{Binding Password}" />
                    </VerticalStackLayout>

                    <!-- Buttons -->
                    <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                        <Button
                            Text="Login"
                            Command="{Binding LoginCommand}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            HeightRequest="48"
                            WidthRequest="200" />

                        <ImageButton
                            Source="fingerprint.png"
                            Command="{Binding LoginWithFingerprintCommand}"
                            BackgroundColor="#EEEEEE"
                            CornerRadius="8"
                            HeightRequest="48"
                            WidthRequest="48"
                            Padding="10" />
                    </HorizontalStackLayout>

                    <Button
                        Text="Use another account"
                        Command="{Binding SwitchAccountCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{StaticResource Primary}"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="1"
                        CornerRadius="8"
                        HeightRequest="45" />

                </VerticalStackLayout>

                <!-- LAYOUT B: email + password + login + register -->
                <VerticalStackLayout
                    Spacing="20"
                    IsVisible="{Binding ShowFingerprintOption, Converter={StaticResource InverseBooleanConverter}}">

                    <!-- Logo -->
                    <Image
                        Source="social_media.png"
                        HeightRequest="100"
                        HorizontalOptions="Center" />

                    <!-- Email & Password -->
                    <VerticalStackLayout Spacing="12">
                        <Label Style="{StaticResource formLabel}" Text="Email" />
                        <controls:NoBorderEntry
                            BackgroundColor="#F5F5F5"
                            HeightRequest="48"
                            Keyboard="Email"
                            Placeholder="Enter your email"
                            PlaceholderColor="#A8A8A8"
                            Text="{Binding Email}" />

                        <Label Style="{StaticResource formLabel}" Text="Password" />
                        <controls:NoBorderEntry
                            BackgroundColor="#F5F5F5"
                            HeightRequest="48"
                            IsPassword="True"
                            Placeholder="Enter your password"
                            PlaceholderColor="#A8A8A8"
                            Text="{Binding Password}" />
                    </VerticalStackLayout>

                    <!-- Login button -->
                    <Button
                        Text="Login"
                        Command="{Binding LoginCommand}"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        HeightRequest="48" />

                    <!-- Divider -->
                    <Grid ColumnDefinitions="*, Auto, *" VerticalOptions="Center">
                        <BoxView Grid.Column="0" HeightRequest="1" Color="#E0E0E0" />
                        <Label
                            Grid.Column="1"
                            Text="New here?"
                            Padding="12,0"
                            FontAttributes="Bold"
                            TextColor="{StaticResource Primary}" />
                        <BoxView Grid.Column="2" HeightRequest="1" Color="#E0E0E0" />
                    </Grid>

                    <!-- Register button -->
                    <Button
                        Text="Register"
                        Clicked="Register_Clicked"
                        BackgroundColor="White"
                        TextColor="{StaticResource Primary}"
                        BorderColor="{StaticResource Primary}"
                        BorderWidth="1"
                        CornerRadius="8"
                        HeightRequest="48" />

                </VerticalStackLayout>
            </Grid>

        </Border>

        <!-- Activity Indicator -->
        <ActivityIndicator
            Grid.RowSpan="3"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Color="White" />
    </Grid>
</ContentPage>
