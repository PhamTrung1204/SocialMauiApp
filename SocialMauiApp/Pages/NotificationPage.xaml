<ContentPage
    x:Class="SocialMauiApp.Pages.NotificationPage"
    x:Name="notificationPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:ext="clr-namespace:SocialMauiApp.Extensions"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dtos="clr-namespace:SocialMediaMaui.Shared.Dtos;assembly=SocialMediaMaui.Shared"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    Title="{ext:Translate Notifications_Title}"
    x:DataType="vm:NotificationViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.TitleColor="White">

    <RefreshView Command="{Binding RefreshNotificationsCommand}" IsRefreshing="{Binding IsRefreshing}">
        <CollectionView ItemsSource="{Binding Notifications}"
                        RemainingItemsThreshold="10"
                        RemainingItemsThresholdReachedCommand="{Binding FetchNotificationCommand}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="0" Orientation="Vertical" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Label Style="{StaticResource EmptyStateStyle}" Text="{ext:Translate Notifications_Empty}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="dtos:NotificationDto">
                    <Border Style="{StaticResource CardStyle}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Grid.Column="0"
                                    Padding="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource DarkSurfaceAlt}}"
                                    HeightRequest="42"
                                    StrokeShape="RoundRectangle 21"
                                    StrokeThickness="0"
                                    VerticalOptions="Start"
                                    WidthRequest="42">
                                <Image HeightRequest="18"
                                       HorizontalOptions="Center"
                                       Source="bell.png"
                                       VerticalOptions="Center"
                                       WidthRequest="18" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label LineHeight="1.3" Style="{StaticResource BodyTextStyle}" Text="{Binding Text}" />
                                <Label Style="{StaticResource CaptionTextStyle}"
                                       Text="{Binding When, Converter={StaticResource HumanizedTimeConverter}}" />
                            </VerticalStackLayout>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer x:DataType="{x:Null}"
                                                      Command="{Binding Source={x:Reference notificationPageRoot}, Path=BindingContext.OpenPostCommand}"
                                                      CommandParameter="{Binding PostId}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
