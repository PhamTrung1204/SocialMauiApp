<ContentPage
    x:Class="SocialMauiApp.Pages.NotificationPage"
    x:Name="notificationPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dtos="clr-namespace:SocialMediaMaui.Shared.Dtos;assembly=SocialMediaMaui.Shared"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    xmlns:converters="clr-namespace:SocialMauiApp.Converters"
    Title="Notification"
    x:DataType="vm:NotificationViewModel"
    BackgroundColor="{StaticResource Gray100}"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.TitleColor="White">

    <RefreshView Command="{Binding RefreshNotificationsCommand}" IsRefreshing="{Binding IsRefreshing}">
        <Grid>
            <CollectionView ItemsSource="{Binding Notifications}"
                            RemainingItemsThreshold="10"
                            RemainingItemsThresholdReachedCommand="{Binding FetchNotificationCommand}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="dtos:NotificationDto">
                        <Border Margin="0,5"
                                Padding="10"
                                BackgroundColor="White"
                                StrokeThickness="0">
                            <VerticalStackLayout Spacing="5">
                                <Label FontSize="12"
                                       Text="{Binding When, Converter={StaticResource HumanizedTimeConverter }}"
                                       TextColor="DarkGray" />
                                <Label Text="{Binding Text}" TextColor="DarkGray"/>
                            </VerticalStackLayout>
                            <Border.GestureRecognizers>
                                <!-- Đảm bảo x:DataType được vô hiệu trên TapGestureRecognizer -->
                                <TapGestureRecognizer x:DataType="{x:Null}"
                                    Command="{Binding Source={x:Reference notificationPageRoot}, Path=BindingContext.OpenPostCommand}"
                                    CommandParameter="{Binding PostId}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </RefreshView>
</ContentPage>
