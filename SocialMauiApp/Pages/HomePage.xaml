<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:ext="clr-namespace:SocialMauiApp.Extensions"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    x:DataType="vm:HomeViewModel"
    BackgroundColor="{DynamicResource Gray100}"
    Shell.BackgroundColor="{DynamicResource Primary}">

    <!-- Shell TitleView -->
    <Shell.TitleView>
        <Grid Padding="5" ColumnDefinitions="Auto,*,Auto">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="25"
                Text="Social App Maui"
                TextColor="{DynamicResource White}"
                VerticalOptions="Center" />

            <Grid
                Grid.Column="2"
                Margin="0,0,15,0"
                ColumnDefinitions="Auto,Auto,Auto,Auto"
                ColumnSpacing="20"
                VerticalOptions="Center">
                <controls:WhiteImage
                    Grid.Column="0"
                    HeightRequest="25"
                    Source="plus.png"
                    WidthRequest="25">
                    <controls:WhiteImage.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToAddPostCommand}" />
                    </controls:WhiteImage.GestureRecognizers>
                </controls:WhiteImage>

                <Grid Grid.Column="1">
                    <controls:WhiteImage
                        HeightRequest="24"
                        Source="bell.png"
                        WidthRequest="24" />
                    <Ellipse
                        Fill="Black"
                        HeightRequest="15"
                        HorizontalOptions="End"
                        IsVisible="{Binding IsThereNewNotification}"
                        VerticalOptions="Start"
                        WidthRequest="15" />
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Tapped="GoToNotification" />
                    </Grid.GestureRecognizers>
                </Grid>

                <controls:WhiteImage
                    Grid.Column="2"
                    HeightRequest="25"
                    Source="user.png"
                    WidthRequest="25">
                    <controls:WhiteImage.GestureRecognizers>
                        <TapGestureRecognizer Tapped="GoToFriends" />
                    </controls:WhiteImage.GestureRecognizers>
                </controls:WhiteImage>

                <controls:WhiteImage
                    Grid.Column="3"
                    HeightRequest="25"
                    Source="personal.png"
                    WidthRequest="25">
                    <controls:WhiteImage.GestureRecognizers>
                        <TapGestureRecognizer Tapped="GoToProfile" />
                    </controls:WhiteImage.GestureRecognizers>
                </controls:WhiteImage>
            </Grid>
        </Grid>
    </Shell.TitleView>

    <RefreshView Command="{Binding RefreshPostsCommand}" IsRefreshing="{Binding IsRefreshing}">
        <Grid Padding="0" RowDefinitions="Auto,*">
            <Grid
                Padding="12,10"
                Margin="0,0,0,6"
                BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="10">
                <Border Grid.Column="0" Style="{StaticResource AvatarStyle}">
                    <Image
                        Aspect="AspectFill"
                        HeightRequest="48"
                        HorizontalOptions="Center"
                        Source="{Binding User.Photo}"
                        VerticalOptions="Center"
                        WidthRequest="48" />
                </Border>

                <!--  Ô soạn bài: giãn theo bề rộng màn hình thay vì cố định 325px  -->
                <Border
                    Grid.Column="1"
                    Padding="14,0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSurfaceAlt}, Dark={StaticResource DarkSurfaceAlt}}"
                    HeightRequest="48"
                    HorizontalOptions="Fill"
                    Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="1">
                    <controls:NoUnderLine
                        FontSize="15"
                        Placeholder="{ext:Translate Home_ComposerPlaceholder}"
                        PlaceholderColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                        ReturnType="Done"
                        VerticalOptions="Center">
                        <controls:NoUnderLine.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToAddPostCommand}" />
                        </controls:NoUnderLine.GestureRecognizers>
                    </controls:NoUnderLine>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToAddPostCommand}" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <CollectionView
                Grid.Row="1"
                ItemTemplate="{StaticResource postDataTemplateSelector}"
                ItemsSource="{Binding Posts}"
                RemainingItemsThreshold="2"
                RemainingItemsThresholdReachedCommand="{Binding FetchPostsCommand}">
                <CollectionView.EmptyView>
                    <Label Style="{StaticResource EmptyStateStyle}" Text="{ext:Translate Home_EmptyFeed}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout ItemSpacing="0" Orientation="Vertical" />
                </CollectionView.ItemsLayout>
            </CollectionView>

            <ActivityIndicator
                Grid.Row="1"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                VerticalOptions="Center" />
        </Grid>
    </RefreshView>
</ContentPage>