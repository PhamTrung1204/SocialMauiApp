<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.ResetPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    Title="Reset Password"
    x:DataType="vm:ResetPasswordViewModel"
    BackgroundColor="{StaticResource Primary}"
    Shell.TitleColor="{StaticResource Primary}"
    Padding="0">

    <ScrollView>
        <Grid RowDefinitions="*, Auto, *" BackgroundColor="{StaticResource Primary}">
            <Border
                Grid.Row="1"
                Margin="20"
                Padding="30"
                BackgroundColor="White"
                Stroke="#DDDDDD"
                StrokeThickness="1">

                <ScrollView>
                    <VerticalStackLayout Spacing="25">

                        <Image
                            Source="social_media.png"
                            HeightRequest="100"
                            HorizontalOptions="Center" />

                        <Label
                            Text="Reset Password"
                            FontSize="26"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            TextColor="{StaticResource Primary}" />

                        <!-- Part 1: Request Reset Password -->
                        <VerticalStackLayout Spacing="15" IsVisible="{Binding IsRequestResetVisible}">
                            <Label Text="Request Reset Code" FontSize="18" />
                            <controls:NoBorderEntry
                                Placeholder="Enter your Gmail address"
                                BackgroundColor="#F2F2F2"
                                PlaceholderColor="#A0A0A0"
                                Text="{Binding Email}"
                                Keyboard="Email"
                                HeightRequest="45" />
                            <Button
                                Text="Send Reset Code"
                                Command="{Binding RequestResetCommand}"
                                CornerRadius="8"
                                HeightRequest="45"
                                WidthRequest="280"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <!-- Part 2: Enter Reset Code -->
                        <VerticalStackLayout Spacing="15" IsVisible="{Binding IsEnterCodeVisible}">
                            <Label Text="Enter Reset Code" FontSize="18" />
                            <controls:NoBorderEntry
                                Placeholder="Enter 6-digit code"
                                BackgroundColor="#F2F2F2"
                                PlaceholderColor="#A0A0A0"
                                Text="{Binding ResetCode}"
                                Keyboard="Default"
                                MaxLength="6"
                                HeightRequest="45" />
                            <Button
                                Text="Verify Code"
                                Command="{Binding VerifyCodeCommand}"
                                CornerRadius="8"
                                HeightRequest="45"
                                WidthRequest="280"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <!-- Part 3: Reset Your Password -->
                        <VerticalStackLayout Spacing="15" IsVisible="{Binding IsResetPasswordVisible}">
                            <Label Text="Reset Your Password" FontSize="18" />
                            <controls:NoBorderEntry
                                Placeholder="Reset Code"
                                BackgroundColor="#F2F2F2"
                                PlaceholderColor="#A0A0A0"
                                Text="{Binding ResetToken}"
                                IsEnabled="False"
                                HeightRequest="45" />
                            <controls:NoBorderEntry
                                Placeholder="New Password"
                                BackgroundColor="#F2F2F2"
                                PlaceholderColor="#A0A0A0"
                                Text="{Binding NewPassword}"
                                IsPassword="True"
                                HeightRequest="45" />
                            <controls:NoBorderEntry
                                Placeholder="Confirm Password"
                                BackgroundColor="#F2F2F2"
                                PlaceholderColor="#A0A0A0"
                                Text="{Binding ConfirmPassword}"
                                IsPassword="True"
                                HeightRequest="45" />
                            <Button
                                Text="Reset Password"
                                Command="{Binding ResetPasswordCommand}"
                                CornerRadius="8"
                                HeightRequest="45"
                                WidthRequest="280"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, Auto, *" VerticalOptions="Center" Margin="0,10">
                            <BoxView Grid.Column="0" HeightRequest="1" BackgroundColor="#DDDDDD" />
                            <Label
                                Grid.Column="1"
                                Text="Back to Login?"
                                Padding="15,0"
                                TextColor="{StaticResource Primary}"
                                FontAttributes="Bold" />
                            <BoxView Grid.Column="2" HeightRequest="1" BackgroundColor="#DDDDDD" />
                        </Grid>

                        <Button
                            Text="Login"
                            Clicked="btnLogin_Clicked"
                            CornerRadius="8"
                            HeightRequest="45"
                            WidthRequest="280"
                            BackgroundColor="White"
                            TextColor="{StaticResource Primary}"
                            BorderColor="{StaticResource Primary}"
                            BorderWidth="1"
                            FontAttributes="Bold" />

                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <ActivityIndicator
                Grid.RowSpan="3"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="White"
                VerticalOptions="Center"
                HorizontalOptions="Center" />
        </Grid>
    </ScrollView>
</ContentPage>