<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.ResetPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    Title="Reset Password"
    Padding="0"
    x:DataType="vm:ResetPasswordViewModel"
    Shell.TitleColor="White">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="{StaticResource Primary}" />
            <GradientStop Offset="1.0" Color="{StaticResource PrimaryDarker}" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <ScrollView>
            <Grid Padding="18,28" RowDefinitions="*,Auto,*">
                <Border
                    Grid.Row="1"
                    Padding="24,28"
                    BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}"
                    Shadow="{StaticResource ShadowLg}"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="0">

                    <VerticalStackLayout Spacing="20">

                        <Image
                            HeightRequest="88"
                            HorizontalOptions="Center"
                            Source="social_media.png" />

                        <VerticalStackLayout Spacing="4">
                            <Label
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource PageTitleStyle}"
                                Text="Reset Password" />
                            <Label
                                HorizontalTextAlignment="Center"
                                Style="{StaticResource MutedTextStyle}"
                                Text="We'll email you a 6-digit code to get back in." />
                        </VerticalStackLayout>

                        <!--  Step 1: request a code  -->
                        <VerticalStackLayout IsVisible="{Binding IsRequestResetVisible}" Spacing="12">
                            <Label Style="{StaticResource SectionTitleStyle}" Text="Request Reset Code" />
                            <Border Style="{StaticResource FieldStyle}">
                                <controls:NoBorderEntry
                                    Keyboard="Email"
                                    Placeholder="Enter your Gmail address"
                                    Text="{Binding Email}" />
                            </Border>
                            <Button Command="{Binding RequestResetCommand}" Text="Send Reset Code" />
                        </VerticalStackLayout>

                        <!--  Step 2: verify the code  -->
                        <VerticalStackLayout IsVisible="{Binding IsEnterCodeVisible}" Spacing="12">
                            <Label Style="{StaticResource SectionTitleStyle}" Text="Enter Reset Code" />
                            <Border Style="{StaticResource FieldStyle}">
                                <controls:NoBorderEntry
                                    Keyboard="Default"
                                    MaxLength="6"
                                    Placeholder="Enter 6-digit code"
                                    Text="{Binding ResetCode}" />
                            </Border>
                            <Button Command="{Binding VerifyCodeCommand}" Text="Verify Code" />
                        </VerticalStackLayout>

                        <!--  Step 3: set a new password  -->
                        <VerticalStackLayout IsVisible="{Binding IsResetPasswordVisible}" Spacing="12">
                            <Label Style="{StaticResource SectionTitleStyle}" Text="Reset Your Password" />
                            <Border Style="{StaticResource FieldStyle}">
                                <controls:NoBorderEntry
                                    IsEnabled="False"
                                    Placeholder="Reset Code"
                                    Text="{Binding ResetToken}" />
                            </Border>
                            <Border Style="{StaticResource FieldStyle}">
                                <controls:NoBorderEntry
                                    IsPassword="True"
                                    Placeholder="New Password"
                                    Text="{Binding NewPassword}" />
                            </Border>
                            <Border Style="{StaticResource FieldStyle}">
                                <controls:NoBorderEntry
                                    IsPassword="True"
                                    Placeholder="Confirm Password"
                                    Text="{Binding ConfirmPassword}" />
                            </Border>
                            <Button Command="{Binding ResetPasswordCommand}" Text="Reset Password" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto,*" VerticalOptions="Center">
                            <BoxView Grid.Column="0" Style="{StaticResource SeparatorStyle}" VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                Padding="14,0"
                                Style="{StaticResource MutedTextStyle}"
                                Text="Back to Login?" />
                            <BoxView Grid.Column="2" Style="{StaticResource SeparatorStyle}" VerticalOptions="Center" />
                        </Grid>

                        <Button
                            Clicked="btnLogin_Clicked"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Text="Login" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>

        <ActivityIndicator
            HorizontalOptions="Center"
            IsRunning="{Binding IsBusy}"
            IsVisible="{Binding IsBusy}"
            VerticalOptions="Center"
            Color="White" />
    </Grid>
</ContentPage>
