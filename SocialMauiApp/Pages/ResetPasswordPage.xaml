<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.ResetPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    Title="Reset Password"
    x:DataType="vm:ResetPasswordViewModel"
    BackgroundColor="{StaticResource Primary}"
    Shell.TitleColor="{StaticResource Primary}"
    Padding="0">

    <!-- Center nội dung chính theo chiều dọc -->
    <ScrollView>
        <Grid RowDefinitions="*, Auto, *" BackgroundColor="{StaticResource Primary}">
            <!-- Khung bo góc trắng cho form reset mật khẩu -->
            <Border
                Grid.Row="1"
                Margin="20"
                Padding="30"
                BackgroundColor="White"
                Stroke="#DDDDDD"
                StrokeThickness="1">

                <ScrollView>
                    <VerticalStackLayout Spacing="25">

                        <!-- Logo hoặc hình đại diện ứng dụng -->
                        <Image
                            Source="social_media.png"
                            HeightRequest="100"
                            HorizontalOptions="Center" />

                        <!-- Tiêu đề trang -->
                        <Label
                            Text="Reset Password"
                            FontSize="26"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            TextColor="{StaticResource Primary}" />

                        <!-- Section for Requesting Reset Link -->
                        <VerticalStackLayout Spacing="15">
                            <Label Text="Request Reset Link" FontSize="18" />
                            <controls:NoBorderEntry
                                Placeholder="Enter your Gmail address"
                                BackgroundColor="#F2F2F2"
                                PlaceholderColor="#A0A0A0"
                                Text="{Binding Email}"
                                Keyboard="Email"
                                HeightRequest="45" />
                            <Button
                                Text="Send Reset Link"
                                Command="{Binding RequestResetCommand}"
                                CornerRadius="8"
                                HeightRequest="45"
                                WidthRequest="280"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <!-- Section for Resetting Password -->
                        <VerticalStackLayout Spacing="15">
                            <Label Text="Reset Your Password" FontSize="18" />
                            <controls:NoBorderEntry
                                Placeholder="Reset Token"
                                BackgroundColor="#F2F2F2"
                                PlaceholderColor="#A0A0A0"
                                Text="{Binding ResetToken}"
                                HeightRequest="45" />
                            <controls:NoBorderEntry
                                Placeholder="New Password"
                                BackgroundColor="#F2F2F2"
                                PlaceholderColor="#A0A0A0"
                                Text="{Binding NewPassword}"
                                IsPassword="True"
                                HeightRequest="45" />
                            <controls:NoBorderEntry
                                Placeholder="Confirm Password"
                                BackgroundColor="#F2F2F2"
                                PlaceholderColor="#A0A0A0"
                                Text="{Binding ConfirmPassword}"
                                IsPassword="True"
                                HeightRequest="45" />
                            <Button
                                Text="Reset Password"
                                Command="{Binding ResetPasswordCommand}"
                                CornerRadius="8"
                                HeightRequest="45"
                                WidthRequest="280"
                                BackgroundColor="{StaticResource Primary}"
                                TextColor="White"
                                FontAttributes="Bold" />
                        </VerticalStackLayout>

                        <!-- Phân cách và link Back to Login -->
                        <Grid ColumnDefinitions="*, Auto, *" VerticalOptions="Center" Margin="0,10">
                            <BoxView Grid.Column="0" HeightRequest="1" BackgroundColor="#DDDDDD" />
                            <Label
                                Grid.Column="1"
                                Text="Back to Login?"
                                Padding="15,0"
                                TextColor="{StaticResource Primary}"
                                FontAttributes="Bold" />
                            <BoxView Grid.Column="2" HeightRequest="1" BackgroundColor="#DDDDDD" />
                        </Grid>

                        <Button
                            Text="Login"
                            Clicked="btnLogin_Clicked"
                            CornerRadius="8"
                            HeightRequest="45"
                            WidthRequest="280"
                            BackgroundColor="White"
                            TextColor="{StaticResource Primary}"
                            BorderColor="{StaticResource Primary}"
                            BorderWidth="1"
                            FontAttributes="Bold" />

                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <!-- ActivityIndicator overlay khi IsBusy -->
            <ActivityIndicator
                Grid.RowSpan="3"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="White"
                VerticalOptions="Center"
                HorizontalOptions="Center" />
        </Grid>
    </ScrollView>
</ContentPage>