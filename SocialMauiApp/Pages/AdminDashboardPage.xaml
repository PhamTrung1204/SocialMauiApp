<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.AdminDashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:SocialMauiApp.Converters"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    Title="Admin Dashboard"
    BackgroundColor="#F5F7FA">

    <!--  Toolbar for Logout  -->
    <ContentPage.ToolbarItems>
        <ToolbarItem
            Command="{Binding LogoutCommand}"
            Order="Primary"
            Priority="0"
            Text="Logout" />
    </ContentPage.ToolbarItems>

    <Grid Padding="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Summary Section  -->
        <StackLayout
            Grid.Row="0"
            Margin="0,0,0,20"
            x:DataType="vm:AdminViewModel">
            <Label
                FontAttributes="Bold"
                FontFamily="UbuntuBold"
                FontSize="24"
                Text="Overview"
                TextColor="#2D3748" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <!--  Post Count  -->
                <Border
                    Grid.Column="0"
                    Margin="5"
                    Padding="15"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <StackLayout>
                        <Label
                            FontFamily="UbuntuRegular"
                            FontSize="16"
                            Text="Total Posts"
                            TextColor="#4A5568" />
                        <Label
                            FontAttributes="Bold"
                            FontFamily="UbuntuBold"
                            FontSize="22"
                            Text="{Binding PostCount}"
                            TextColor="#2D3748" />
                    </StackLayout>
                </Border>
                <!--  Comment Count  -->
                <Border
                    Grid.Column="1"
                    Margin="5"
                    Padding="15"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <StackLayout>
                        <Label
                            FontFamily="UbuntuRegular"
                            FontSize="16"
                            Text="Total Comments"
                            TextColor="#4A5568" />
                        <Label
                            FontAttributes="Bold"
                            FontFamily="UbuntuBold"
                            FontSize="22"
                            Text="{Binding CommentCount}"
                            TextColor="#2D3748" />
                    </StackLayout>
                </Border>
                <!--  User Count  -->
                <Border
                    Grid.Column="2"
                    Margin="5"
                    Padding="15"
                    BackgroundColor="White"
                    Stroke="#E2E8F0"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <StackLayout>
                        <Label
                            FontFamily="UbuntuRegular"
                            FontSize="16"
                            Text="Total Users"
                            TextColor="#4A5568" />
                        <Label
                            FontAttributes="Bold"
                            FontFamily="UbuntuBold"
                            FontSize="22"
                            Text="{Binding UserCount}"
                            TextColor="#2D3748" />
                    </StackLayout>
                </Border>
            </Grid>
        </StackLayout>

        <!--  Navigation Button  -->
        <StackLayout
            Grid.Row="1"
            Margin="0,0,0,20"
            Orientation="Horizontal"
            Spacing="10">
            <Button
                Padding="10,5"
                BackgroundColor="#3182CE"
                Command="{Binding NavigateToPostManagementCommand}"
                CornerRadius="8"
                FontFamily="UbuntuBold"
                Text="Quản lý bài viết"
                TextColor="White" />
        </StackLayout>

        <!--  User List with RefreshView  -->
        <RefreshView
            Grid.Row="2"
            Command="{Binding LoadDashboardCommand}"
            IsRefreshing="{Binding IsLoading}"
            RefreshColor="#3182CE">
            <CollectionView
                BackgroundColor="Transparent"
                ItemsSource="{Binding Users}"
                SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,5"
                            Padding="10"
                            BackgroundColor="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Grid ColumnDefinitions="Auto,*">
                                <!--  User Avatar  -->
                                <Image
                                    Aspect="AspectFill"
                                    HeightRequest="50"
                                    Source="{Binding PhotoUrl}"
                                    VerticalOptions="Center"
                                    WidthRequest="50">
                                    <Image.Clip>
                                        <RoundRectangleGeometry CornerRadius="25" Rect="0,0,50,50" />
                                    </Image.Clip>
                                </Image>
                                <!--  User Info  -->
                                <StackLayout
                                    Grid.Column="1"
                                    Padding="10,0"
                                    VerticalOptions="Center">
                                    <Label
                                        FontFamily="UbuntuBold"
                                        FontSize="16"
                                        Text="{Binding Name}"
                                        TextColor="#2D3748" />
                                    <Label
                                        FontFamily="UbuntuRegular"
                                        FontSize="14"
                                        Text="{Binding Email}"
                                        TextColor="#4A5568" />
                                    <Label
                                        FontFamily="UbuntuRegular"
                                        FontSize="12"
                                        Text="{Binding Role, StringFormat='Role: {0}'}"
                                        TextColor="#718096" />
                                    <Label
                                        FontFamily="UbuntuRegular"
                                        FontSize="12"
                                        Text="{Binding IsLocked, StringFormat='Status: {0:Locked|Active}'}"
                                        TextColor="{Binding IsLocked, Converter={StaticResource BoolToColorConverter}}" />
                                </StackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!--  Action Buttons  -->
        <StackLayout
            Grid.Row="3"
            Margin="0,10"
            HorizontalOptions="End"
            Orientation="Horizontal"
            Spacing="10">
            <Button
                Padding="10,5"
                BackgroundColor="#DD6B20"
                Command="{Binding ToggleUserLockCommand}"
                CornerRadius="8"
                FontFamily="UbuntuBold"
                IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToBoolConverter}}"
                Text="Lock/Unlock"
                TextColor="White" />
            <Button
                Padding="10,5"
                BackgroundColor="#E53E3E"
                Command="{Binding DeleteUserCommand}"
                CornerRadius="8"
                FontFamily="UbuntuBold"
                IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToBoolConverter}}"
                Text="Delete User"
                TextColor="White" />
        </StackLayout>

        <!--  Loading Indicator  -->
        <ActivityIndicator
            HorizontalOptions="Center"
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            VerticalOptions="Center"
            Color="#3182CE" />
    </Grid>
</ContentPage>