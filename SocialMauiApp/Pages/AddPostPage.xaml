<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.AddPostPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:dto="clr-namespace:SocialMediaMaui.Shared.Dtos;assembly=SocialMediaMaui.Shared"
    xmlns:models="clr-namespace:SocialMauiApp.Models"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    Title="Create Post"
    Padding="15"
    x:DataType="vm:SavePostViewModel"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.TitleColor="White">
    <ScrollView>
        <Grid RowDefinitions="Auto, *,Auto,Auto" RowSpacing="5">
            <!-- Editor for content -->
            <controls:NoBorderEditor
                Grid.Row="1"
                BackgroundColor="LightGoldenrodYellow"
                Placeholder="Start typing..." 
                PlaceholderColor="Black"
                Text="{Binding Content}"
                TextColor="Black"/>
            <!-- Image display area -->
            <Grid Grid.Row="2">
                <Border
                    BackgroundColor="LightSalmon"
                    HeightRequest="250"
                    StrokeThickness="0">
                    <Image HeightRequest="250" Source="{Binding PhotoPath}" Aspect="AspectFill" />
                </Border>
                <!-- Remove photo button -->
                <Border
                    Margin="2"
                    BackgroundColor="{StaticResource Primary}"
                    HeightRequest="40"
                    HorizontalOptions="End"
                    StrokeShape="RoundRectangle 5"
                    StrokeThickness="0"
                    VerticalOptions="Start"
                    WidthRequest="40">
                    <controls:WhiteImage
                        HeightRequest="30"
                        Source="trash.png"
                        WidthRequest="30" />
                    <Border.Shadow>
                        <Shadow />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding RemovePhotoCommand}" />
                    </Border.GestureRecognizers>
                </Border>
                <Grid.Triggers>
                    <DataTrigger
                        Binding="{Binding PhotoPath}"
                        TargetType="Grid"
                        Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Grid.Triggers>
            </Grid>
            <!-- Controls for selecting photo and posting -->
            <FlexLayout
                Grid.Row="3"
                Padding="0,0,2,0"
                JustifyContent="SpaceBetween">
                <Border
                    Padding="15,5"
                    Stroke="{StaticResource Primary}"
                    StrokeShape="RoundRectangle 5">
                    <HorizontalStackLayout Spacing="5">
                        <controls:PrimaryColorImage
                            HeightRequest="25"
                            Source="photo.png"
                            VerticalOptions="Center"
                            WidthRequest="25" />
                        <Label Text="Change Photo" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger
                                    Binding="{Binding PhotoPath}"
                                    TargetType="Label"
                                    Value="">
                                    <Setter Property="Text" Value="Add Photo" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </HorizontalStackLayout>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPhotoCommand}" />
                    </Border.GestureRecognizers>
                </Border>
                <Button
                    Padding="50,0"
                    Command="{Binding SavePostCommand}"
                    Style="{StaticResource rounded}"
                    Text="Post" />
            </FlexLayout>
        </Grid>
    </ScrollView>
</ContentPage>
