<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:ext="clr-namespace:SocialMauiApp.Extensions"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:SocialMauiApp.Controls"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    Title="{ext:Translate Profile_Title}"
    x:DataType="vm:ProfileViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.TitleColor="White">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Command="{Binding LogoutCommand}"
            IconImageSource="power_off.png"
            Order="Primary"
            Text="{ext:Translate Profile_Logout}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Spacing="0">

            <!--  Dải gradient + avatar  -->
            <Grid RowDefinitions="70,Auto">
                <BoxView Grid.Row="0" Background="{StaticResource BrandGradientBrush}" />

                <VerticalStackLayout Grid.Row="0"
                                     Grid.RowSpan="2"
                                     Margin="0,18,0,0"
                                     Spacing="8">

                    <Grid HeightRequest="110" HorizontalOptions="Center" WidthRequest="120">
                        <Border HorizontalOptions="Center" Style="{StaticResource AvatarLargeStyle}">
                            <Image Aspect="AspectFill"
                                   HeightRequest="104"
                                   Source="{Binding User.Photo}"
                                   WidthRequest="104" />
                        </Border>

                        <Border x:Name="ProfileMenuTrigger"
                                Padding="0"
                                BackgroundColor="{StaticResource Primary}"
                                HeightRequest="32"
                                HorizontalOptions="End"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="2"
                                Stroke="White"
                                VerticalOptions="End"
                                WidthRequest="32">
                            <controls:WhiteImage HeightRequest="14"
                                                 HorizontalOptions="Center"
                                                 Source="pencil.png"
                                                 VerticalOptions="Center"
                                                 WidthRequest="14" />
                        </Border>

                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleProfileMenuCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>

                    <VerticalStackLayout Spacing="1">
                        <Label HorizontalTextAlignment="Center"
                               Style="{StaticResource SectionTitleStyle}"
                               Text="{Binding User.Name}" />
                        <Label HorizontalTextAlignment="Center"
                               Style="{StaticResource MutedTextStyle}"
                               Text="{Binding User.Email}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Grid>

            <!--  Menu thiết lập  -->
            <Border x:Name="ProfileMenu"
                    Margin="14,10,14,0"
                    Padding="6"
                    IsVisible="{Binding IsProfileMenuOpen}"
                    Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="2">
                    <Grid Padding="10,12" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="{ext:Translate Profile_ChangeName}" />
                        <Label Grid.Column="1" Style="{StaticResource MutedTextStyle}" Text="›" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowChangeNameCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView Style="{StaticResource SeparatorStyle}" />

                    <Grid Padding="10,12" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="{ext:Translate Profile_ChangePassword}" />
                        <Label Grid.Column="1" Style="{StaticResource MutedTextStyle}" Text="›" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowChangePasswordCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView Style="{StaticResource SeparatorStyle}" />

                    <Grid Padding="10,12" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="{ext:Translate Profile_ChangePhoto}" />
                        <Label Grid.Column="1" Style="{StaticResource MutedTextStyle}" Text="›" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChangePhotoCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView Style="{StaticResource SeparatorStyle}" />

                    <Grid Padding="10,12" ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Style="{StaticResource BodyTextStyle}" Text="{ext:Translate Settings_Title}" />
                        <Label Grid.Column="1" Style="{StaticResource MutedTextStyle}" Text="›" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToSettingsCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                    <BoxView Style="{StaticResource SeparatorStyle}" />

                    <Grid Padding="10,12" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Image Grid.Column="0"
                               HeightRequest="18"
                               Source="fingerprint.png"
                               VerticalOptions="Center"
                               WidthRequest="18" />
                        <Label Grid.Column="1"
                               Style="{StaticResource BodyTextStyle}"
                               Text="{Binding IsFingerprintEnabled, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Bật đăng nhập vân tay|Tắt đăng nhập vân tay'}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="2" Style="{StaticResource MutedTextStyle}" Text="›" />
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowFingerprintSettingsCommand}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!--  Tabs  -->
            <Border Margin="14,12,14,10"
                    Padding="4"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource DarkSurfaceAlt}}"
                    HeightRequest="46"
                    StrokeShape="RoundRectangle 23"
                    StrokeThickness="0">
                <Grid ColumnDefinitions="*,*">
                    <Border Grid.Column="0"
                            Padding="0"
                            BackgroundColor="Transparent"
                            StrokeShape="RoundRectangle 19"
                            StrokeThickness="0">
                        <Label x:Name="myPostsLabel"
                               FontAttributes="Bold"
                               FontSize="14"
                               HorizontalOptions="Center"
                               Text="{ext:Translate Profile_MyPosts}"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               VerticalOptions="Center" />
                        <Border.Triggers>
                            <DataTrigger Binding="{Binding IsMyPostsTabSelected}" TargetType="Border" Value="true">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter TargetName="myPostsLabel" Property="Label.TextColor" Value="White" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectMyPostsTabCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Border Grid.Column="1"
                            Padding="0"
                            BackgroundColor="Transparent"
                            StrokeShape="RoundRectangle 19"
                            StrokeThickness="0">
                        <Label x:Name="bookmarkedLabel"
                               FontAttributes="Bold"
                               FontSize="14"
                               HorizontalOptions="Center"
                               Text="{ext:Translate Profile_Saved}"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               VerticalOptions="Center" />
                        <Border.Triggers>
                            <DataTrigger Binding="{Binding IsBookmarksTabSelected}" TargetType="Border" Value="true">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter TargetName="bookmarkedLabel" Property="Label.TextColor" Value="White" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectBookmarkedPostsTabCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <CollectionView Grid.Row="1"
                        IsVisible="{Binding IsMyPostsTabSelected}"
                        ItemTemplate="{StaticResource postDataTemplateSelector}"
                        ItemsSource="{Binding MyPosts}"
                        RemainingItemsThreshold="2"
                        RemainingItemsThresholdReachedCommand="{Binding FetchMyPostsCommand}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="0" Orientation="Vertical" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Label Style="{StaticResource EmptyStateStyle}" Text="{ext:Translate Profile_EmptyMyPosts}" />
            </CollectionView.EmptyView>
        </CollectionView>

        <CollectionView Grid.Row="1"
                        IsVisible="{Binding IsBookmarksTabSelected}"
                        ItemTemplate="{StaticResource postDataTemplateSelector}"
                        ItemsSource="{Binding BookmarkedPosts}"
                        RemainingItemsThreshold="2"
                        RemainingItemsThresholdReachedCommand="{Binding FetchBookmarkedPostsCommand}">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout ItemSpacing="0" Orientation="Vertical" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <Label Style="{StaticResource EmptyStateStyle}" Text="{ext:Translate Profile_EmptySaved}" />
            </CollectionView.EmptyView>
        </CollectionView>

        <ActivityIndicator Grid.Row="1"
                           HorizontalOptions="Center"
                           IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
