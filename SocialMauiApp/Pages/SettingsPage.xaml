<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="SocialMauiApp.Pages.SettingsPage"
    x:Name="settingsPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ext="clr-namespace:SocialMauiApp.Extensions"
    xmlns:services="clr-namespace:SocialMauiApp.Services"
    xmlns:vm="clr-namespace:SocialMauiApp.ViewModel"
    Title="{ext:Translate Settings_Title}"
    x:DataType="vm:SettingsViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}"
    Shell.BackgroundColor="{StaticResource Primary}"
    Shell.TitleColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="14,16,14,24" Spacing="10">

            <Label Margin="4,0,0,0"
                   Style="{StaticResource SectionTitleStyle}"
                   Text="{ext:Translate Settings_Language}" />

            <Label Margin="4,0,0,6"
                   Style="{StaticResource MutedTextStyle}"
                   Text="{ext:Translate Settings_LanguageDescription}" />

            <Border Padding="6,2" Style="{StaticResource FlatCardStyle}">
                <CollectionView ItemsSource="{Binding Languages}"
                                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                SelectionMode="Single">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout ItemSpacing="2" Orientation="Vertical" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="services:LanguageOption">
                            <Grid Padding="10,14" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Grid.Column="0"
                                       Style="{StaticResource BodyTextStyle}"
                                       Text="{Binding DisplayName}"
                                       VerticalOptions="Center" />
                                <Border Grid.Column="1"
                                        Padding="10,4"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimarySoft}, Dark={StaticResource DarkSurfaceAlt}}"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <Label FontAttributes="Bold"
                                           FontSize="12"
                                           Text="{Binding Code}"
                                           TextColor="{AppThemeBinding Light={StaticResource PrimaryDark}, Dark={StaticResource PrimaryLight}}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
