# Sao chép thành .env.koyeb rồi điền giá trị thật:  cp .env.koyeb.example .env.koyeb
# .env.koyeb đã nằm trong .gitignore - không commit.
# Dùng bởi ./deploy-koyeb.sh
#
# LƯU Ý: bọc giá trị trong dấu nháy đơn nếu có ký tự & ? $ hoặc khoảng trắng
# (chuỗi kết nối Neon luôn có &) - file này được `source`, không phải parse.

# --- Koyeb ---
# Tạo token: https://app.koyeb.com/user/settings/api
KOYEB_TOKEN=''
# Dạng APP/SERVICE, xem bằng: koyeb services list
KOYEB_SERVICE=socialmaui/api
# Cổng app lắng nghe. Phải khớp với port + route đã cấu hình trên Koyeb.
PORT_NUMBER=8000

# --- PostgreSQL ---
# Koyeb không có Postgres quản lý sẵn - dùng Neon / Supabase / Aiven.
# Chấp nhận cả postgres:// URI lẫn dạng Host=...;Port=...;Database=...
DATABASE_URL=''

# --- API ---
# URL công khai Koyeb cấp, KHÔNG có dấu / ở cuối.
PUBLIC_BASE_URL='https://api-<org>.koyeb.app'
# Sinh mới bằng: openssl rand -base64 64
JWT_SECRET_KEY=''
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# --- SMTP (xác thực email / reset mật khẩu) - để trống nếu chưa dùng ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_SENDER_EMAIL=
SMTP_APP_PASSWORD=''
