# Sao chép thành .env rồi điền giá trị thật:  cp .env.example .env
# .env đã nằm trong .gitignore - không commit.

# --- PostgreSQL ---
POSTGRES_DB=socialmaui
POSTGRES_USER=socialmaui
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- API ---
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
# Set false when a proxy/load balancer terminates TLS (Render, Fly, Railway...)
HOSTING_USE_HTTPS_REDIRECTION=true

# URL công khai mà client/MAUI app gọi tới. Dùng cho Jwt:Issuer và cho URL ảnh upload.
PUBLIC_BASE_URL=http://localhost:8080

# Khóa ký JWT. Sinh mới bằng: openssl rand -base64 64
JWT_SECRET_KEY=change-me
JWT_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRY_DAYS=30

# --- SMTP (xác thực email / reset mật khẩu) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_SENDER_EMAIL=
SMTP_APP_PASSWORD=

# --- pgAdmin (chỉ chạy với: docker compose --profile tools up -d) ---
PGADMIN_EMAIL=admin@local.dev
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
